APP_PORT=8080
ASPNETCORE_ENVIRONMENT=Development

POSTGRES_IMAGE=pgvector/pgvector:pg17
POSTGRES_DB=prn222_rag
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
DATABASE_APPLY_MIGRATIONS_ON_STARTUP=true

AUTH_SEED_USERS=false
AUTH_ADMIN_EMAIL=
AUTH_ADMIN_PASSWORD=
AUTH_ADMIN_DISPLAY_NAME=Administrator
AUTH_SUBJECT_LEADER_EMAIL=
AUTH_SUBJECT_LEADER_PASSWORD=
AUTH_SUBJECT_LEADER_DISPLAY_NAME=Subject Leader
AUTH_STUDENT_EMAIL=
AUTH_STUDENT_PASSWORD=
AUTH_STUDENT_DISPLAY_NAME=Student

# AI provider selection: Ollama | OpenAI | Gemini
RAG_PROVIDER=Ollama
# Keep one embedding dimension across a corpus. The default Ollama qwen3-embedding:0.6b model outputs 1024 dimensions.
RAG_EMBEDDING_DIMENSIONS=1024

OLLAMA_IMAGE=ollama/ollama:0.32.5
OLLAMA_PORT=11434
OLLAMA_CHAT_MODEL=qwen3:4b
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b

# Used only when RAG_PROVIDER=OpenAI. Never commit real keys.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1/
OPENAI_CHAT_MODEL=gpt-5.6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Used only when RAG_PROVIDER=Gemini. Never commit real keys.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/
GEMINI_CHAT_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
