# PostgreSQL
POSTGRES_DB=prn222_rag
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
POSTGRES_IMAGE=pgvector/pgvector:pg17

# Application
APP_PORT=8080
ASPNETCORE_ENVIRONMENT=Development
DATABASE_APPLY_MIGRATIONS_ON_STARTUP=true

# Optional development seed users. Keep disabled unless you intentionally need demo accounts.
AUTH_SEED_USERS=false
AUTH_ADMIN_EMAIL=
AUTH_ADMIN_PASSWORD=
AUTH_ADMIN_DISPLAY_NAME=Administrator
AUTH_SUBJECT_LEADER_EMAIL=
AUTH_SUBJECT_LEADER_PASSWORD=
AUTH_SUBJECT_LEADER_DISPLAY_NAME=Subject Leader
AUTH_STUDENT_EMAIL=
AUTH_STUDENT_PASSWORD=
AUTH_STUDENT_DISPLAY_NAME=Student

# AI provider selection: Ollama | Gemini | OpenAI | OpenRouter
# RAG_PROVIDER remains the backward-compatible default for both chat and embeddings.
RAG_PROVIDER=Ollama
# Optional overrides. Leave blank to inherit RAG_PROVIDER independently.
RAG_CHAT_PROVIDER=
RAG_EMBEDDING_PROVIDER=
RAG_EMBEDDING_DIMENSIONS=1024

# LOCAL FREE PROVIDER - Ollama
OLLAMA_IMAGE=ollama/ollama:0.32.5
OLLAMA_PORT=11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3:4b
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b

# RECOMMENDED DIRECT FREE ONLINE PROVIDER - Google Gemini Free Tier
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/
GEMINI_CHAT_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# FREE-FIRST ONLINE ROUTER - OpenRouter
# Render CD uses OpenRouter for BOTH chat and embeddings and only needs OPENROUTER_API_KEY entered manually.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/
# Ordered chat fallback chain. OpenRouter tries models in order and uses openrouter/free as the final free router fallback.
OPENROUTER_CHAT_MODELS=nvidia/nemotron-3.5-lightning:free,nvidia/nemotron-3-ultra-550b-a55b:free,nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-26b-a4b-it:free,openai/gpt-oss-20b:free,openrouter/free
# 1024-dimensional free embedding model used by Render; changing embedding model/dimension requires a complete corpus re-index.
OPENROUTER_EMBEDDING_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=PRN222 RAG Assistant

# OPTIONAL PAID PROVIDER - OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1/
OPENAI_CHAT_MODEL=gpt-5.6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
