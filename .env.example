APP_PORT=8080
ASPNETCORE_ENVIRONMENT=Development

POSTGRES_IMAGE=pgvector/pgvector:pg17
POSTGRES_DB=prn222_rag
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
DATABASE_APPLY_MIGRATIONS_ON_STARTUP=true

AUTH_SEED_USERS=false
AUTH_ADMIN_EMAIL=
AUTH_ADMIN_PASSWORD=
AUTH_ADMIN_DISPLAY_NAME=Administrator
AUTH_SUBJECT_LEADER_EMAIL=
AUTH_SUBJECT_LEADER_PASSWORD=
AUTH_SUBJECT_LEADER_DISPLAY_NAME=Subject Leader
AUTH_STUDENT_EMAIL=
AUTH_STUDENT_PASSWORD=
AUTH_STUDENT_DISPLAY_NAME=Student

# AI provider selection: Ollama | Gemini | OpenAI
# Ollama = local/default, Gemini = recommended online FREE TIER, OpenAI = optional PAID API.
RAG_PROVIDER=Ollama
# Keep one embedding dimension across a corpus. Changing provider/model/dimensions requires a full re-index.
RAG_EMBEDDING_DIMENSIONS=1024

# LOCAL / $0 provider fee (uses your own machine resources)
OLLAMA_IMAGE=ollama/ollama:0.32.5
OLLAMA_PORT=11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3:4b
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b

# ONLINE FREE TIER backup (rate limits apply). Never commit a real key.
# As of 2026-08-15, Gemini 3.6 Flash and Gemini Embedding 2 are listed on Google's Standard Free Tier.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/
GEMINI_CHAT_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# OPTIONAL ONLINE PAID provider. This is NOT the project's free fallback.
# Never commit a real key.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1/
OPENAI_CHAT_MODEL=gpt-5.6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
