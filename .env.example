# PostgreSQL
POSTGRES_DB=prn222_rag
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
POSTGRES_IMAGE=pgvector/pgvector:pg17

# Application
APP_PORT=8080
ASPNETCORE_ENVIRONMENT=Development
DATABASE_APPLY_MIGRATIONS_ON_STARTUP=true

# Optional development seed users. Keep disabled unless you intentionally need demo accounts.
AUTH_SEED_USERS=false
AUTH_ADMIN_EMAIL=
AUTH_ADMIN_PASSWORD=
AUTH_ADMIN_DISPLAY_NAME=Administrator
AUTH_SUBJECT_LEADER_EMAIL=
AUTH_SUBJECT_LEADER_PASSWORD=
AUTH_SUBJECT_LEADER_DISPLAY_NAME=Subject Leader
AUTH_STUDENT_EMAIL=
AUTH_STUDENT_PASSWORD=
AUTH_STUDENT_DISPLAY_NAME=Student

# AI provider selection: Ollama | Gemini | OpenAI | OpenRouter
RAG_PROVIDER=Ollama
RAG_CHAT_PROVIDER=
RAG_EMBEDDING_PROVIDER=
RAG_EMBEDDING_DIMENSIONS=1024

# LOCAL FREE PROVIDER - Ollama
OLLAMA_IMAGE=ollama/ollama:0.32.5
OLLAMA_PORT=11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3:4b
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b

# DIRECT ONLINE PROVIDER - Google Gemini
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/
GEMINI_CHAT_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash,gemini-2.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# ONLINE ROUTER - OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/
OPENROUTER_CHAT_MODELS=nvidia/nemotron-3.5-lightning:free,nvidia/nemotron-3-ultra-550b-a55b:free,nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-26b-a4b-it:free,openai/gpt-oss-20b:free,openrouter/free
OPENROUTER_EMBEDDING_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=PRN222 RAG Assistant

# OPTIONAL PAID PROVIDER - OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1/
OPENAI_CHAT_MODEL=gpt-5.6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# BILLING - VNPay Payment Gateway (disabled by default locally)
BILLING_ENABLED=false
BILLING_BASE_URL=http://localhost:8080
# Configure credentials locally or in your deployment secret store; never commit the hash secret.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_BASE_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_VERSION=2.1.0
VNPAY_COMMAND=pay
VNPAY_LOCALE=vn
VNPAY_ORDER_TYPE=other
