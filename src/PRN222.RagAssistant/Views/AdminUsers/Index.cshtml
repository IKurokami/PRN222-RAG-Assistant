@model PRN222.RagAssistant.Models.Admin.AdminUserListViewModel
@{
    ViewData["Title"] = "Quản Lý Tài Khoản Người Dùng - Admin";
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <div class="academic-breadcrumb mb-3">
        <a asp-page="/Index"><i class="bi bi-house-door"></i> Trang chủ</a>
        <span class="academic-breadcrumb-separator">/</span>
        <span class="fw-semibold">Quản trị người dùng</span>
    </div>

    <!-- Header Section -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4 pb-2 border-bottom">
        <div>
            <h1 class="fw-bold fs-3 text-dark mb-1">
                <i class="bi bi-people-fill text-primary me-2"></i>Quản Lý Người Dùng &amp; Phân Quyền
            </h1>
            <p class="text-muted small mb-0">Tạo tài khoản người dùng và thiết lập vai trò quản trị trong hệ thống.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="AdminSubjects" asp-action="Index" class="btn btn-sm btn-outline-secondary btn-press d-inline-flex align-items-center gap-1" style="border-radius: var(--radius-md); font-size: 0.85rem; font-weight: 600;">
                <i class="bi bi-gear"></i> Quản trị môn học
            </a>
            <a asp-controller="AdminUsers" asp-action="Create" class="btn btn-sm btn-primary btn-press d-inline-flex align-items-center gap-1" style="background-color: var(--color-primary-600); border-color: var(--color-primary-600); border-radius: var(--radius-md); font-size: 0.85rem; font-weight: 600;">
                <i class="bi bi-person-plus-fill"></i> Thêm người dùng mới
            </a>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="alert alert-success d-flex align-items-center gap-2 alert-dismissible fade show shadow-xs mb-4" role="alert" style="border-radius: var(--radius-md);">
            <i class="bi bi-check-circle-fill text-success fs-5"></i>
            <div>@Model.StatusMessage</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="academic-card card-lift p-0 overflow-hidden mb-4 shadow-sm border bg-white rounded-4">
        @if (Model.Users.Count == 0)
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-people fs-2 d-block mb-2 text-secondary"></i>
                Không tìm thấy người dùng nào trong hệ thống.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="bg-light text-muted small text-uppercase" style="letter-spacing: 0.05em; border-bottom: 1px solid var(--color-border-warm);">
                        <tr>
                            <th scope="col" class="ps-4 py-3" style="min-width: 250px;">Họ tên &amp; Email</th>
                            <th scope="col" class="py-3" style="width: 180px;">Vai trò (Role)</th>
                            <th scope="col" class="py-3" style="width: 200px;">Ngày tạo tài khoản</th>
                            <th scope="col" class="text-end pe-4 py-3" style="width: 150px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < Model.Users.Count; i++)
                        {
                            var user = Model.Users[i];
                            <tr class="stagger-row" style="animation-delay: @(i * 40)ms; border-bottom: 1px solid var(--color-border-subtle);">
                                <td class="ps-4 py-3">
                                    <div class="fw-bold text-dark fs-6">@user.DisplayName</div>
                                    <div class="small text-muted font-monospace" style="cursor: pointer;" data-copy="@user.Email" data-copy-label="Đã sao chép email @user.Email" title="Bấm để sao chép email">
                                        @user.Email <i class="bi bi-copy text-muted ms-1" style="font-size: 0.75rem;"></i>
                                    </div>
                                    @if (user.IsCurrentUser)
                                    {
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle mt-1 small rounded-pill">
                                            <i class="bi bi-person-check-fill me-1"></i>Tài khoản hiện tại của bạn
                                        </span>
                                    }
                                </td>
                                <td>
                                    @if (user.Roles.Count == 0)
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary px-2.5 py-1 rounded-pill">Chưa phân vai trò</span>
                                    }
                                    else
                                    {
                                        @foreach (var role in user.Roles)
                                        {
                                            if (role == AppRoles.Admin)
                                            {
                                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2.5 py-1 rounded-pill font-monospace small">Admin</span>
                                            }
                                            else if (role == AppRoles.SubjectLeader)
                                            {
                                                <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2.5 py-1 rounded-pill font-monospace small">Trưởng Môn</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2.5 py-1 rounded-pill font-monospace small">Sinh Viên</span>
                                            }
                                        }
                                    }
                                </td>
                                <td class="small text-muted font-monospace">
                                    @user.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                </td>
                                <td class="text-end pe-4">
                                    <a asp-controller="AdminUsers"
                                       asp-action="Edit"
                                       asp-route-id="@user.Id"
                                       class="btn btn-sm btn-outline-secondary btn-press d-inline-flex align-items-center gap-1"
                                       style="border-radius: var(--radius-sm); font-size: 0.82rem; font-weight: 500;"
                                       title="Điều chỉnh vai trò người dùng">
                                        <i class="bi bi-pencil"></i> Đổi vai trò
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
