@model PRN222.RagAssistant.Models.Admin.AdminUserCreateViewModel
@{
    ViewData["Title"] = "Thêm Người Dùng Mới - Admin";
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <div class="academic-breadcrumb mb-3">
        <a asp-page="/Index"><i class="bi bi-house-door"></i> Trang chủ</a>
        <span class="academic-breadcrumb-separator">/</span>
        <a asp-controller="AdminUsers" asp-action="Index">Quản trị người dùng</a>
        <span class="academic-breadcrumb-separator">/</span>
        <span class="text-slate-800 fw-semibold">Tạo tài khoản mới</span>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-7 col-xl-6">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h1 class="fw-bold fs-3 text-slate-900 mb-1">
                        <i class="bi bi-person-plus-fill text-primary me-2"></i>Thêm Người Dùng Mới
                    </h1>
                    <p class="text-slate-500 mb-0">Khởi tạo tài khoản và gán vai trò tương ứng trong hệ thống.</p>
                </div>
                <a asp-controller="AdminUsers" asp-action="Index" class="btn btn-sm btn-academic-outline">
                    <i class="bi bi-arrow-left"></i> Quay lại
                </a>
            </div>

            <div class="academic-card shadow-sm">
                <form method="post" asp-controller="AdminUsers" asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger d-flex align-items-center gap-2 mb-4" role="alert"></div>

                    <div class="mb-4">
                        <label asp-for="DisplayName" class="form-label fw-bold text-slate-800">
                            Họ và tên hiển thị <span class="text-danger">*</span>
                        </label>
                        <input asp-for="DisplayName" class="form-control" autocomplete="name" placeholder="Ví dụ: Nguyễn Văn A" />
                        <span asp-validation-for="DisplayName" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Email" class="form-label fw-bold text-slate-800">
                            Địa chỉ Email <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Email" class="form-control" autocomplete="email" placeholder="Ví dụ: user@fpt.edu.vn" />
                        <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Role" class="form-label fw-bold text-slate-800">
                            Vai trò hệ thống (Role) <span class="text-danger">*</span>
                        </label>
                        <select asp-for="Role" class="form-select">
                            <option value="@AppRoles.Student">Sinh viên (Student) — Tra cứu &amp; Hỏi đáp RAG</option>
                            <option value="@AppRoles.SubjectLeader">Trưởng môn (SubjectLeader) — Quản lý môn học được giao</option>
                            <option value="@AppRoles.Admin">Quản trị viên (Admin) — Toàn quyền hệ thống</option>
                        </select>
                        <span asp-validation-for="Role" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="Password" class="form-label fw-bold text-slate-800">
                                Mật khẩu <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Password" class="form-control" type="password" autocomplete="new-password" placeholder="••••••••" />
                            <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ConfirmPassword" class="form-label fw-bold text-slate-800">
                                Xác nhận mật khẩu <span class="text-danger">*</span>
                            </label>
                            <input asp-for="ConfirmPassword" class="form-control" type="password" autocomplete="new-password" placeholder="••••••••" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small mt-1 d-block"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a asp-controller="AdminUsers" asp-action="Index" class="btn btn-academic-outline">Hủy bỏ</a>
                        <button type="submit" class="btn-academic-primary px-4">
                            <i class="bi bi-check2-circle"></i> Khởi tạo tài khoản
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
