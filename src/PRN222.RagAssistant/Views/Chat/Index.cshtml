@model PRN222.RagAssistant.Controllers.ChatViewModel
@{
    ViewData["Title"] = "Trò chuyện RAG";
}

@Html.AntiForgeryToken()

<div class="modern-chat-layout">
    <!-- Sidebar: Minimalist Borderless Sessions & Subject Switcher -->
    <aside id="chatSidebar" class="modern-sidebar">
        <!-- Top Action & Subject Selector -->
        <div class="p-3 bg-transparent">
            <form asp-action="NewSession" method="post" class="mb-3">
                @Html.AntiForgeryToken()
                <input type="hidden" name="subjectId" value="@Model.SelectedSubjectId" />
                <button type="submit" class="sidebar-btn-newchat">
                    <span class="d-flex align-items-center gap-2">
                        <i class="bi bi-plus-lg text-primary"></i>
                        <span>Đoạn chat mới</span>
                    </span>
                    <i class="bi bi-pencil-square text-muted small"></i>
                </button>
            </form>

            <div>
                <label for="subjectSelect" class="form-label text-muted" style="font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.35rem;">
                    Môn học
                </label>
                <select id="subjectSelect" class="form-select form-select-sm bg-white fw-semibold rounded-3 shadow-none" style="border: none;" onchange="switchSubject(this.value)">
                    @foreach (var s in Model.Subjects)
                    {
                        if (s.Id == Model.SelectedSubjectId)
                        {
                            <option value="@s.Id" selected="selected">[@s.Code] @s.Name</option>
                        }
                        else
                        {
                            <option value="@s.Id">[@s.Code] @s.Name</option>
                        }
                    }
                </select>
            </div>
        </div>

        <!-- Chat History List -->
        <div class="sidebar-session-list">
            <div class="px-2 py-1 text-muted" style="font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em;">
                Gần đây
            </div>

            @if (Model.Sessions.Count == 0)
            {
                <div class="text-center text-muted py-5 px-3 small">
                    <i class="bi bi-chat-text fs-4 d-block mb-2 opacity-40"></i>
                    Chưa có cuộc trò chuyện nào.
                </div>
            }
            else
            {
                @foreach (var session in Model.Sessions)
                {
                    var isActive = Model.ActiveSession != null && Model.ActiveSession.Id == session.Id;
                    <div class="sidebar-session-item @(isActive ? "active" : "")">
                        <a href="@Url.Action("Index", "Chat", new { subjectId = Model.SelectedSubjectId, sessionId = session.Id })" 
                           class="text-truncate flex-grow-1 me-2 text-decoration-none text-reset" 
                           title="@session.Title">
                            <i class="bi bi-chat-left-text me-2 text-muted" style="font-size: 0.8rem;"></i>
                            <span>@(string.IsNullOrWhiteSpace(session.Title) ? "Hội thoại " + session.CreatedAtUtc.ToLocalTime().ToString("dd/MM HH:mm") : session.Title)</span>
                        </a>
                        <form asp-action="DeleteSession" method="post" class="d-inline m-0" onsubmit="return confirm('Xóa cuộc trò chuyện này?');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="sessionId" value="@session.Id" />
                            <input type="hidden" name="subjectId" value="@Model.SelectedSubjectId" />
                            <button type="submit" class="sidebar-delete-btn" title="Xóa">
                                <i class="bi bi-trash3"></i>
                            </button>
                        </form>
                    </div>
                }
            }
        </div>
    </aside>

    <!-- Main Chat Workspace -->
    <main class="modern-chat-main">
        <!-- Topbar (Borderless) -->
        <header class="chat-topbar">
            <div class="d-flex align-items-center gap-2">
                <button type="button" class="btn btn-sm btn-light border-0 text-muted p-1 px-2 rounded-2" onclick="toggleSidebar()" title="Đóng/mở danh sách">
                    <i class="bi bi-layout-sidebar fs-6"></i>
                </button>
                <div class="d-flex align-items-center gap-2">
                    <span class="fw-bold text-dark" style="font-size: 0.95rem;">[@Model.SelectedSubjectCode] @Model.SelectedSubjectName</span>
                </div>
            </div>

            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-light text-muted px-2 py-1 rounded-pill" style="font-size: 0.75rem; font-weight: 500;">
                    <i class="bi bi-shield-check text-success me-1"></i>RAG Grounded
                </span>
            </div>
        </header>

        <!-- Messages Stream -->
        <div id="chatStream" class="modern-messages-scroll">
            <div class="modern-chat-container">
                @if (Model.Messages.Count == 0)
                {
                    <div id="emptyState" class="empty-state-greeting">
                        <div class="d-inline-flex p-3 rounded-circle bg-light mb-3 text-dark">
                            <i class="bi bi-stars fs-2"></i>
                        </div>
                        <h3>Tôi có thể giúp gì cho việc học của bạn?</h3>
                        <p>Hỏi đáp thông minh và giải thích chi tiết dựa trên tài liệu giáo trình môn <strong>@Model.SelectedSubjectCode</strong>.</p>

                        <!-- Prompt Suggestions Grid -->
                        <div class="prompt-suggestions-grid">
                            <div class="prompt-card" onclick="usePrompt('Pattern Matching trong C# là gì và có các dạng pattern nào?')">
                                <div class="prompt-card-title">
                                    <i class="bi bi-code-square text-primary"></i> Pattern Matching
                                </div>
                                <div class="prompt-card-desc">Cú pháp và các dạng pattern matching phổ biến trong C#</div>
                            </div>
                            <div class="prompt-card" onclick="usePrompt('Phân biệt Task và ValueTask trong lập trình bất đồng bộ .NET?')">
                                <div class="prompt-card-title">
                                    <i class="bi bi-lightning-charge text-warning"></i> Task vs ValueTask
                                </div>
                                <div class="prompt-card-desc">Sự khác biệt và khi nào nên dùng ValueTask trong tối ưu bộ nhớ</div>
                            </div>
                            <div class="prompt-card" onclick="usePrompt('Cơ chế Middleware Pipeline trong ASP.NET Core hoạt động thế nào?')">
                                <div class="prompt-card-title">
                                    <i class="bi bi-diagram-3 text-info"></i> Middleware Pipeline
                                </div>
                                <div class="prompt-card-desc">Cách thức hoạt động của chuỗi Middleware trong xử lý HTTP Request</div>
                            </div>
                            <div class="prompt-card" onclick="usePrompt('Tại sao nên sử dụng AsNoTracking() trong Entity Framework Core?')">
                                <div class="prompt-card-title">
                                    <i class="bi bi-database-check text-success"></i> EF Core AsNoTracking
                                </div>
                                <div class="prompt-card-desc">Lợi ích về hiệu năng khi truy vấn dữ liệu chỉ đọc (read-only)</div>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    @for (int i = 0; i < Model.Messages.Count; i++)
                    {
                        var msg = Model.Messages[i];
                        if (msg.Role == PRN222.RagAssistant.Domain.Enums.ChatMessageRole.User)
                        {
                            <div class="msg-row-user">
                                <div class="msg-bubble-user">
                                    <div style="white-space: pre-wrap;">@msg.Content</div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="msg-row-assistant">
                                <div class="msg-avatar-assistant">
                                    <i class="bi bi-stars"></i>
                                </div>
                                <div class="msg-content-assistant">
                                    @if (msg.Citations.Count > 0)
                                    {
                                        <!-- Historical Tool Call Accordion -->
                                        <div class="tool-call-box">
                                            <div class="tool-call-summary" onclick="toggleHistoricalToolCall(this)">
                                                <i class="bi bi-check-circle-fill text-success"></i>
                                                <span>Đã tra cứu pgvector (@msg.Citations.Count nguồn tài liệu)</span>
                                                <i class="bi bi-chevron-down ms-1 chevron-icon"></i>
                                            </div>
                                            <div class="tool-call-timeline d-none">
                                                <div class="tool-step-item">
                                                    <div class="tool-step-icon success"><i class="bi bi-check2"></i></div>
                                                    <div class="tool-step-content">
                                                        <div class="tool-step-title">Mã hóa câu hỏi ngữ nghĩa</div>
                                                        <div class="tool-step-detail">Vector embedding 1024 chiều</div>
                                                    </div>
                                                </div>
                                                <div class="tool-step-item">
                                                    <div class="tool-step-icon success"><i class="bi bi-check2"></i></div>
                                                    <div class="tool-step-content">
                                                        <div class="tool-step-title">Tìm kiếm pgvector trong môn @Model.SelectedSubjectCode</div>
                                                        <div class="tool-step-detail">Đã tìm thấy @msg.Citations.Count đoạn trích phù hợp nhất có độ tương đồng &ge; 0.3</div>
                                                    </div>
                                                </div>
                                                <div class="tool-step-item">
                                                    <div class="tool-step-icon success"><i class="bi bi-check2"></i></div>
                                                    <div class="tool-step-content">
                                                        <div class="tool-step-title">Tổng hợp câu trả lời với AI</div>
                                                        <div class="tool-step-detail">Sinh phản hồi có căn cứ (Grounded Context)</div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }

                                    <div class="chat-markdown message-body-markdown" data-raw="@msg.Content">
                                        @msg.Content
                                    </div>

                                    @if (msg.Citations.Count > 0)
                                    {
                                        <div class="sources-carousel">
                                            @foreach (var cit in msg.Citations)
                                            {
                                                <button type="button" 
                                                        class="source-pill"
                                                        data-doc-title="@cit.DocumentTitle"
                                                        data-page-number="@cit.PageNumber"
                                                        data-rank="@cit.Rank"
                                                        data-excerpt="@cit.ChunkContent"
                                                        onclick="openCitationModalFromElement(this)">
                                                    <span class="source-rank">@cit.Rank</span>
                                                    <i class="bi bi-file-earmark-text text-danger"></i>
                                                    <span class="text-truncate" style="max-width: 220px;">@cit.DocumentTitle</span>
                                                    <span class="text-muted">(Trang @cit.PageNumber)</span>
                                                </button>
                                            }
                                        </div>
                                    }

                                    <div class="msg-actions-bar">
                                        <button type="button" class="btn-msg-action" onclick="copyMessageText(this)">
                                            <i class="bi bi-copy"></i> Sao chép
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                }
            </div>
        </div>

        <!-- Floating Input Island (ChatGPT Style - Borderless) -->
        <div class="floating-input-wrapper">
            <div class="floating-input-box">
                <textarea id="questionInput" 
                          rows="1" 
                          placeholder="Hỏi bất cứ điều gì về tài liệu môn học..." 
                          oninput="autoResizeTextarea(this)" 
                          onkeydown="handleTextareaKeydown(event)"></textarea>
                <button type="button" id="sendBtn" class="btn-send-round" onclick="submitQuestion()" disabled title="Gửi câu hỏi">
                    <i class="bi bi-arrow-up" id="sendIcon"></i>
                    <span id="sendSpinner" class="spinner-border spinner-border-sm d-none" role="status"></span>
                </button>
            </div>
            <div class="input-disclaimer">
                Trợ lý AI có thể mắc lỗi. Hãy kiểm tra các thông tin quan trọng từ tài liệu giáo trình.
            </div>
        </div>
    </main>
</div>

<!-- Interactive Document Citation Modal (Borderless & Clean Reader) -->
<div class="modal fade" id="citationDetailModal" tabindex="-1" aria-labelledby="citationDetailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 1.25rem; overflow: hidden; background: #ffffff;">
            <div class="modal-header border-0 py-3 px-4 bg-light d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center gap-3">
                    <div class="p-2 bg-white rounded-3 text-danger d-flex align-items-center justify-content-center shadow-sm" style="width: 40px; height: 40px;">
                        <i class="bi bi-file-earmark-pdf-fill fs-5"></i>
                    </div>
                    <div>
                        <h6 class="modal-title fw-bold text-dark mb-1" id="citationModalDocTitle" style="font-size: 1.05rem;">Tên tài liệu</h6>
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-primary text-white rounded-pill px-2.5 py-1" id="citationModalRankBadge" style="font-size: 0.75rem; font-weight: 600;">Nguồn #1</span>
                            <span class="badge bg-white text-secondary shadow-sm rounded-pill px-2.5 py-1" id="citationModalPageBadge" style="font-size: 0.75rem;"><i class="bi bi-file-earmark-text me-1"></i>Trang 1</span>
                        </div>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4 bg-white">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <span class="small fw-semibold text-secondary d-flex align-items-center gap-1.5" style="font-size: 0.82rem; letter-spacing: 0.02em;">
                        <i class="bi bi-quote text-primary fs-6"></i> Nguyên văn đoạn trích tài liệu gốc (Document Chunk)
                    </span>
                    <button type="button" class="btn btn-light btn-sm border-0 rounded-pill px-3 py-1 text-secondary d-flex align-items-center gap-1 shadow-sm" onclick="copyCitationSnippet(this)">
                        <i class="bi bi-clipboard"></i> <span>Sao chép</span>
                    </button>
                </div>
                <div class="p-3.5 bg-light rounded-4 text-dark" style="max-height: 480px; overflow-y: auto; line-height: 1.85; font-size: 0.98rem; background-color: #f8f9fa;">
                    <div id="citationModalContent" class="citation-reader-body" style="white-space: pre-wrap; font-family: inherit; color: #1e293b;"></div>
                </div>
            </div>
            <div class="modal-footer border-0 py-2.5 px-4 bg-light">
                <button type="button" class="btn btn-secondary btn-sm px-4 rounded-pill border-0" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Marked.js for markdown rendering -->
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>

    <script>
        const activeSubjectId = '@Model.SelectedSubjectId';
        const activeSessionId = '@(Model.ActiveSession?.Id)';
        let citationModalInstance = null;

        if (typeof marked !== 'undefined') {
            marked.setOptions({
                gfm: true,
                breaks: true
            });
        }

        document.addEventListener('DOMContentLoaded', () => {
            const modalEl = document.getElementById('citationDetailModal');
            if (modalEl && typeof bootstrap !== 'undefined') {
                citationModalInstance = new bootstrap.Modal(modalEl);
            }

            renderAllHistoricalMarkdown();
            scrollToBottom();

            // Enable send button on text input
            const input = document.getElementById('questionInput');
            if (input) {
                input.addEventListener('input', () => {
                    const sendBtn = document.getElementById('sendBtn');
                    sendBtn.disabled = !input.value.trim();
                });
            }
        });

        function toggleSidebar() {
            const sidebar = document.getElementById('chatSidebar');
            if (window.innerWidth < 992) {
                sidebar.classList.toggle('is-mobile-open');
            } else {
                sidebar.classList.toggle('is-collapsed');
            }
        }

        function switchSubject(subjectId) {
            window.location.href = '@Url.Action("Index", "Chat")?subjectId=' + subjectId;
        }

        function autoResizeTextarea(textarea) {
            textarea.style.height = 'auto';
            textarea.style.height = Math.min(textarea.scrollHeight, 160) + 'px';
        }

        function usePrompt(text) {
            const input = document.getElementById('questionInput');
            input.value = text;
            autoResizeTextarea(input);
            document.getElementById('sendBtn').disabled = false;
            input.focus();
        }

        function handleTextareaKeydown(event) {
            if (event.key === 'Enter' && !event.shiftKey) {
                event.preventDefault();
                submitQuestion();
            }
        }

        function scrollToBottom() {
            const stream = document.getElementById('chatStream');
            if (stream) {
                stream.scrollTop = stream.scrollHeight;
            }
        }

        function toggleHistoricalToolCall(summaryEl) {
            const timeline = summaryEl.nextElementSibling;
            if (timeline) {
                timeline.classList.toggle('d-none');
                summaryEl.classList.toggle('expanded');
            }
        }

        function toggleToolCallAccordion(msgId) {
            const timeline = document.getElementById(`${msgId}-tool-timeline`);
            const summary = document.querySelector(`#${msgId}-tool-box .tool-call-summary`);
            if (timeline) {
                timeline.classList.toggle('d-none');
                summary?.classList.toggle('expanded');
            }
        }

        function renderAllHistoricalMarkdown() {
            document.querySelectorAll('.message-body-markdown').forEach(el => {
                const raw = el.getAttribute('data-raw') || el.textContent;
                el.innerHTML = formatMarkdownWithCitations(raw);
                attachCodeCopyButtons(el);
            });
        }

        function formatMarkdownWithCitations(rawText) {
            if (!rawText) return '';
            if (typeof marked === 'undefined') {
                return escapeHtml(rawText);
            }

            let parsedHtml = marked.parse(rawText);

            // Replace citation markers [1], [2] with sleek interactive links
            parsedHtml = parsedHtml.replace(/\[(\d+)\]/g, (match, num) => {
                return `<a href="javascript:void(0)" class="citation-marker-link" onclick="triggerCitationClick(this, ${num})" title="Xem trích dẫn #${num}">${num}</a>`;
            });

            return parsedHtml;
        }

        function attachCodeCopyButtons(container) {
            container.querySelectorAll('pre').forEach(pre => {
                if (pre.querySelector('.code-copy-btn')) return;
                const copyBtn = document.createElement('button');
                copyBtn.className = 'code-copy-btn';
                copyBtn.type = 'button';
                copyBtn.innerHTML = '<i class="bi bi-clipboard me-1"></i>Copy';
                copyBtn.onclick = () => {
                    const code = pre.querySelector('code')?.innerText || pre.innerText;
                    navigator.clipboard.writeText(code).then(() => {
                        copyBtn.innerHTML = '<i class="bi bi-check2 text-success me-1"></i>Copied!';
                        setTimeout(() => {
                            copyBtn.innerHTML = '<i class="bi bi-clipboard me-1"></i>Copy';
                        }, 2000);
                    });
                };
                pre.appendChild(copyBtn);
            });
        }

        function triggerCitationClick(el, rank) {
            const container = el.closest('.msg-content-assistant');
            if (container) {
                const pill = container.querySelector(`.source-pill[data-rank="${rank}"]`);
                if (pill) {
                    pill.click();
                    return;
                }
            }
            const globalPill = document.querySelector(`.source-pill[data-rank="${rank}"]`);
            if (globalPill) {
                globalPill.click();
            }
        }

        function openCitationModalFromElement(el) {
            const docTitle = el.getAttribute('data-doc-title') || 'Tài liệu giáo trình';
            const pageNumber = el.getAttribute('data-page-number') || '1';
            const rank = el.getAttribute('data-rank') || '1';
            let excerpt = el.getAttribute('data-excerpt') || 'Không có bản xem trước cho đoạn trích này.';

            // Trim leading/trailing whitespace
            excerpt = excerpt.trim();

            document.getElementById('citationModalDocTitle').innerText = docTitle;
            const rankBadge = document.getElementById('citationModalRankBadge');
            if (rankBadge) rankBadge.innerText = `Nguồn #${rank}`;
            const pageBadge = document.getElementById('citationModalPageBadge');
            if (pageBadge) pageBadge.innerHTML = `<i class="bi bi-file-earmark-text me-1"></i>Trang ${pageNumber}`;

            const contentEl = document.getElementById('citationModalContent');
            if (contentEl) {
                if (typeof marked !== 'undefined') {
                    contentEl.innerHTML = marked.parse(excerpt);
                } else {
                    contentEl.innerText = excerpt;
                }
            }

            const modalEl = document.getElementById('citationDetailModal');
            if (typeof bootstrap !== 'undefined') {
                const modal = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
                modal.show();
            }
        }

        function copyCitationSnippet(btn) {
            const contentEl = document.getElementById('citationModalContent');
            const text = contentEl ? contentEl.innerText : '';
            if (text) {
                navigator.clipboard.writeText(text).then(() => {
                    if (btn) {
                        const originalHtml = btn.innerHTML;
                        btn.innerHTML = '<i class="bi bi-check2 text-success me-1"></i> <span class="text-success fw-medium">Đã sao chép</span>';
                        setTimeout(() => {
                            btn.innerHTML = originalHtml;
                        }, 2000);
                    }
                });
            }
        }

        function copyMessageText(btn) {
            const container = btn.closest('.msg-content-assistant');
            const markdownEl = container?.querySelector('.chat-markdown');
            if (markdownEl) {
                const text = markdownEl.innerText;
                navigator.clipboard.writeText(text).then(() => {
                    btn.innerHTML = '<i class="bi bi-check2 text-success"></i> Đã sao chép';
                    setTimeout(() => {
                        btn.innerHTML = '<i class="bi bi-copy"></i> Sao chép';
                    }, 2000);
                });
            }
        }

        // Main Submit with SSE Streaming & Tool Calls
        async function submitQuestion() {
            const input = document.getElementById('questionInput');
            const questionText = input.value.trim();
            if (!questionText || !activeSessionId) return;

            const sendBtn = document.getElementById('sendBtn');
            const sendIcon = document.getElementById('sendIcon');
            const sendSpinner = document.getElementById('sendSpinner');
            const chatStream = document.getElementById('chatStream');
            const chatContainer = chatStream.querySelector('.modern-chat-container');

            // Hide empty state if present
            const emptyState = document.getElementById('emptyState');
            if (emptyState) emptyState.remove();

            // Render User message bubble
            const userMsgHtml = `
                <div class="msg-row-user">
                    <div class="msg-bubble-user">
                        <div style="white-space: pre-wrap;">${escapeHtml(questionText)}</div>
                    </div>
                </div>`;
            chatContainer.insertAdjacentHTML('beforeend', userMsgHtml);
            input.value = '';
            input.style.height = 'auto';
            scrollToBottom();

            // Lock send button
            sendBtn.disabled = true;
            sendIcon.classList.add('d-none');
            sendSpinner.classList.remove('d-none');

            // Create Assistant Streaming Message Row with Live Thinking Radar & Steps
            const assistantMsgId = 'assistant-msg-' + Date.now();
            const assistantHtml = `
                <div id="${assistantMsgId}" class="msg-row-assistant">
                    <div class="msg-avatar-assistant">
                        <i class="bi bi-stars"></i>
                    </div>
                    <div class="msg-content-assistant">
                        <!-- Live Tool Call / Thinking Radar Box -->
                        <div id="${assistantMsgId}-tool-box" class="tool-call-box">
                            <div class="tool-call-summary thinking-active expanded" onclick="toggleToolCallAccordion('${assistantMsgId}')">
                                <span class="thinking-radar-dot"></span>
                                <span id="${assistantMsgId}-tool-summary-text">Đang phân tích câu hỏi & tìm kiếm tài liệu...</span>
                                <i class="bi bi-chevron-down ms-1 chevron-icon"></i>
                            </div>
                            <div id="${assistantMsgId}-tool-timeline" class="tool-call-timeline">
                                <div id="${assistantMsgId}-steps-list">
                                    <div id="${assistantMsgId}-step-call_vectorize" class="tool-step-item">
                                        <div class="tool-step-icon running">
                                            <i class="bi bi-cpu"></i>
                                        </div>
                                        <div class="tool-step-content">
                                            <div class="tool-step-title">Mã hóa ngữ nghĩa câu hỏi</div>
                                            <div class="tool-step-detail">Chuyển đổi câu hỏi thành vector embedding 1024 chiều</div>
                                        </div>
                                    </div>
                                    <div id="${assistantMsgId}-step-call_search" class="tool-step-item">
                                        <div class="tool-step-icon running">
                                            <i class="bi bi-search"></i>
                                        </div>
                                        <div class="tool-step-content">
                                            <div class="tool-step-title">Tìm kiếm tài liệu pgvector</div>
                                            <div class="tool-step-detail">So khớp Cosine Distance trên các đoạn trích giáo trình</div>
                                        </div>
                                    </div>
                                    <div id="${assistantMsgId}-step-call_synthesize" class="tool-step-item">
                                        <div class="tool-step-icon">
                                            <i class="bi bi-chat-left-text"></i>
                                        </div>
                                        <div class="tool-step-content">
                                            <div class="tool-step-title">Tổng hợp câu trả lời</div>
                                            <div class="tool-step-detail">Đang đợi kết quả truy xuất tài liệu...</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Streaming Markdown Body -->
                        <div id="${assistantMsgId}-body" class="chat-markdown d-none"></div>

                        <!-- Source Pills Carousel -->
                        <div id="${assistantMsgId}-citations" class="sources-carousel d-none"></div>

                        <!-- Actions Bar -->
                        <div id="${assistantMsgId}-actions" class="msg-actions-bar d-none">
                            <button type="button" class="btn-msg-action" onclick="copyMessageText(this)">
                                <i class="bi bi-copy"></i> Sao chép
                            </button>
                        </div>
                    </div>
                </div>`;
            chatContainer.insertAdjacentHTML('beforeend', assistantHtml);
            scrollToBottom();

            const summaryTextEl = document.getElementById(`${assistantMsgId}-tool-summary-text`);
            const summaryBoxEl = document.querySelector(`#${assistantMsgId}-tool-box .tool-call-summary`);
            const timelineBoxEl = document.getElementById(`${assistantMsgId}-tool-timeline`);
            const stepsListEl = document.getElementById(`${assistantMsgId}-steps-list`);
            const bodyEl = document.getElementById(`${assistantMsgId}-body`);
            const citationsContainer = document.getElementById(`${assistantMsgId}-citations`);
            const actionsBar = document.getElementById(`${assistantMsgId}-actions`);

            let accumulatedText = '';
            let receivedCitations = [];
            let isFirstDelta = true;
            const startTime = Date.now();

            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

                const response = await fetch('@Url.Action("AskStream", "Chat")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify({
                        sessionId: activeSessionId,
                        subjectId: activeSubjectId,
                        question: questionText
                    })
                });

                if (!response.ok) {
                    throw new Error(`Máy chủ phản hồi mã lỗi: ${response.status}`);
                }

                const reader = response.body.getReader();
                const decoder = new TextDecoder('utf-8');
                let buffer = '';

                while (true) {
                    const { done, value } = await reader.read();
                    if (done) break;

                    buffer += decoder.decode(value, { stream: true });
                    const lines = buffer.split('\n');
                    buffer = lines.pop();

                    let currentEvent = '';
                    for (const line of lines) {
                        const trimmed = line.trim();
                        if (trimmed.startsWith('event:')) {
                            currentEvent = trimmed.substring(6).trim();
                        } else if (trimmed.startsWith('data:')) {
                            const dataStr = trimmed.substring(5).trim();
                            if (!dataStr) continue;

                            try {
                                const data = JSON.parse(dataStr);

                                if (currentEvent === 'tool_call') {
                                    const stepId = `${assistantMsgId}-step-${data.id}`;
                                    let stepEl = document.getElementById(stepId);
                                    const isRunning = data.status === 'running';

                                    if (!stepEl) {
                                        const stepHtml = `
                                            <div id="${stepId}" class="tool-step-item">
                                                <div class="tool-step-icon ${isRunning ? 'running' : 'success'}">
                                                    <i class="bi ${isRunning ? 'bi-search' : 'bi-check2'}"></i>
                                                </div>
                                                <div class="tool-step-content">
                                                    <div class="tool-step-title">${escapeHtml(data.title || '')}</div>
                                                    <div class="tool-step-detail">${escapeHtml(data.detail || '')}</div>
                                                </div>
                                            </div>`;
                                        stepsListEl.insertAdjacentHTML('beforeend', stepHtml);
                                    } else {
                                        const iconEl = stepEl.querySelector('.tool-step-icon');
                                        if (iconEl) {
                                            iconEl.className = `tool-step-icon ${isRunning ? 'running' : 'success'}`;
                                            iconEl.innerHTML = `<i class="bi ${isRunning ? 'bi-arrow-repeat' : 'bi-check2'}"></i>`;
                                        }
                                        const titleEl = stepEl.querySelector('.tool-step-title');
                                        if (titleEl) titleEl.innerText = data.title || '';
                                        const detailEl = stepEl.querySelector('.tool-step-detail');
                                        if (detailEl) detailEl.innerText = data.detail || '';
                                    }

                                    // Mark previous steps as completed when synthesis starts
                                    if (data.id === 'call_synthesize' || data.id === 'call_retrieval_done') {
                                        const vecIcon = document.querySelector(`#${assistantMsgId}-step-call_vectorize .tool-step-icon`);
                                        if (vecIcon) {
                                            vecIcon.className = 'tool-step-icon success';
                                            vecIcon.innerHTML = '<i class="bi bi-check2"></i>';
                                        }
                                        const searchIcon = document.querySelector(`#${assistantMsgId}-step-call_search .tool-step-icon`);
                                        if (searchIcon) {
                                            searchIcon.className = 'tool-step-icon success';
                                            searchIcon.innerHTML = '<i class="bi bi-check2"></i>';
                                        }
                                    }

                                    summaryTextEl.innerText = data.title || 'Đang xử lý...';
                                } else if (currentEvent === 'citations') {
                                    receivedCitations = data.citations || [];
                                } else if (currentEvent === 'delta') {
                                    if (isFirstDelta) {
                                        isFirstDelta = false;
                                        // Auto-collapse timeline on first incoming words so focus shifts to reading
                                        if (timelineBoxEl) timelineBoxEl.classList.add('d-none');
                                        if (summaryBoxEl) {
                                            summaryBoxEl.classList.remove('expanded');
                                            summaryBoxEl.classList.remove('thinking-active');
                                        }
                                    }

                                    if (bodyEl.classList.contains('d-none')) {
                                        bodyEl.classList.remove('d-none');
                                    }

                                    accumulatedText += (data.content || '');
                                    bodyEl.innerHTML = formatMarkdownWithCitations(accumulatedText) + '<span class="typing-cursor"></span>';
                                    scrollToBottom();
                                } else if (currentEvent === 'done') {
                                    accumulatedText = data.answer || accumulatedText;
                                    receivedCitations = data.citations || receivedCitations;
                                } else if (currentEvent === 'error') {
                                    throw new Error(data.message || 'Lỗi xử lý câu hỏi');
                                }
                            } catch (parseErr) {
                                console.error('Error parsing SSE payload:', parseErr, dataStr);
                            }
                        }
                    }
                }

                // Finalize Tool Call Widget Summary
                const elapsedSec = ((Date.now() - startTime) / 1000).toFixed(1);
                if (receivedCitations.length > 0) {
                    summaryBoxEl.innerHTML = `
                        <i class="bi bi-check-circle-fill text-success"></i>
                        <span>Đã tìm kiếm ${receivedCitations.length} nguồn tài liệu (${elapsedSec}s)</span>
                        <i class="bi bi-chevron-down ms-1 chevron-icon"></i>
                    `;
                } else {
                    summaryBoxEl.innerHTML = `
                        <i class="bi bi-info-circle-fill text-muted"></i>
                        <span>Không tìm thấy tài liệu phù hợp (${elapsedSec}s)</span>
                        <i class="bi bi-chevron-down ms-1 chevron-icon"></i>
                    `;
                }

                // Finalize rendering
                bodyEl.classList.remove('d-none');
                bodyEl.innerHTML = formatMarkdownWithCitations(accumulatedText);
                attachCodeCopyButtons(bodyEl);
                actionsBar.classList.remove('d-none');

                // Render Borderless Source Pills
                if (receivedCitations && receivedCitations.length > 0) {
                    citationsContainer.innerHTML = receivedCitations.map(cit => `
                        <button type="button" 
                                class="source-pill" 
                                data-doc-title="${escapeHtml(cit.documentTitle || '')}"
                                data-page-number="${escapeHtml(cit.pageNumber || '1')}"
                                data-rank="${escapeHtml(cit.rank || '1')}"
                                data-excerpt="${escapeHtml(cit.excerpt || '')}"
                                onclick="openCitationModalFromElement(this)">
                            <span class="source-rank">${escapeHtml(cit.rank || '1')}</span>
                            <i class="bi bi-file-earmark-text text-danger"></i>
                            <span class="text-truncate" style="max-width: 220px;">${escapeHtml(cit.documentTitle || '')}</span>
                            <span class="text-muted">(Trang ${escapeHtml(cit.pageNumber || '1')})</span>
                        </button>
                    `).join('');
                    citationsContainer.classList.remove('d-none');
                }

            } catch (err) {
                console.error('Streaming request error:', err);
                summaryBoxEl.innerHTML = `
                    <i class="bi bi-exclamation-triangle-fill text-danger"></i>
                    <span>Lỗi xử lý yêu cầu</span>
                `;
                bodyEl.classList.remove('d-none');
                bodyEl.innerHTML = `
                    <div class="alert alert-danger py-2 mb-0 rounded-4 border-0" role="alert">
                        <i class="bi bi-exclamation-octagon-fill me-1"></i> ${escapeHtml(err.message || 'Lỗi kết nối máy chủ. Vui lòng thử lại.')}
                    </div>`;
            } finally {
                sendBtn.disabled = !input.value.trim();
                sendIcon.classList.remove('d-none');
                sendSpinner.classList.add('d-none');
                scrollToBottom();
            }
        }

        function escapeHtml(text) {
            if (!text) return '';
            return String(text)
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#039;");
        }

        function decodeHtml(html) {
            const txt = document.createElement('textarea');
            txt.innerHTML = html;
            return txt.value;
        }
    </script>
}



