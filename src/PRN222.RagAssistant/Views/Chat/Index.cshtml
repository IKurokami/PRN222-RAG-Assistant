@model PRN222.RagAssistant.Controllers.ChatViewModel
@{
    ViewData["Title"] = "Giao diện Trò chuyện RAG";
}

@Html.AntiForgeryToken()

<div class="container-fluid px-3 py-3">
    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-warning border-0 shadow-sm rounded-3 mb-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@ViewBag.ErrorMessage
        </div>
    }

    <div class="row g-3">
        <!-- Sidebar: Subjects & History Sessions -->
        <div class="col-lg-3 col-md-4">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-header bg-white border-bottom py-3">
                    <label for="subjectSelect" class="form-label small fw-bold text-uppercase text-muted mb-1">Môn học đang chọn</label>
                    <select id="subjectSelect" class="form-select form-select-sm fw-semibold" onchange="switchSubject(this.value)">
                        @foreach (var s in Model.Subjects)
                        {
                            if (s.Id == Model.SelectedSubjectId)
                            {
                                <option value="@s.Id" selected="selected">[@s.Code] @s.Name</option>
                            }
                            else
                            {
                                <option value="@s.Id">[@s.Code] @s.Name</option>
                            }
                        }
                    </select>
                </div>

                <div class="card-body p-2 d-flex flex-column">
                    <form asp-action="NewSession" method="post" class="mb-2">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="subjectId" value="@Model.SelectedSubjectId" />
                        <button type="submit" class="btn btn-primary btn-sm w-100 rounded-2 py-2 fw-semibold">
                            <i class="bi bi-plus-lg me-1"></i> Cuộc trò chuyện mới
                        </button>
                    </form>

                    <div class="text-uppercase small fw-bold text-muted px-2 py-1">Lịch sử hội thoại</div>

                    <div class="list-group list-group-flush flex-grow-1 overflow-auto pe-1" style="max-height: 520px;">
                        @if (Model.Sessions.Count == 0)
                        {
                            <div class="text-center text-muted py-4 small">
                                <i class="bi bi-chat-left-dots fs-3 d-block mb-1"></i>
                                Chưa có cuộc trò chuyện nào.
                            </div>
                        }
                        else
                        {
                            @foreach (var session in Model.Sessions)
                            {
                                var isActive = Model.ActiveSession != null && Model.ActiveSession.Id == session.Id;
                                <div class="list-group-item list-group-item-action d-flex align-items-center justify-content-between p-2 rounded-2 mb-1 border-0 @(isActive ? "active bg-primary-subtle text-primary fw-semibold" : "")">
                                    <a href="@Url.Action("Index", "Chat", new { subjectId = Model.SelectedSubjectId, sessionId = session.Id })" class="text-decoration-none text-truncate flex-grow-1 me-2 text-dark">
                                        <i class="bi bi-chat-text me-1 text-primary"></i>
                                        <span>@(string.IsNullOrWhiteSpace(session.Title) ? "Trò chuyện " + session.CreatedAtUtc.ToString("dd/MM HH:mm") : session.Title)</span>
                                    </a>
                                    <form asp-action="DeleteSession" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn xóa cuộc trò chuyện này?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="sessionId" value="@session.Id" />
                                        <input type="hidden" name="subjectId" value="@Model.SelectedSubjectId" />
                                        <button type="submit" class="btn btn-link btn-sm text-danger p-0 border-0" title="Xóa">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Main Chat Area -->
        <div class="col-lg-9 col-md-8">
            <div class="card border-0 shadow-sm rounded-3 d-flex flex-column" style="height: 680px;">
                <!-- Header -->
                <div class="card-header bg-white border-bottom py-3 d-flex align-items-center justify-content-between">
                    <div>
                        <h6 class="mb-0 fw-bold text-dark">
                            <i class="bi bi-robot text-primary me-2 fs-5"></i>
                            Trợ lý RAG AI - [@Model.SelectedSubjectCode] @Model.SelectedSubjectName
                        </h6>
                        <small class="text-muted">Hỏi đáp thông minh dựa trên tài liệu giáo trình đã được indexed</small>
                    </div>
                    <span class="badge bg-success-subtle text-success px-2 py-1 rounded-pill">
                        <i class="bi bi-check-circle-fill me-1"></i> RAG Grounded Context
                    </span>
                </div>

                <!-- Chat Message Stream -->
                <div id="chatStream" class="card-body overflow-auto p-3 flex-grow-1 bg-light">
                    @if (Model.Messages.Count == 0)
                    {
                        <div class="text-center py-5 text-muted">
                            <div class="mb-3">
                                <i class="bi bi-cpu-fill text-primary" style="font-size: 3rem;"></i>
                            </div>
                            <h5 class="fw-bold text-dark mb-1">Xin chào! Tôi có thể giúp gì cho bạn?</h5>
                            <p class="small text-secondary mb-3">Hãy nhập câu hỏi bên dưới hoặc chọn một câu hỏi gợi ý để bắt đầu.</p>

                            <!-- Prompt Suggestions -->
                            <div class="d-flex flex-wrap justify-content-center gap-2 max-w-lg mx-auto">
                                <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-3" onclick="usePrompt('Pattern Matching trong C# là gì và có các dạng pattern nào?')">
                                    💡 Pattern Matching trong C#
                                </button>
                                <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-3" onclick="usePrompt('Phân biệt Task và ValueTask trong lập trình bất đồng bộ?')">
                                    💡 Task vs ValueTask
                                </button>
                                <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-3" onclick="usePrompt('Cơ chế Middleware Pipeline trong ASP.NET Core hoạt động thế nào?')">
                                    💡 ASP.NET Core Middleware
                                </button>
                                <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-3" onclick="usePrompt('Tại sao nên sử dụng AsNoTracking() trong EF Core?')">
                                    💡 EF Core AsNoTracking
                                </button>
                            </div>
                        </div>
                    }
                    else
                    {
                        @foreach (var msg in Model.Messages)
                        {
                            if (msg.Role == PRN222.RagAssistant.Domain.Enums.ChatMessageRole.User)
                            {
                                <div class="d-flex justify-content-end mb-3">
                                    <div class="bg-primary text-white rounded-3 px-3 py-2 shadow-sm" style="max-width: 80%;">
                                        <div class="small fw-semibold mb-1 text-white-50"><i class="bi bi-person-fill me-1"></i>Bạn</div>
                                        <div class="text-break" style="white-space: pre-wrap;">@msg.Content</div>
                                        <div class="text-end small text-white-50 mt-1" style="font-size: 0.7rem;">@msg.CreatedAtUtc.ToLocalTime().ToString("HH:mm")</div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="d-flex justify-content-start mb-3">
                                    <div class="bg-white border rounded-3 px-3 py-2 shadow-sm text-dark" style="max-width: 85%;">
                                        <div class="small fw-bold text-primary mb-1"><i class="bi bi-robot me-1"></i>PRN222 Assistant</div>
                                        <div class="text-break" style="white-space: pre-wrap;">@msg.Content</div>

                                        @if (msg.Citations.Count > 0)
                                        {
                                            <div class="mt-3 pt-2 border-top">
                                                <div class="small fw-bold text-muted mb-2"><i class="bi bi-journal-bookmark-fill me-1 text-warning"></i>Nguồn trích dẫn (@msg.Citations.Count):</div>
                                                <div class="d-flex flex-wrap gap-2">
                                                    @foreach (var cit in msg.Citations)
                                                    {
                                                        <span class="badge bg-secondary-subtle text-dark border px-2 py-1 text-start" title="@cit.ChunkContent">
                                                            <i class="bi bi-file-earmark-pdf me-1 text-danger"></i>
                                                            <strong>@cit.DocumentTitle</strong>
                                                            @if (cit.SlideNumber.HasValue)
                                                            {
                                                                <span>(Slide @cit.SlideNumber)</span>
                                                            }
                                                            else if (cit.PageNumber.HasValue)
                                                            {
                                                                <span>(Trang @cit.PageNumber)</span>
                                                            }
                                                        </span>
                                                    }
                                                </div>
                                            </div>
                                        }
                                        <div class="text-end small text-muted mt-1" style="font-size: 0.7rem;">@msg.CreatedAtUtc.ToLocalTime().ToString("HH:mm")</div>
                                    </div>
                                </div>
                            }
                        }
                    }
                </div>

                <!-- Input Footer -->
                <div class="card-footer bg-white border-top p-3">
                    <form id="chatForm" onsubmit="submitQuestion(event)">
                        <div class="input-group">
                            <textarea id="questionInput" class="form-control border-end-0" rows="2" placeholder="Nhập câu hỏi của bạn về giáo trình môn học..." required></textarea>
                            <button type="submit" id="sendBtn" class="btn btn-primary px-4 d-flex align-items-center">
                                <span id="sendText"><i class="bi bi-send-fill me-1"></i> Gửi</span>
                                <span id="sendSpinner" class="spinner-border spinner-border-sm d-none" role="status"></span>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const activeSubjectId = '@Model.SelectedSubjectId';
        const activeSessionId = '@(Model.ActiveSession?.Id)';

        function switchSubject(subjectId) {
            window.location.href = '@Url.Action("Index", "Chat")?subjectId=' + subjectId;
        }

        function usePrompt(text) {
            document.getElementById('questionInput').value = text;
            document.getElementById('questionInput').focus();
        }

        async function submitQuestion(event) {
            event.preventDefault();
            const input = document.getElementById('questionInput');
            const questionText = input.value.trim();
            if (!questionText || !activeSessionId) return;

            const sendBtn = document.getElementById('sendBtn');
            const sendText = document.getElementById('sendText');
            const sendSpinner = document.getElementById('sendSpinner');
            const chatStream = document.getElementById('chatStream');

            // Render User message bubble immediately
            const userMsgHtml = `
                <div class="d-flex justify-content-end mb-3">
                    <div class="bg-primary text-white rounded-3 px-3 py-2 shadow-sm" style="max-width: 80%;">
                        <div class="small fw-semibold mb-1 text-white-50"><i class="bi bi-person-fill me-1"></i>Bạn</div>
                        <div class="text-break" style="white-space: pre-wrap;">${escapeHtml(questionText)}</div>
                    </div>
                </div>`;
            chatStream.insertAdjacentHTML('beforeend', userMsgHtml);
            input.value = '';
            chatStream.scrollTop = chatStream.scrollHeight;

            // Show loading spinner
            sendBtn.disabled = true;
            sendText.classList.add('d-none');
            sendSpinner.classList.remove('d-none');

            // Append temporary Assistant loading bubble
            const loadingId = 'loading-' + Date.now();
            const loadingHtml = `
                <div id="${loadingId}" class="d-flex justify-content-start mb-3">
                    <div class="bg-white border rounded-3 px-3 py-2 shadow-sm text-dark" style="max-width: 85%;">
                        <div class="small fw-bold text-primary mb-1"><i class="bi bi-robot me-1"></i>PRN222 Assistant</div>
                        <div class="d-flex align-items-center text-muted py-2">
                            <div class="spinner-grow spinner-grow-sm text-primary me-2" role="status"></div>
                            <span>Đang truy vấn kiến thức pgvector và khởi tạo câu trả lời...</span>
                        </div>
                    </div>
                </div>`;
            chatStream.insertAdjacentHTML('beforeend', loadingHtml);
            chatStream.scrollTop = chatStream.scrollHeight;

            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                const response = await fetch('@Url.Action("Ask", "Chat")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify({
                        sessionId: activeSessionId,
                        subjectId: activeSubjectId,
                        question: questionText
                    })
                });

                const data = await response.json();
                document.getElementById(loadingId).remove();

                if (data.success) {
                    let citationsHtml = '';
                    if (data.citations && data.citations.length > 0) {
                        const badges = data.citations.map(c => {
                            const location = c.slideNumber
                                ? `(Slide ${c.slideNumber})`
                                : (c.pageNumber ? `(Trang ${c.pageNumber})` : '');
                            return `
                            <span class="badge bg-secondary-subtle text-dark border px-2 py-1 text-start" title="${escapeHtml(c.excerpt)}">
                                <i class="bi bi-file-earmark-pdf me-1 text-danger"></i>
                                <strong>${escapeHtml(c.documentTitle)}</strong> ${location} - Ref #${c.rank}
                            </span>`;
                        }).join('');
                        citationsHtml = `
                            <div class="mt-3 pt-2 border-top">
                                <div class="small fw-bold text-muted mb-2"><i class="bi bi-journal-bookmark-fill me-1 text-warning"></i>Nguồn trích dẫn (${data.citations.length}):</div>
                                <div class="d-flex flex-wrap gap-2">${badges}</div>
                            </div>`;
                    }

                    const assistantHtml = `
                        <div class="d-flex justify-content-start mb-3">
                            <div class="bg-white border rounded-3 px-3 py-2 shadow-sm text-dark" style="max-width: 85%;">
                                <div class="small fw-bold text-primary mb-1"><i class="bi bi-robot me-1"></i>PRN222 Assistant</div>
                                <div class="text-break" style="white-space: pre-wrap;">${escapeHtml(data.answer)}</div>
                                ${citationsHtml}
                            </div>
                        </div>`;
                    chatStream.insertAdjacentHTML('beforeend', assistantHtml);
                } else {
                    const errorHtml = `
                        <div class="d-flex justify-content-start mb-3">
                            <div class="bg-danger-subtle border-danger text-danger rounded-3 px-3 py-2 shadow-sm" style="max-width: 85%;">
                                <i class="bi bi-exclamation-octagon-fill me-1"></i> Lỗi: ${escapeHtml(data.message || 'Không thể lấy phản hồi')}
                            </div>
                        </div>`;
                    chatStream.insertAdjacentHTML('beforeend', errorHtml);
                }
            } catch (err) {
                document.getElementById(loadingId)?.remove();
                const errHtml = `
                    <div class="d-flex justify-content-start mb-3">
                        <div class="bg-danger-subtle border-danger text-danger rounded-3 px-3 py-2 shadow-sm">
                            <i class="bi bi-exclamation-octagon-fill me-1"></i> Lỗi kết nối máy chủ. Vui lòng thử lại sau.
                        </div>
                    </div>`;
                chatStream.insertAdjacentHTML('beforeend', errHtml);
            } finally {
                sendBtn.disabled = false;
                sendText.classList.remove('d-none');
                sendSpinner.classList.add('d-none');
                chatStream.scrollTop = chatStream.scrollHeight;
            }
        }

        function escapeHtml(text) {
            if (!text) return '';
            return text
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#039;");
        }
    </script>
}
