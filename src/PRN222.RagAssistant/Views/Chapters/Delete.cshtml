@model ChapterDeleteViewModel
@{
    ViewData["Title"] = $"Xóa chương - {Model.SubjectCode}";
}
<div class="row justify-content-center"><div class="col-md-6">
    <div class="d-flex justify-content-between align-items-start mb-4"><div><div class="small text-muted">@Model.SubjectCode - @Model.SubjectName</div><h2 class="mb-1">Xác nhận xóa chương</h2></div><a asp-controller="Chapters" asp-action="Index" asp-route-subjectId="@Model.SubjectId" class="btn btn-outline-secondary">Quay lại</a></div>
    <div class="card shadow-sm border-danger"><div class="card-body"><h5>Chương @Model.ChapterNumber: @Model.ChapterTitle</h5><p class="mb-0 text-muted">@Model.AffectedDocumentCount tài liệu đang liên kết.</p></div></div>
    @if (Model.AffectedDocumentCount > 0) { <div class="alert alert-warning mt-3">Tài liệu sẽ được bỏ gán chương nhưng không bị xóa.</div> }
    <div class="d-flex gap-2 mt-3"><form method="post" asp-controller="Chapters" asp-action="Delete" asp-route-id="@Model.Id" class="flex-fill"><button type="submit" class="btn btn-danger w-100">Xác nhận xóa</button></form><a asp-controller="Chapters" asp-action="Index" asp-route-subjectId="@Model.SubjectId" class="btn btn-outline-secondary flex-fill">Hủy</a></div>
</div></div>
