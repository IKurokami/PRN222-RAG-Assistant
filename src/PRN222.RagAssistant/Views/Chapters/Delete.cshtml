@model ChapterDeleteViewModel
@{
    ViewData["Title"] = $"Xóa chương - {Model.SubjectCode}";
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <div class="academic-breadcrumb mb-3">
        <a asp-page="/Index"><i class="bi bi-house-door"></i> Trang chủ</a>
        <span class="academic-breadcrumb-separator">/</span>
        <a asp-controller="Subjects" asp-action="Index">Môn học</a>
        <span class="academic-breadcrumb-separator">/</span>
        <a asp-controller="Chapters" asp-action="Index" asp-route-subjectId="@Model.SubjectId">Chương @Model.SubjectCode</a>
        <span class="academic-breadcrumb-separator">/</span>
        <span class="fw-semibold">Xóa chương @Model.ChapterNumber</span>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <div class="badge bg-danger-subtle text-danger border border-danger-subtle px-2.5 py-1 mb-1 font-monospace rounded-pill">@Model.SubjectCode — @Model.SubjectName</div>
                    <h1 class="fw-bold fs-3 text-dark mb-1">
                        <i class="bi bi-exclamation-triangle text-danger me-2"></i>Xác Nhận Xóa Chương
                    </h1>
                    <p class="text-muted small mb-0">Vui lòng kiểm tra kỹ thông tin trước khi thực hiện thao tác xóa.</p>
                </div>
                <a asp-controller="Chapters" asp-action="Index" asp-route-subjectId="@Model.SubjectId" class="btn btn-sm btn-outline-secondary btn-press">
                    <i class="bi bi-arrow-left"></i> Quay lại
                </a>
            </div>

            <div class="academic-card card-lift border-danger-subtle shadow-sm mb-4 bg-white border rounded-4 overflow-hidden">
                <div class="academic-card-header bg-danger-subtle p-3 d-flex align-items-center gap-2 border-bottom border-danger-subtle">
                    <i class="bi bi-trash text-danger fs-5"></i>
                    <h4 class="fw-bold fs-6 text-danger mb-0">Thông tin chương học sẽ bị gỡ bỏ</h4>
                </div>

                <div class="p-4">
                    <dl class="row mb-0 g-2">
                        <dt class="col-sm-4 text-muted small fw-semibold">Số thứ tự</dt>
                        <dd class="col-sm-8 fw-bold text-dark font-monospace">Chương @Model.ChapterNumber</dd>

                        <dt class="col-sm-4 text-muted small fw-semibold">Tên chương</dt>
                        <dd class="col-sm-8 fw-semibold text-dark">@Model.ChapterTitle</dd>
                    </dl>
                </div>
            </div>

            @if (Model.AffectedDocumentCount > 0)
            {
                <div class="alert alert-warning d-flex align-items-start gap-2 shadow-sm mb-4" role="alert" style="border-radius: var(--radius-md);">
                    <i class="bi bi-shield-exclamation text-warning fs-4 mt-1"></i>
                    <div class="small">
                        <h6 class="alert-heading fw-bold mb-1">
                            Cảnh báo: Đang có @Model.AffectedDocumentCount tài liệu liên kết
                        </h6>
                        Khi xóa chương, <strong>@Model.AffectedDocumentCount tài liệu</strong> sẽ được chuyển về trạng thái <em>Chưa phân loại (ChapterId = null)</em>. Toàn bộ tài liệu và vector chunks <strong>vẫn được bảo toàn nguyên vẹn trong hệ thống</strong>.
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-info d-flex align-items-center gap-2 shadow-sm mb-4 small" role="alert" style="border-radius: var(--radius-md);">
                    <i class="bi bi-info-circle-fill text-primary fs-5"></i>
                    <div>Chương này hiện không có tài liệu nào liên kết. Có thể thực hiện xóa an toàn.</div>
                </div>
            }

            <div class="d-flex justify-content-end gap-2">
                <a asp-controller="Chapters" asp-action="Index" asp-route-subjectId="@Model.SubjectId" class="btn btn-outline-secondary btn-press" style="border-radius: var(--radius-md);">Hủy bỏ</a>
                <form method="post" asp-controller="Chapters" asp-action="Delete" asp-route-id="@Model.Id" class="d-inline">
                    <button type="submit" class="btn btn-danger btn-press px-4" style="border-radius: var(--radius-md); font-weight: 600;">
                        <i class="bi bi-trash-fill me-1"></i> Xác nhận xóa
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
