@model ChapterCreateViewModel
@{
    ViewData["Title"] = $"Tạo chương - {Model.SubjectCode}";
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <div class="academic-breadcrumb mb-3">
        <a asp-page="/Index"><i class="bi bi-house-door"></i> Trang chủ</a>
        <span class="academic-breadcrumb-separator">/</span>
        <a asp-controller="Subjects" asp-action="Index">Môn học</a>
        <span class="academic-breadcrumb-separator">/</span>
        <a asp-controller="Chapters" asp-action="Index" asp-route-subjectId="@Model.SubjectId">Chương @Model.SubjectCode</a>
        <span class="academic-breadcrumb-separator">/</span>
        <span class="text-slate-800 fw-semibold">Tạo chương mới</span>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <div class="badge bg-primary-subtle text-primary border border-primary-subtle px-2.5 py-1 mb-1 font-monospace">@Model.SubjectCode — @Model.SubjectName</div>
                    <h1 class="fw-bold fs-3 text-slate-900 mb-1">
                        <i class="bi bi-plus-circle text-primary me-2"></i>Thêm Chương Học Mới
                    </h1>
                </div>
                <a asp-controller="Chapters" asp-action="Index" asp-route-subjectId="@Model.SubjectId" class="btn btn-sm btn-academic-outline">
                    <i class="bi bi-arrow-left"></i> Quay lại
                </a>
            </div>

            <div class="academic-card shadow-sm">
                <form method="post" asp-controller="Chapters" asp-action="Create">
                    <input asp-for="SubjectId" type="hidden" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger d-flex align-items-center gap-2 mb-4" role="alert"></div>

                    <div class="mb-4">
                        <label asp-for="Input.Number" class="form-label fw-bold text-slate-800">
                            Số thứ tự chương <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Input.Number" class="form-control" type="number" min="1" max="999" placeholder="Ví dụ: 1" />
                        <div class="form-text text-slate-500">Số thứ tự chương học (từ 1 đến 999), không được trùng lặp.</div>
                        <span asp-validation-for="Input.Number" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Input.Title" class="form-label fw-bold text-slate-800">
                            Tên tiêu đề chương học <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Input.Title" class="form-control" placeholder="Ví dụ: C# 12 Fundamentals &amp; Advanced Memory Management" />
                        <div class="form-text text-slate-500">Tên chương thể hiện chủ đề kiến thức môn @Model.SubjectCode.</div>
                        <span asp-validation-for="Input.Title" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a asp-controller="Chapters" asp-action="Index" asp-route-subjectId="@Model.SubjectId" class="btn btn-academic-outline">Hủy bỏ</a>
                        <button type="submit" class="btn-academic-primary px-4">
                            <i class="bi bi-check2-circle"></i> Tạo chương học
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
