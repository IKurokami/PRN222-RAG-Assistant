@model ChapterIndexViewModel
@{
    ViewData["Title"] = $"Chương - {Model.SubjectCode}";
}

<div class="d-flex justify-content-between align-items-start mb-4 gap-3 flex-wrap">
    <div>
        <div class="small text-muted">@Model.SubjectCode</div>
        <h2 class="mb-1">Chương môn học</h2>
        <p class="text-muted mb-0">@Model.SubjectName</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Documents" asp-action="Index" asp-route-subjectId="@Model.SubjectId" class="btn btn-outline-secondary">Tài liệu</a>
        @if (Model.CanManageDocuments)
        {
            <a asp-controller="Chapters" asp-action="Create" asp-route-subjectId="@Model.SubjectId" class="btn btn-primary">Thêm chương</a>
        }
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage)) { <div class="alert alert-success">@Model.StatusMessage</div> }

@if (Model.Chapters.Count == 0)
{
    <div class="text-center py-5 border rounded bg-light"><h5 class="text-muted">Chưa có chương</h5></div>
}
else
{
    <div class="table-responsive shadow-sm rounded"><table class="table table-hover align-middle mb-0 bg-white border">
        <thead class="table-light"><tr><th style="width:90px">Số</th><th>Tên chương</th><th class="text-center">Tài liệu</th>@if (Model.CanManageDocuments) { <th class="text-end">Thao tác</th> }</tr></thead>
        <tbody>
        @foreach (var chapter in Model.Chapters)
        {
            <tr>
                <td class="fw-bold">@chapter.Number</td>
                <td>@chapter.Title</td>
                <td class="text-center"><a asp-controller="Documents" asp-action="Index" asp-route-subjectId="@Model.SubjectId" asp-route-selectedChapterId="@chapter.Id" class="badge bg-info text-dark text-decoration-none">@chapter.DocumentCount tài liệu</a></td>
                @if (Model.CanManageDocuments)
                {
                    <td class="text-end"><a asp-controller="Chapters" asp-action="Edit" asp-route-id="@chapter.Id" class="btn btn-sm btn-outline-primary">Sửa</a> <a asp-controller="Chapters" asp-action="Delete" asp-route-id="@chapter.Id" class="btn btn-sm btn-outline-danger">Xóa</a></td>
                }
            </tr>
        }
        </tbody>
    </table></div>
}
