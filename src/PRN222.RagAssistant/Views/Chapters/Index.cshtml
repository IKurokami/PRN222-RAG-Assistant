@model ChapterIndexViewModel
@{
    ViewData["Title"] = "Quản lý Chương - PRN222";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1">Danh sách Chương - PRN222</h2>
        <p class="text-muted mb-0">Các chương môn học dùng để phân loại tài liệu.</p>
    </div>
    @if (Model.CanManageDocuments)
    {
        <a asp-controller="Chapters" asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Thêm chương mới
        </a>
    }
</div>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @Model.StatusMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (Model.Chapters.Count == 0)
{
    <div class="text-center py-5 border rounded bg-light">
        <h5 class="text-muted">Chưa có chương nào</h5>
        <p class="text-muted">Các chương môn học sẽ hiển thị tại đây.</p>
        @if (Model.CanManageDocuments)
        {
            <a asp-controller="Chapters" asp-action="Create" class="btn btn-primary mt-2">Thêm chương đầu tiên</a>
        }
    </div>
}
else
{
    <div class="table-responsive shadow-sm rounded">
        <table class="table table-hover align-middle mb-0 bg-white border">
            <thead class="table-light">
                <tr>
                    <th scope="col" style="width:80px">Số TT</th>
                    <th scope="col">Tên chương</th>
                    <th scope="col" style="width:140px" class="text-center">Số tài liệu</th>
                    @if (Model.CanManageDocuments)
                    {
                        <th scope="col" class="text-end" style="width:160px">Thao tác</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var chapter in Model.Chapters)
                {
                    <tr>
                        <td class="fw-bold text-center">@chapter.Number</td>
                        <td>@chapter.Title</td>
                        <td class="text-center">
                            <a asp-controller="Documents" asp-action="Index" asp-route-selectedChapterId="@chapter.Id"
                               class="badge bg-info text-dark text-decoration-none">
                                @chapter.DocumentCount tài liệu
                            </a>
                        </td>
                        @if (Model.CanManageDocuments)
                        {
                            <td class="text-end pe-3">
                                <div class="d-flex gap-2 justify-content-end">
                                    <a asp-controller="Chapters" asp-action="Edit" asp-route-id="@chapter.Id"
                                       class="btn btn-sm px-3 fw-medium"
                                       style="background:#e8f4fd;color:#0d6efd;border:none;border-radius:8px;">
                                        Sửa
                                    </a>
                                    <a asp-controller="Chapters" asp-action="Delete" asp-route-id="@chapter.Id"
                                       class="btn btn-sm px-3 fw-medium"
                                       style="background:#fde8e8;color:#dc3545;border:none;border-radius:8px;">
                                        Xóa
                                    </a>
                                </div>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<div class="mt-3">
    <a asp-controller="Documents" asp-action="Index" class="btn btn-outline-secondary btn-sm">← Quay lại danh sách tài liệu</a>
</div>
