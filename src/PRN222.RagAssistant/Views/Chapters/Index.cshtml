@model ChapterIndexViewModel
@{
    ViewData["Title"] = $"Quản lý chương - {Model.SubjectCode}";
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <div class="academic-breadcrumb mb-3">
        <a asp-page="/Index"><i class="bi bi-house-door"></i> Trang chủ</a>
        <span class="academic-breadcrumb-separator">/</span>
        <a asp-controller="Subjects" asp-action="Index">Môn học</a>
        <span class="academic-breadcrumb-separator">/</span>
        <span class="fw-semibold">Chương môn @Model.SubjectCode</span>
    </div>

    <!-- Header Section -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4 pb-2 border-bottom">
        <div>
            <div class="badge bg-primary-subtle text-primary border border-primary-subtle px-2.5 py-1 mb-1 font-monospace rounded-pill">@Model.SubjectCode — @Model.SubjectName</div>
            <h1 class="fw-bold fs-3 text-dark mb-1">
                <i class="bi bi-list-nested text-primary me-2"></i>Lộ Trình &amp; Quản Lý Chương Học
            </h1>
            <p class="text-muted small mb-0">Khung chương trình môn học đồng bộ theo đề cương FLM.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Documents" asp-action="Index" asp-route-subjectId="@Model.SubjectId" class="btn btn-sm btn-outline-secondary btn-press d-inline-flex align-items-center gap-1" style="border-radius: var(--radius-md); font-size: 0.85rem; font-weight: 600;">
                <i class="bi bi-journal-bookmark"></i> Kho tài liệu
            </a>
            @if (Model.CanManageDocuments)
            {
                <a asp-controller="Chapters" asp-action="Create" asp-route-subjectId="@Model.SubjectId" class="btn btn-sm btn-primary btn-press d-inline-flex align-items-center gap-1" style="background-color: var(--color-primary-600); border-color: var(--color-primary-600); border-radius: var(--radius-md); font-size: 0.85rem; font-weight: 600;">
                    <i class="bi bi-plus-circle-fill"></i> Thêm chương mới
                </a>
            }
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="alert alert-success d-flex align-items-center gap-2 alert-dismissible fade show shadow-xs mb-4" role="alert" style="border-radius: var(--radius-md);">
            <i class="bi bi-check-circle-fill text-success fs-5"></i>
            <div>@Model.StatusMessage</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (Model.Chapters.Count == 0)
    {
        <div class="academic-card text-center py-5 bg-white border rounded-4 shadow-sm p-4">
            <div class="text-muted mb-3">
                <i class="bi bi-journal-plus" style="font-size: 3rem;"></i>
            </div>
            <h5 class="fw-bold text-dark">Chưa có chương học nào được tạo</h5>
            <p class="text-muted small mx-auto mb-3" style="max-width: 400px;">
                Hãy tạo các chương học đầu tiên theo đề cương @Model.SubjectCode để phân loại tài liệu bài giảng.
            </p>
            @if (Model.CanManageDocuments)
            {
                <a asp-controller="Chapters" asp-action="Create" asp-route-subjectId="@Model.SubjectId" class="btn btn-sm btn-primary btn-press text-decoration-none">
                    <i class="bi bi-plus-lg"></i> Thêm chương đầu tiên
                </a>
            }
        </div>
    }
    else
    {
        <div class="academic-card card-lift p-0 overflow-hidden shadow-sm border bg-white rounded-4">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="bg-light text-muted small text-uppercase" style="letter-spacing: 0.05em; border-bottom: 1px solid var(--color-border-warm);">
                        <tr>
                            <th scope="col" style="width: 110px;" class="text-center py-3">Số thứ tự</th>
                            <th scope="col" style="min-width: 320px;" class="py-3">Tên tiêu đề chương học</th>
                            <th scope="col" style="width: 180px;" class="text-center py-3">Tài liệu liên kết</th>
                            @if (Model.CanManageDocuments)
                            {
                                <th scope="col" class="text-end pe-4 py-3" style="width: 200px;">Thao tác</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < Model.Chapters.Count; i++)
                        {
                            var chapter = Model.Chapters[i];
                            <tr class="stagger-row" style="animation-delay: @(i * 35)ms; border-bottom: 1px solid var(--color-border-subtle);">
                                <td class="text-center py-3">
                                    <span class="badge bg-primary text-white fs-6 px-2.5 py-1 font-monospace rounded-pill" style="min-width: 36px;">
                                        @chapter.Number
                                    </span>
                                </td>
                                <td>
                                    <span class="fw-bold text-dark fs-6">@chapter.Title</span>
                                </td>
                                <td class="text-center">
                                    <a asp-controller="Documents" asp-action="Index" asp-route-subjectId="@Model.SubjectId" asp-route-selectedChapterId="@chapter.Id"
                                       class="badge bg-light text-primary border border-primary-subtle text-decoration-none px-2.5 py-1.5 fw-semibold rounded-pill btn-press"
                                       title="Xem tài liệu thuộc chương này">
                                        <i class="bi bi-files me-1"></i>@chapter.DocumentCount tài liệu
                                    </a>
                                </td>
                                @if (Model.CanManageDocuments)
                                {
                                    <td class="text-end pe-4">
                                        <div class="d-flex gap-1 justify-content-end align-items-center">
                                            <a asp-controller="Chapters" asp-action="Edit" asp-route-id="@chapter.Id"
                                               class="btn btn-sm btn-outline-secondary btn-press d-inline-flex align-items-center gap-1"
                                               style="border-radius: var(--radius-sm); font-size: 0.8rem; font-weight: 500;"
                                               title="Sửa chương">
                                                <i class="bi bi-pencil"></i> Sửa
                                            </a>
                                            <a asp-controller="Chapters" asp-action="Delete" asp-route-id="@chapter.Id"
                                               class="btn btn-sm btn-outline-danger btn-press d-inline-flex align-items-center gap-1"
                                               style="border-radius: var(--radius-sm); font-size: 0.8rem; font-weight: 500;"
                                               title="Xóa chương">
                                                <i class="bi bi-trash"></i> Xóa
                                            </a>
                                        </div>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
