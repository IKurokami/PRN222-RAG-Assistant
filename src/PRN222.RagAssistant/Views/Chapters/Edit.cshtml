@model ChapterEditViewModel
@{
    ViewData["Title"] = $"Sửa chương - {Model.SubjectCode}";
}
<div class="row justify-content-center"><div class="col-md-6">
    <div class="d-flex justify-content-between align-items-start mb-4"><div><div class="small text-muted">@Model.SubjectCode - @Model.SubjectName</div><h2 class="mb-1">Sửa chương @Model.OriginalNumber</h2></div><a asp-controller="Chapters" asp-action="Index" asp-route-subjectId="@Model.SubjectId" class="btn btn-outline-secondary">Quay lại</a></div>
    <div class="card shadow-sm"><div class="card-body"><form method="post" asp-controller="Chapters" asp-action="Edit" asp-route-id="@Model.Id">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <div class="mb-3"><label asp-for="Input.Number" class="form-label fw-bold"></label><input asp-for="Input.Number" class="form-control" type="number" min="1" max="999" /><span asp-validation-for="Input.Number" class="text-danger"></span></div>
        <div class="mb-4"><label asp-for="Input.Title" class="form-label fw-bold"></label><input asp-for="Input.Title" class="form-control" /><span asp-validation-for="Input.Title" class="text-danger"></span></div>
        <div class="d-flex justify-content-end gap-2"><a asp-controller="Chapters" asp-action="Index" asp-route-subjectId="@Model.SubjectId" class="btn btn-light">Hủy</a><button type="submit" class="btn btn-primary">Lưu</button></div>
    </form></div></div>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
