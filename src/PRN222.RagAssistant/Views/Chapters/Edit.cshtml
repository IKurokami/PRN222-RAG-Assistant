@model ChapterEditViewModel
@{
    ViewData["Title"] = $"Sửa chương {Model.OriginalNumber} - {Model.SubjectCode}";
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <div class="academic-breadcrumb mb-3">
        <a asp-page="/Index"><i class="bi bi-house-door"></i> Trang chủ</a>
        <span class="academic-breadcrumb-separator">/</span>
        <a asp-controller="Subjects" asp-action="Index">Môn học</a>
        <span class="academic-breadcrumb-separator">/</span>
        <a asp-controller="Chapters" asp-action="Index" asp-route-subjectId="@Model.SubjectId">Chương @Model.SubjectCode</a>
        <span class="academic-breadcrumb-separator">/</span>
        <span class="fw-semibold">Chỉnh sửa chương @Model.OriginalNumber</span>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <div class="badge bg-primary-subtle text-primary border border-primary-subtle px-2.5 py-1 mb-1 font-monospace rounded-pill">@Model.SubjectCode — @Model.SubjectName</div>
                    <h1 class="fw-bold fs-3 text-dark mb-1">
                        <i class="bi bi-pencil-square text-primary me-2"></i>Chỉnh Sửa Chương Học
                    </h1>
                    <p class="text-muted small mb-0">Cập nhật: <strong>Chương @Model.OriginalNumber: @Model.OriginalTitle</strong></p>
                </div>
                <a asp-controller="Chapters" asp-action="Index" asp-route-subjectId="@Model.SubjectId" class="btn btn-sm btn-outline-secondary btn-press">
                    <i class="bi bi-arrow-left"></i> Quay lại
                </a>
            </div>

            <div class="academic-card card-lift shadow-sm bg-white border rounded-4 p-4">
                <form method="post" asp-controller="Chapters" asp-action="Edit" asp-route-id="@Model.Id">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small mb-4" role="alert" style="border-radius: var(--radius-md);"></div>

                    <div class="mb-4">
                        <label asp-for="Input.Number" class="form-label fw-bold small text-dark">
                            Số thứ tự chương <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Input.Number" class="form-control font-monospace input-focus-glow" type="number" min="1" max="999" style="border-radius: var(--radius-md); padding: 0.65rem 0.85rem;" />
                        <span asp-validation-for="Input.Number" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Input.Title" class="form-label fw-bold small text-dark">
                            Tên tiêu đề chương học <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Input.Title" class="form-control input-focus-glow" style="border-radius: var(--radius-md); padding: 0.65rem 0.85rem;" />
                        <span asp-validation-for="Input.Title" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a asp-controller="Chapters" asp-action="Index" asp-route-subjectId="@Model.SubjectId" class="btn btn-outline-secondary btn-press" style="border-radius: var(--radius-md);">Hủy bỏ</a>
                        <button type="submit" class="btn btn-primary btn-press px-4" style="background-color: var(--color-primary-600); border-color: var(--color-primary-600); border-radius: var(--radius-md); font-weight: 600;">
                            <i class="bi bi-check2 me-1"></i> Lưu thay đổi
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
