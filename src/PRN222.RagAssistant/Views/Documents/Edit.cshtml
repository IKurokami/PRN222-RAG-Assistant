@model DocumentEditViewModel
@{
    ViewData["Title"] = $"Chỉnh Sửa: {Model.DocumentTitle} - PRN222";
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <div class="academic-breadcrumb">
        <a asp-page="/Index"><i class="bi bi-house-door"></i> Trang chủ</a>
        <span class="academic-breadcrumb-separator">/</span>
        <a asp-controller="Documents" asp-action="Index">Kho tài liệu giáo trình</a>
        <span class="academic-breadcrumb-separator">/</span>
        <a asp-controller="Documents" asp-action="Details" asp-route-id="@Model.Id">Chi tiết</a>
        <span class="academic-breadcrumb-separator">/</span>
        <span class="text-slate-800 fw-semibold">Chỉnh sửa</span>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h1 class="fw-bold fs-3 text-slate-900 mb-1">
                        <i class="bi bi-pencil-square text-primary me-2"></i>Chỉnh Sửa Thông Tin Tài Liệu
                    </h1>
                    <p class="text-slate-500 mb-0">Cập nhật tiêu đề hiển thị hoặc phân bổ lại chương học.</p>
                </div>
                <a asp-controller="Documents" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-sm btn-academic-outline">
                    <i class="bi bi-arrow-left"></i> Quay lại
                </a>
            </div>

            <div class="academic-card shadow-sm">
                <form method="post" asp-controller="Documents" asp-action="Edit" asp-route-id="@Model.Id">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger d-flex align-items-center gap-2 mb-4" role="alert"></div>

                    <div class="mb-4">
                        <label asp-for="Input.Title" class="form-label fw-bold text-slate-800">
                            Tiêu đề tài liệu <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Input.Title" class="form-control" placeholder="Nhập tiêu đề mô tả cho tài liệu..." />
                        <span asp-validation-for="Input.Title" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Input.ChapterId" class="form-label fw-bold text-slate-800">
                            Chương học tương ứng
                        </label>
                        <select asp-for="Input.ChapterId" asp-items="Model.ChapterOptions" class="form-select">
                            <option value="">-- Tài liệu chung / Không gán chương cụ thể --</option>
                        </select>
                        <span asp-validation-for="Input.ChapterId" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a asp-controller="Documents" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-academic-outline">Hủy bỏ</a>
                        <button type="submit" class="btn-academic-primary px-4">
                            <i class="bi bi-check2"></i> Lưu thay đổi
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
