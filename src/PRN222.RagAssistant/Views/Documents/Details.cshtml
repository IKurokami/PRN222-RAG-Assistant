@using PRN222.RagAssistant.Domain.Enums
@model DocumentDetailsViewModel
@{
    ViewData["Title"] = $"Chi tiết - {Model.Document.Title}";
}

<div class="d-flex justify-content-between align-items-start mb-4 gap-3">
    <div>
        <div class="small text-muted">@Model.Document.SubjectCode - @Model.Document.SubjectName</div>
        <h2 class="mb-1">@Model.Document.Title</h2>
        <span class="text-muted">Chi tiết thông tin và trạng thái xử lý tài liệu</span>
    </div>
    <a asp-controller="Documents" asp-action="Index" asp-route-subjectId="@Model.Document.SubjectId" class="btn btn-outline-secondary">Quay lại danh sách</a>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card shadow-sm mb-4"><div class="card-header bg-light fw-bold">Thông tin chung</div><div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-4">Tiêu đề</dt><dd class="col-sm-8">@Model.Document.Title</dd>
                <dt class="col-sm-4">File gốc</dt><dd class="col-sm-8"><code>@Model.Document.OriginalFileName</code></dd>
                <dt class="col-sm-4">Môn học</dt><dd class="col-sm-8">@Model.Document.SubjectCode - @Model.Document.SubjectName</dd>
                <dt class="col-sm-4">Chương</dt><dd class="col-sm-8">@(Model.Document.ChapterNumber.HasValue ? $"Chương {Model.Document.ChapterNumber}: {Model.Document.ChapterTitle}" : "Chưa gán chương")</dd>
                <dt class="col-sm-4">Dung lượng</dt><dd class="col-sm-8">@Model.Document.FormattedSize</dd>
                <dt class="col-sm-4">Định dạng</dt><dd class="col-sm-8">@Model.Document.FileExtension (@Model.Document.ContentType)</dd>
                <dt class="col-sm-4">Người tải lên</dt><dd class="col-sm-8">@Model.Document.UploadedByEmail</dd>
                <dt class="col-sm-4">Thời gian</dt><dd class="col-sm-8">@Model.Document.UploadedAtUtc.ToString("dd/MM/yyyy HH:mm:ss") UTC</dd>
            </dl>
        </div></div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm mb-4"><div class="card-header bg-light fw-bold">Indexing</div><div class="card-body">
            <div class="mb-3">
                @switch (Model.Document.IndexStatus)
                {
                    case DocumentIndexStatus.Uploaded: <span class="badge bg-secondary">Uploaded</span> break;
                    case DocumentIndexStatus.Processing: <span class="badge bg-primary">Processing</span> break;
                    case DocumentIndexStatus.Indexed: <span class="badge bg-success">Indexed</span> break;
                    case DocumentIndexStatus.Failed: <span class="badge bg-danger">Failed</span> break;
                }
            </div>
            <div class="mb-2"><strong>@Model.Document.ChunkCount</strong> chunks</div>
            @if (Model.Document.IndexedAtUtc.HasValue) { <div class="small text-muted mb-2">Indexed: @Model.Document.IndexedAtUtc.Value.ToString("dd/MM/yyyy HH:mm:ss") UTC</div> }
            @if (!string.IsNullOrWhiteSpace(Model.Document.IndexError)) { <div class="alert alert-danger small mb-0">@Model.Document.IndexError</div> }
        </div></div>

        @if (Model.CanManageDocuments)
        {
            <div class="card shadow-sm"><div class="card-body d-grid gap-2">
                <a asp-controller="Documents" asp-action="Edit" asp-route-id="@Model.Document.Id" class="btn btn-primary">Chỉnh sửa</a>
                <form method="post" asp-controller="Documents" asp-action="Reindex" asp-route-id="@Model.Document.Id" onsubmit="return confirm('Index lại tài liệu này?');"><button class="btn btn-warning w-100" type="submit">Re-index</button></form>
                <form method="post" asp-controller="Documents" asp-action="Delete" asp-route-id="@Model.Document.Id" onsubmit="return confirm('Xóa tài liệu này?');"><button class="btn btn-outline-danger w-100" type="submit">Xóa</button></form>
            </div></div>
        }
    </div>
</div>
