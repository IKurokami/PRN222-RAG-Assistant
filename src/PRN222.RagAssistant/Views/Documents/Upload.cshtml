@model DocumentUploadViewModel
@{
    ViewData["Title"] = $"Tải tài liệu - {Model.SubjectCode}";
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <div class="academic-breadcrumb mb-3">
        <a asp-page="/Index"><i class="bi bi-house-door"></i> Trang chủ</a>
        <span class="academic-breadcrumb-separator">/</span>
        <a asp-controller="Subjects" asp-action="Index">Môn học</a>
        <span class="academic-breadcrumb-separator">/</span>
        <a asp-controller="Documents" asp-action="Index" asp-route-subjectId="@Model.SubjectId">Tài liệu @Model.SubjectCode</a>
        <span class="academic-breadcrumb-separator">/</span>
        <span class="fw-semibold">Tải lên tài liệu</span>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <div class="badge bg-primary-subtle text-primary border border-primary-subtle px-2.5 py-1 mb-1 font-monospace rounded-pill">@Model.SubjectCode — @Model.SubjectName</div>
                    <h1 class="fw-bold fs-3 text-dark mb-1">
                        <i class="bi bi-cloud-arrow-up text-primary me-2"></i>Tải Lên Tài Liệu Môn @Model.SubjectCode
                    </h1>
                    <p class="text-muted small mb-0">Hệ thống sẽ tự động trích xuất nội dung văn bản và tạo vector embeddings.</p>
                </div>
                <a asp-controller="Documents" asp-action="Index" asp-route-subjectId="@Model.SubjectId" class="btn btn-sm btn-outline-secondary btn-press">
                    <i class="bi bi-arrow-left"></i> Quay lại
                </a>
            </div>

            <div class="academic-card card-lift shadow-sm bg-white border rounded-4 p-4">
                <form method="post" asp-controller="Documents" asp-action="Upload" enctype="multipart/form-data" id="uploadDocForm">
                    <input asp-for="SubjectId" type="hidden" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small mb-4" role="alert" style="border-radius: var(--radius-md);"></div>

                    <!-- Title -->
                    <div class="mb-4">
                        <label asp-for="Input.Title" class="form-label fw-bold small text-dark">
                            Tiêu đề tài liệu <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Input.Title" class="form-control input-focus-glow" placeholder="Ví dụ: Giáo trình Chương 1: Nền tảng .NET 10 &amp; CLR Internals" style="border-radius: var(--radius-md); padding: 0.65rem 0.85rem;" />
                        <div class="form-text text-muted small">Đặt tên tiêu đề rõ ràng theo nội dung bài giảng để sinh viên dễ dàng tra cứu.</div>
                        <span asp-validation-for="Input.Title" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <!-- Chapter Selector -->
                    <div class="mb-4">
                        <label asp-for="Input.ChapterId" class="form-label fw-bold small text-dark">
                            Chương học tương ứng
                        </label>
                        <div class="input-group">
                            <select asp-for="Input.ChapterId" asp-items="Model.ChapterOptions" class="form-select input-focus-glow" style="border-radius: var(--radius-md) 0 0 var(--radius-md);">
                                <option value="">-- Tài liệu chung / Không thuộc chương cụ thể --</option>
                            </select>
                            <a asp-controller="Chapters" asp-action="Create" asp-route-subjectId="@Model.SubjectId" class="btn btn-outline-secondary btn-press" style="border-radius: 0 var(--radius-md) var(--radius-md) 0;" title="Tạo chương mới">
                                <i class="bi bi-plus-lg"></i> Thêm chương
                            </a>
                        </div>
                        <div class="form-text text-muted small">Gán tài liệu vào chương học theo đề cương môn @Model.SubjectCode.</div>
                        <span asp-validation-for="Input.ChapterId" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <!-- File Dropzone -->
                    <div class="mb-4">
                        <label asp-for="Input.File" class="form-label fw-bold small text-dark">
                            Tệp tài liệu đính kèm <span class="text-danger">*</span>
                        </label>
                        
                        <div class="academic-dropzone border border-2 border-dashed p-4 text-center rounded-4 cursor-pointer" id="dropzoneBox" style="border-color: var(--color-border-warm); background-color: var(--color-bg-warm); transition: all 200ms ease;" onclick="document.getElementById('Input_File').click();">
                            <div class="mb-2 text-primary" style="font-size: 2.5rem;">
                                <i class="bi bi-file-earmark-arrow-up"></i>
                            </div>
                            <h5 class="fw-bold text-dark mb-1 fs-6">Nhấp để chọn tệp hoặc kéo thả tệp vào đây</h5>
                            <p class="text-muted small mb-3">Hỗ trợ các định dạng bài giảng: <strong>.PDF, .DOCX, .PPTX</strong> (Tối đa 50MB)</p>
                            
                            <div class="d-flex justify-content-center gap-2 mb-2">
                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1 font-monospace small">PDF</span>
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1 font-monospace small">DOCX</span>
                                <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2 py-1 font-monospace small">PPTX</span>
                            </div>
                            
                            <div id="fileSelectedName" class="text-success fw-bold small mt-3 d-none">
                                <i class="bi bi-check-circle-fill me-1"></i> <span id="fileNameText"></span> (<span id="fileSizeText"></span>)
                            </div>
                        </div>

                        <input asp-for="Input.File" type="file" class="d-none" id="Input_File" accept=".pdf,.docx,.pptx"
                               onchange="handleFileSelect(this);" />
                        <span asp-validation-for="Input.File" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="alert alert-info d-flex align-items-center gap-2 small mb-4" role="alert" style="border-radius: var(--radius-md);">
                        <i class="bi bi-info-circle-fill text-primary fs-5 flex-shrink-0"></i>
                        <div>
                            Tài liệu sau khi tải lên sẽ được đưa vào hàng đợi xử lý ngầm (Background Worker) để trích xuất văn bản và tạo vector embeddings theo mô hình AI đang được cấu hình.
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-controller="Documents" asp-action="Index" asp-route-subjectId="@Model.SubjectId" class="btn btn-outline-secondary btn-press" style="border-radius: var(--radius-md);">Hủy bỏ</a>
                        <button type="submit" class="btn btn-primary btn-press px-4" style="background-color: var(--color-primary-600); border-color: var(--color-primary-600); border-radius: var(--radius-md); font-weight: 600;">
                            <i class="bi bi-cloud-arrow-up me-1"></i> Tải lên &amp; Tự động Index
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function handleFileSelect(input) {
            if (input.files && input.files[0]) {
                const file = input.files[0];
                const sizeMb = (file.size / (1024 * 1024)).toFixed(2);
                document.getElementById('fileNameText').innerText = file.name;
                document.getElementById('fileSizeText').innerText = sizeMb + ' MB';
                document.getElementById('fileSelectedName').classList.remove('d-none');
            }
        }

        // Drag and drop feedback
        const dropzone = document.getElementById('dropzoneBox');
        if (dropzone) {
            ['dragenter', 'dragover'].forEach(eventName => {
                dropzone.addEventListener(eventName, (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    dropzone.style.borderColor = 'var(--color-primary-600)';
                    dropzone.style.backgroundColor = '#eff6ff';
                }, false);
            });

            ['dragleave', 'drop'].forEach(eventName => {
                dropzone.addEventListener(eventName, (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    dropzone.style.borderColor = 'var(--color-border-warm)';
                    dropzone.style.backgroundColor = 'var(--color-bg-warm)';
                }, false);
            });

            dropzone.addEventListener('drop', (e) => {
                const dt = e.dataTransfer;
                const files = dt.files;
                const fileInput = document.getElementById('Input_File');
                if (files && files.length > 0 && fileInput) {
                    fileInput.files = files;
                    handleFileSelect(fileInput);
                }
            });
        }
    </script>
}
