@model DocumentUploadViewModel
@{
    ViewData["Title"] = $"Tải tài liệu - {Model.SubjectCode}";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="d-flex justify-content-between align-items-start mb-4">
            <div>
                <div class="small text-muted">@Model.SubjectCode</div>
                <h2 class="mb-1">Tải lên tài liệu</h2>
                <p class="text-muted mb-0">@Model.SubjectName</p>
            </div>
            <a asp-controller="Documents" asp-action="Index" asp-route-subjectId="@Model.SubjectId" class="btn btn-outline-secondary">Quay lại</a>
        </div>

        <div class="card shadow-sm">
            <div class="card-body">
                <form method="post" asp-controller="Documents" asp-action="Upload" enctype="multipart/form-data">
                    <input asp-for="SubjectId" type="hidden" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <div class="mb-3">
                        <label asp-for="Input.Title" class="form-label fw-bold"></label>
                        <input asp-for="Input.Title" class="form-control" />
                        <span asp-validation-for="Input.Title" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Input.ChapterId" class="form-label fw-bold"></label>
                        <div class="input-group">
                            <select asp-for="Input.ChapterId" asp-items="Model.ChapterOptions" class="form-select">
                                <option value="">-- Không gán chương --</option>
                            </select>
                            <a asp-controller="Chapters" asp-action="Create" asp-route-subjectId="@Model.SubjectId" class="btn btn-outline-secondary">+ Tạo chương</a>
                        </div>
                        <span asp-validation-for="Input.ChapterId" class="text-danger"></span>
                    </div>
                    <div class="mb-4">
                        <label asp-for="Input.File" class="form-label fw-bold"></label>
                        <input asp-for="Input.File" type="file" class="form-control" accept=".pdf,.docx,.pptx" />
                        <div class="form-text">PDF, DOCX, PPTX; tối đa 50 MB.</div>
                        <span asp-validation-for="Input.File" class="text-danger"></span>
                    </div>
                    <div class="d-flex justify-content-end gap-2">
                        <a asp-controller="Documents" asp-action="Index" asp-route-subjectId="@Model.SubjectId" class="btn btn-light">Hủy</a>
                        <button type="submit" class="btn btn-primary">Tải lên &amp; Index</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
