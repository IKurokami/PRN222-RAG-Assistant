@using PRN222.RagAssistant.Domain.Enums
@model DocumentIndexViewModel
@{
    ViewData["Title"] = $"Kho tài liệu - {Model.SubjectCode}";
    var hasActiveFilters = Model.SelectedChapterId.HasValue
        || Model.SelectedStatus.HasValue
        || !string.IsNullOrWhiteSpace(Model.SearchTerm);
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <div class="academic-breadcrumb mb-3">
        <a asp-page="/Index"><i class="bi bi-house-door"></i> Trang chủ</a>
        <span class="academic-breadcrumb-separator">/</span>
        <a asp-controller="Subjects" asp-action="Index">Môn học</a>
        <span class="academic-breadcrumb-separator">/</span>
        <span class="text-slate-800 fw-semibold">Tài liệu @Model.SubjectCode</span>
    </div>

    <!-- Header Section -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4 pb-2 border-bottom">
        <div>
            <div class="badge bg-primary-subtle text-primary border border-primary-subtle px-2.5 py-1 mb-1 font-monospace">@Model.SubjectCode — @Model.SubjectName</div>
            <h1 class="fw-bold fs-3 text-slate-900 mb-1">
                <i class="bi bi-folder2-open text-primary me-2"></i>Kho Giáo Trình &amp; Tài Liệu
            </h1>
            <p class="text-slate-500 mb-0">Quản lý và tra cứu các nguồn tài liệu học thuật môn @Model.SubjectCode phục vụ RAG.</p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a asp-controller="Subjects" asp-action="Index" class="btn btn-sm btn-academic-outline">
                <i class="bi bi-grid"></i> Danh mục môn học
            </a>
            @if (Model.CanManageDocuments)
            {
                <a asp-controller="Chapters" asp-action="Index" asp-route-subjectId="@Model.SubjectId" class="btn btn-sm btn-academic-outline">
                    <i class="bi bi-list-nested"></i> Chương
                </a>
                <a asp-page="/Reports/Index" asp-route-subjectId="@Model.SubjectId" class="btn btn-sm btn-academic-outline">
                    <i class="bi bi-bar-chart-line"></i> Báo cáo
                </a>
                <a asp-controller="Documents" asp-action="Upload" asp-route-subjectId="@Model.SubjectId" class="btn-academic-accent text-decoration-none">
                    <i class="bi bi-cloud-arrow-up-fill"></i> Tải lên tài liệu
                </a>
            }
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="alert alert-success d-flex align-items-center gap-2 alert-dismissible fade show shadow-xs mb-4" role="alert">
            <i class="bi bi-check-circle-fill text-success fs-5"></i>
            <div>@Model.StatusMessage</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Search and filters -->
    <div class="document-filter-panel mb-4">
        <form method="get" asp-controller="Documents" asp-action="Index">
            <input asp-for="SubjectId" type="hidden" />
            <div class="row g-3 align-items-end">
                <div class="col-lg-5">
                    <label asp-for="SearchTerm" class="document-filter-label">
                        <i class="bi bi-search"></i> Tìm kiếm tài liệu
                    </label>
                    <div class="document-search-box">
                        <i class="bi bi-search" aria-hidden="true"></i>
                        <input asp-for="SearchTerm"
                               class="form-control"
                               placeholder="Nhập tiêu đề hoặc tên file..."
                               autocomplete="off" />
                    </div>
                </div>
                <div class="col-md-6 col-lg-3">
                    <label asp-for="SelectedChapterId" class="document-filter-label">
                        <i class="bi bi-bookmarks"></i> Chương học
                    </label>
                    <select asp-for="SelectedChapterId" asp-items="Model.ChapterOptions" class="form-select">
                        <option value="">Tất cả chương học</option>
                    </select>
                </div>
                <div class="col-md-6 col-lg-2">
                    <label asp-for="SelectedStatus" class="document-filter-label">
                        <i class="bi bi-activity"></i> Trạng thái
                    </label>
                    <select asp-for="SelectedStatus" class="form-select">
                        <option value="">Tất cả trạng thái</option>
                        <option value="@DocumentIndexStatus.Uploaded">Chờ Index</option>
                        <option value="@DocumentIndexStatus.Processing">Đang xử lý</option>
                        <option value="@DocumentIndexStatus.Indexed">Đã Index</option>
                        <option value="@DocumentIndexStatus.Failed">Lỗi Index</option>
                    </select>
                </div>
                <div class="col-lg-2">
                    <button type="submit" class="btn-document-filter w-100">
                        <i class="bi bi-funnel-fill"></i> Áp dụng
                    </button>
                </div>
            </div>
        </form>

        <div class="document-filter-summary">
            <span>
                Hiển thị <strong>@Model.Documents.Count</strong> trong
                <strong>@Model.TotalDocumentCount</strong> tài liệu
            </span>
            @if (hasActiveFilters)
            {
                <a asp-controller="Documents" asp-action="Index" asp-route-subjectId="@Model.SubjectId">
                    <i class="bi bi-x-circle"></i> Xóa tất cả bộ lọc
                </a>
            }
        </div>
    </div>

    @if (Model.Documents.Count == 0)
    {
        <div class="academic-card text-center py-5">
            <div class="text-slate-400 mb-3">
                <i class="bi @(hasActiveFilters ? "bi-search" : "bi-file-earmark-x")" style="font-size: 3rem;"></i>
            </div>
            @if (hasActiveFilters)
            {
                <h5 class="fw-bold text-slate-700">Không tìm thấy tài liệu phù hợp</h5>
                <p class="text-slate-500 small max-w-md mx-auto mb-3">
                    Thử thay đổi từ khóa, chương học hoặc trạng thái Index.
                </p>
                <a asp-controller="Documents" asp-action="Index" asp-route-subjectId="@Model.SubjectId" class="btn btn-academic-outline">
                    <i class="bi bi-arrow-counterclockwise"></i> Đặt lại bộ lọc
                </a>
            }
            else
            {
                <h5 class="fw-bold text-slate-700">Chưa có tài liệu nào trong môn học này</h5>
                <p class="text-slate-500 small max-w-md mx-auto mb-3">
                    Các tài liệu sau khi tải lên sẽ được hệ thống trích xuất văn bản và tạo vector nhúng tự động.
                </p>
                @if (Model.CanManageDocuments)
                {
                    <a asp-controller="Documents" asp-action="Upload" asp-route-subjectId="@Model.SubjectId" class="btn-academic-primary text-decoration-none">
                        <i class="bi bi-cloud-arrow-up"></i> Tải lên tài liệu ngay
                    </a>
                }
            }
        </div>
    }
    else
    {
        <div class="academic-card p-0 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-academic align-middle mb-0">
                    <thead>
                        <tr>
                            <th scope="col" style="min-width: 320px;">Tài liệu / Định dạng</th>
                            <th scope="col">Chương học</th>
                            <th scope="col">Dung lượng</th>
                            <th scope="col">Trạng thái Index AI</th>
                            <th scope="col">Thời điểm tải lên</th>
                            <th scope="col" class="text-end pe-4">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var doc in Model.Documents)
                        {
                            var ext = System.IO.Path.GetExtension(doc.OriginalFileName).ToLowerInvariant();
                            var badgeClass = ext switch
                            {
                                ".pdf" => "file-badge-pdf",
                                ".docx" => "file-badge-docx",
                                ".pptx" => "file-badge-pptx",
                                _ => "file-badge-docx"
                            };
                            var extLabel = ext switch
                            {
                                ".pdf" => "PDF",
                                ".docx" => "DOCX",
                                ".pptx" => "PPTX",
                                _ => "FILE"
                            };

                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="file-badge-icon @badgeClass flex-shrink-0">
                                            @extLabel
                                        </div>
                                        <div>
                                            <a asp-controller="Documents" asp-action="Details" asp-route-id="@doc.Id" class="fw-bold text-slate-900 text-decoration-none d-block">
                                                @doc.Title
                                            </a>
                                            <span class="font-monospace small text-slate-500">@doc.OriginalFileName</span>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    @if (doc.ChapterNumber.HasValue)
                                    {
                                        <span class="chapter-badge" title="@doc.ChapterTitle">
                                            <i class="bi bi-bookmark-fill"></i>
                                            Chương @doc.ChapterNumber
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="chapter-badge chapter-badge-unassigned">
                                            <i class="bi bi-inboxes"></i> Chưa gán chương
                                        </span>
                                    }
                                </td>
                                <td class="font-monospace small text-slate-600">@doc.FormattedSize</td>
                                <td>
                                    @switch (doc.IndexStatus)
                                    {
                                        case DocumentIndexStatus.Uploaded:
                                            <span class="status-pill status-uploaded">
                                                <i class="bi bi-clock-history"></i> Chờ Index
                                            </span>
                                            break;
                                        case DocumentIndexStatus.Processing:
                                            <span class="status-pill status-processing">
                                                <i class="bi bi-arrow-repeat spin"></i> Đang xử lý AI...
                                            </span>
                                            break;
                                        case DocumentIndexStatus.Indexed:
                                            <span class="status-pill status-indexed">
                                                Đã Index (Sẵn sàng)
                                            </span>
                                            break;
                                        case DocumentIndexStatus.Failed:
                                            <span class="status-pill status-failed" title="@doc.IndexError">
                                                <i class="bi bi-exclamation-triangle"></i> Lỗi Index
                                            </span>
                                            break;
                                    }
                                </td>
                                <td class="small text-slate-500">
                                    @doc.UploadedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-flex gap-2 justify-content-end align-items-center flex-nowrap">
                                        <a asp-controller="Documents" asp-action="Details" asp-route-id="@doc.Id"
                                           class="btn btn-sm btn-academic-outline"
                                           title="Xem chi tiết">
                                            <i class="bi bi-eye"></i> Chi tiết
                                        </a>

                                        @if (Model.CanManageDocuments)
                                        {
                                            <form method="post" asp-controller="Documents" asp-action="Reindex"
                                                  asp-route-id="@doc.Id"
                                                  asp-route-selectedChapterId="@Model.SelectedChapterId"
                                                  asp-route-searchTerm="@Model.SearchTerm"
                                                  asp-route-selectedStatus="@Model.SelectedStatus"
                                                  class="m-0"
                                                  onsubmit="return confirm('Yêu cầu index lại tài liệu này?');">
                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-warning text-dark d-inline-flex align-items-center gap-1"
                                                        title="Index lại">
                                                    <i class="bi bi-arrow-clockwise"></i> Re-index
                                                </button>
                                            </form>

                                            <form method="post" asp-controller="Documents" asp-action="Delete"
                                                  asp-route-id="@doc.Id"
                                                  asp-route-selectedChapterId="@Model.SelectedChapterId"
                                                  asp-route-searchTerm="@Model.SearchTerm"
                                                  asp-route-selectedStatus="@Model.SelectedStatus"
                                                  class="m-0"
                                                  onsubmit="return confirm('Xóa tài liệu này? Thao tác không thể hoàn tác.');">
                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger d-inline-flex align-items-center gap-1"
                                                        title="Xóa tài liệu">
                                                    <i class="bi bi-trash"></i> Xóa
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
