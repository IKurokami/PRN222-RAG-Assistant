@using PRN222.RagAssistant.Domain.Enums
@model DocumentIndexViewModel
@{
    ViewData["Title"] = $"Tài liệu - {Model.SubjectCode}";
}

<div class="d-flex justify-content-between align-items-start mb-4 gap-3 flex-wrap">
    <div>
        <div class="small text-muted mb-1">@Model.SubjectCode</div>
        <h2 class="mb-1">@Model.SubjectName</h2>
        <p class="text-muted mb-0">Tài liệu nguồn dùng cho RAG của riêng môn học này.</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a asp-controller="Subjects" asp-action="Index" class="btn btn-outline-secondary">Môn học</a>
        @if (Model.CanManageDocuments)
        {
            <a asp-controller="Chapters" asp-action="Index" asp-route-subjectId="@Model.SubjectId" class="btn btn-outline-secondary">Chương</a>
            <a asp-page="/Reports/Index" asp-route-subjectId="@Model.SubjectId" class="btn btn-outline-secondary">Báo cáo</a>
            <a asp-controller="Documents" asp-action="Upload" asp-route-subjectId="@Model.SubjectId" class="btn btn-primary">Tải lên tài liệu</a>
        }
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @Model.StatusMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card mb-4 shadow-sm">
    <div class="card-body">
        <form method="get" asp-controller="Documents" asp-action="Index" class="row g-3 align-items-end">
            <input asp-for="SubjectId" type="hidden" />
            <div class="col-md-6 col-lg-4">
                <label asp-for="SelectedChapterId" class="form-label mb-1 fw-bold">Lọc theo chương:</label>
                <select asp-for="SelectedChapterId" asp-items="Model.ChapterOptions" class="form-select" onchange="this.form.submit()">
                    <option value="">-- Tất cả các chương --</option>
                </select>
            </div>
            @if (Model.SelectedChapterId.HasValue)
            {
                <div class="col-md-auto">
                    <a asp-controller="Documents" asp-action="Index" asp-route-subjectId="@Model.SubjectId" class="btn btn-outline-secondary">Xóa bộ lọc</a>
                </div>
            }
        </form>
    </div>
</div>

@if (Model.Documents.Count == 0)
{
    <div class="text-center py-5 border rounded bg-light">
        <h5 class="text-muted">Chưa có tài liệu</h5>
        <p class="text-muted">Tài liệu của @Model.SubjectCode sẽ hiển thị tại đây.</p>
        @if (Model.CanManageDocuments)
        {
            <a asp-controller="Documents" asp-action="Upload" asp-route-subjectId="@Model.SubjectId" class="btn btn-primary">Tải tài liệu đầu tiên</a>
        }
    </div>
}
else
{
    <div class="table-responsive shadow-sm rounded">
        <table class="table table-hover align-middle mb-0 bg-white border">
            <thead class="table-light">
                <tr>
                    <th>Tên tài liệu</th>
                    <th>Chương</th>
                    <th>Kích thước</th>
                    <th>Trạng thái Index</th>
                    <th>Ngày tải lên</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var doc in Model.Documents)
                {
                    <tr>
                        <td>
                            <a asp-controller="Documents" asp-action="Details" asp-route-id="@doc.Id" class="fw-bold text-decoration-none text-dark">@doc.Title</a>
                            <div class="small text-muted">@doc.OriginalFileName</div>
                        </td>
                        <td>
                            @if (doc.ChapterNumber.HasValue)
                            {
                                <span class="badge bg-info text-dark">Chương @doc.ChapterNumber</span>
                            }
                            else
                            {
                                <span class="text-muted small">Chung</span>
                            }
                        </td>
                        <td class="small">@doc.FormattedSize</td>
                        <td>
                            @switch (doc.IndexStatus)
                            {
                                case DocumentIndexStatus.Uploaded: <span class="badge bg-secondary">Vừa tải lên</span> break;
                                case DocumentIndexStatus.Processing: <span class="badge bg-primary">Đang xử lý</span> break;
                                case DocumentIndexStatus.Indexed: <span class="badge bg-success">Đã Index</span> break;
                                case DocumentIndexStatus.Failed: <span class="badge bg-danger" title="@doc.IndexError">Thất bại</span> break;
                            }
                        </td>
                        <td class="small text-muted">@doc.UploadedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="text-end">
                            <div class="d-flex gap-2 justify-content-end flex-wrap">
                                <a asp-controller="Documents" asp-action="Details" asp-route-id="@doc.Id" class="btn btn-sm btn-outline-primary">Chi tiết</a>
                                @if (Model.CanManageDocuments)
                                {
                                    <form method="post" asp-controller="Documents" asp-action="Reindex" asp-route-id="@doc.Id" asp-route-selectedChapterId="@Model.SelectedChapterId" onsubmit="return confirm('Yêu cầu index lại tài liệu này?');">
                                        <button type="submit" class="btn btn-sm btn-outline-warning">Re-index</button>
                                    </form>
                                    <form method="post" asp-controller="Documents" asp-action="Delete" asp-route-id="@doc.Id" asp-route-selectedChapterId="@Model.SelectedChapterId" onsubmit="return confirm('Xóa tài liệu này?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Xóa</button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
