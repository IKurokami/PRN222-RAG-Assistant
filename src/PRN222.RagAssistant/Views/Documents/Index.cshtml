@using PRN222.RagAssistant.Domain.Enums
@model DocumentIndexViewModel
@{
    ViewData["Title"] = $"Kho tài liệu - {Model.SubjectCode}";
    var hasActiveFilters = Model.SelectedChapterId.HasValue
        || Model.SelectedStatus.HasValue
        || !string.IsNullOrWhiteSpace(Model.SearchTerm);
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <div class="academic-breadcrumb mb-3">
        <a asp-page="/Index"><i class="bi bi-house-door"></i> Trang chủ</a>
        <span class="academic-breadcrumb-separator">/</span>
        <a asp-controller="Subjects" asp-action="Index">Môn học</a>
        <span class="academic-breadcrumb-separator">/</span>
        <span class="fw-semibold">Tài liệu @Model.SubjectCode</span>
    </div>

    <!-- Header Section -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4 pb-2 border-bottom">
        <div>
            <div class="badge bg-primary-subtle text-primary border border-primary-subtle px-2.5 py-1 mb-1 font-monospace rounded-pill">@Model.SubjectCode — @Model.SubjectName</div>
            <h1 class="fw-bold fs-3 text-dark mb-1">
                <i class="bi bi-folder2-open text-primary me-2"></i>Kho Giáo Trình &amp; Tài Liệu
            </h1>
            <p class="text-muted small mb-0">Quản lý và tra cứu các nguồn tài liệu học thuật môn @Model.SubjectCode phục vụ RAG.</p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a asp-controller="Subjects" asp-action="Index" class="btn btn-sm btn-outline-secondary btn-press d-inline-flex align-items-center gap-1" style="border-radius: var(--radius-md); font-size: 0.85rem; font-weight: 600;">
                <i class="bi bi-grid"></i> Danh mục môn học
            </a>
            @if (Model.CanManageDocuments)
            {
                <a asp-controller="Chapters" asp-action="Index" asp-route-subjectId="@Model.SubjectId" class="btn btn-sm btn-outline-secondary btn-press d-inline-flex align-items-center gap-1" style="border-radius: var(--radius-md); font-size: 0.85rem; font-weight: 600;">
                    <i class="bi bi-list-nested"></i> Chương
                </a>
                <a asp-page="/Reports/Index" asp-route-subjectId="@Model.SubjectId" class="btn btn-sm btn-outline-secondary btn-press d-inline-flex align-items-center gap-1" style="border-radius: var(--radius-md); font-size: 0.85rem; font-weight: 600;">
                    <i class="bi bi-bar-chart-line"></i> Báo cáo
                </a>
                <a asp-controller="Documents" asp-action="Upload" asp-route-subjectId="@Model.SubjectId" class="btn btn-sm btn-primary btn-press d-inline-flex align-items-center gap-1" style="background-color: var(--color-primary-600); border-color: var(--color-primary-600); border-radius: var(--radius-md); font-size: 0.85rem; font-weight: 600;">
                    <i class="bi bi-cloud-arrow-up-fill"></i> Tải lên tài liệu
                </a>
            }
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="alert alert-success d-flex align-items-center gap-2 alert-dismissible fade show shadow-xs mb-4" role="alert" style="border-radius: var(--radius-md);">
            <i class="bi bi-check-circle-fill text-success fs-5"></i>
            <div>@Model.StatusMessage</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Search and filters -->
    <div class="document-filter-panel mb-4 p-3 bg-white border rounded-4 shadow-sm">
        <form method="get" asp-controller="Documents" asp-action="Index">
            <input asp-for="SubjectId" type="hidden" />
            <div class="row g-3 align-items-end">
                <div class="col-lg-5">
                    <label asp-for="SearchTerm" class="form-label fw-semibold small text-muted mb-1">
                        <i class="bi bi-search"></i> Tìm kiếm tài liệu
                    </label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0" style="border-color: var(--color-border-warm);"><i class="bi bi-search text-muted"></i></span>
                        <input asp-for="SearchTerm"
                               class="form-control border-start-0 input-focus-glow"
                               placeholder="Nhập tiêu đề hoặc tên file..."
                               autocomplete="off"
                               style="border-color: var(--color-border-warm);" />
                    </div>
                </div>
                <div class="col-md-6 col-lg-3">
                    <label asp-for="SelectedChapterId" class="form-label fw-semibold small text-muted mb-1">
                        <i class="bi bi-bookmarks"></i> Chương học
                    </label>
                    <select asp-for="SelectedChapterId" asp-items="Model.ChapterOptions" class="form-select input-focus-glow" style="border-color: var(--color-border-warm);">
                        <option value="">Tất cả chương học</option>
                    </select>
                </div>
                <div class="col-md-6 col-lg-2">
                    <label asp-for="SelectedStatus" class="form-label fw-semibold small text-muted mb-1">
                        <i class="bi bi-activity"></i> Trạng thái
                    </label>
                    <select asp-for="SelectedStatus" class="form-select input-focus-glow" style="border-color: var(--color-border-warm);">
                        <option value="">Tất cả trạng thái</option>
                        <option value="@DocumentIndexStatus.Uploaded">Chờ Index</option>
                        <option value="@DocumentIndexStatus.Processing">Đang xử lý</option>
                        <option value="@DocumentIndexStatus.Indexed">Đã Index</option>
                        <option value="@DocumentIndexStatus.Failed">Lỗi Index</option>
                    </select>
                </div>
                <div class="col-lg-2">
                    <button type="submit" class="btn btn-dark w-100 btn-press" style="background-color: var(--color-btn-dark); border-radius: var(--radius-md); font-weight: 600;">
                        <i class="bi bi-funnel-fill me-1"></i> Lọc
                    </button>
                </div>
            </div>
        </form>

        <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top text-muted small">
            <span>
                Hiển thị <strong>@Model.Documents.Count</strong> trong
                <strong>@Model.TotalDocumentCount</strong> tài liệu
            </span>
            @if (hasActiveFilters)
            {
                <a asp-controller="Documents" asp-action="Index" asp-route-subjectId="@Model.SubjectId" class="text-decoration-none" style="color: var(--color-primary-600);">
                    <i class="bi bi-x-circle"></i> Xóa tất cả bộ lọc
                </a>
            }
        </div>
    </div>

    @if (Model.Documents.Count == 0)
    {
        <div class="academic-card text-center py-5 bg-white border rounded-4 shadow-sm p-4">
            <div class="text-muted mb-3">
                <i class="bi @(hasActiveFilters ? "bi-search" : "bi-file-earmark-x")" style="font-size: 3rem;"></i>
            </div>
            @if (hasActiveFilters)
            {
                <h5 class="fw-bold text-dark">Không tìm thấy tài liệu phù hợp</h5>
                <p class="text-muted small mx-auto mb-3" style="max-width: 400px;">
                    Thử thay đổi từ khóa, chương học hoặc trạng thái Index.
                </p>
                <a asp-controller="Documents" asp-action="Index" asp-route-subjectId="@Model.SubjectId" class="btn btn-sm btn-outline-secondary btn-press">
                    <i class="bi bi-arrow-counterclockwise"></i> Đặt lại bộ lọc
                </a>
            }
            else
            {
                <h5 class="fw-bold text-dark">Chưa có tài liệu nào trong môn học này</h5>
                <p class="text-muted small mx-auto mb-3" style="max-width: 400px;">
                    Các tài liệu sau khi tải lên sẽ được hệ thống trích xuất văn bản và tạo vector nhúng tự động.
                </p>
                @if (Model.CanManageDocuments)
                {
                    <a asp-controller="Documents" asp-action="Upload" asp-route-subjectId="@Model.SubjectId" class="btn btn-sm btn-primary btn-press text-decoration-none">
                        <i class="bi bi-cloud-arrow-up"></i> Tải lên tài liệu ngay
                    </a>
                }
            }
        </div>
    }
    else
    {
        <div class="academic-card card-lift p-0 overflow-hidden shadow-sm border bg-white rounded-4">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="bg-light text-muted small text-uppercase" style="letter-spacing: 0.05em; border-bottom: 1px solid var(--color-border-warm);">
                        <tr>
                            <th scope="col" class="ps-4 py-3" style="min-width: 320px;">Tài liệu / Định dạng</th>
                            <th scope="col" class="py-3">Chương học</th>
                            <th scope="col" class="py-3">Dung lượng</th>
                            <th scope="col" class="py-3">Trạng thái Index AI</th>
                            <th scope="col" class="py-3">Thời điểm tải lên</th>
                            <th scope="col" class="text-end pe-4 py-3">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < Model.Documents.Count; i++)
                        {
                            var doc = Model.Documents[i];
                            var ext = System.IO.Path.GetExtension(doc.OriginalFileName).ToLowerInvariant();
                            var badgeClass = ext switch
                            {
                                ".pdf" => "bg-danger-subtle text-danger border-danger-subtle",
                                ".docx" => "bg-primary-subtle text-primary border-primary-subtle",
                                ".pptx" => "bg-warning-subtle text-warning border-warning-subtle",
                                _ => "bg-secondary-subtle text-secondary"
                            };
                            var extLabel = ext switch
                            {
                                ".pdf" => "PDF",
                                ".docx" => "DOCX",
                                ".pptx" => "PPTX",
                                _ => "FILE"
                            };

                            <tr class="stagger-row" style="animation-delay: @(i * 35)ms; border-bottom: 1px solid var(--color-border-subtle);">
                                <td class="ps-4 py-3">
                                    <div class="d-flex align-items-center gap-3">
                                        <span class="badge border px-2 py-1.5 font-monospace fw-bold small @badgeClass" style="border-radius: var(--radius-sm); font-size: 0.75rem;">
                                            @extLabel
                                        </span>
                                        <div>
                                            <a asp-controller="Documents" asp-action="Details" asp-route-id="@doc.Id" class="fw-bold text-dark text-decoration-none d-block">
                                                @doc.Title
                                            </a>
                                            <span class="font-monospace small text-muted" style="cursor: pointer;" data-copy="@doc.OriginalFileName" data-copy-label="Đã sao chép tên file @doc.OriginalFileName" title="Bấm để sao chép tên file">
                                                @doc.OriginalFileName <i class="bi bi-copy text-muted ms-1" style="font-size: 0.7rem;"></i>
                                            </span>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    @if (doc.ChapterNumber.HasValue)
                                    {
                                        <span class="badge bg-light text-dark border px-2.5 py-1 rounded-pill small" title="@doc.ChapterTitle">
                                            <i class="bi bi-bookmark-fill text-primary me-1"></i> Chương @doc.ChapterNumber
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-muted border px-2.5 py-1 rounded-pill small">
                                            <i class="bi bi-inboxes me-1"></i> Chưa gán
                                        </span>
                                    }
                                </td>
                                <td class="font-monospace small text-muted">@doc.FormattedSize</td>
                                <td>
                                    @switch (doc.IndexStatus)
                                    {
                                        case DocumentIndexStatus.Uploaded:
                                            <span class="badge bg-secondary-subtle text-secondary border px-2 py-1 rounded-pill small">
                                                <i class="bi bi-clock-history me-1"></i> Chờ Index
                                            </span>
                                            break;
                                        case DocumentIndexStatus.Processing:
                                            <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2 py-1 rounded-pill small">
                                                <i class="bi bi-arrow-repeat spin me-1"></i> Đang xử lý AI...
                                            </span>
                                            break;
                                        case DocumentIndexStatus.Indexed:
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 rounded-pill small">
                                                <span class="pulse-badge-dot d-inline-block me-1" style="width: 6px; height: 6px;"></span>
                                                Đã Index (Sẵn sàng)
                                            </span>
                                            break;
                                        case DocumentIndexStatus.Failed:
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1 rounded-pill small" title="@doc.IndexError">
                                                <i class="bi bi-exclamation-triangle me-1"></i> Lỗi Index
                                            </span>
                                            break;
                                    }
                                </td>
                                <td class="small text-muted font-monospace">
                                    @doc.UploadedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-flex gap-1 justify-content-end align-items-center flex-nowrap">
                                        <a asp-controller="Documents" asp-action="Details" asp-route-id="@doc.Id"
                                           class="btn btn-sm btn-outline-secondary btn-press d-inline-flex align-items-center gap-1"
                                           style="border-radius: var(--radius-sm); font-size: 0.8rem; font-weight: 500;"
                                           title="Xem chi tiết">
                                            <i class="bi bi-eye"></i> Chi tiết
                                        </a>

                                        @if (Model.CanManageDocuments)
                                        {
                                            <form method="post" asp-controller="Documents" asp-action="Reindex"
                                                  asp-route-id="@doc.Id"
                                                  asp-route-selectedChapterId="@Model.SelectedChapterId"
                                                  asp-route-searchTerm="@Model.SearchTerm"
                                                  asp-route-selectedStatus="@Model.SelectedStatus"
                                                  class="m-0"
                                                  onsubmit="return confirm('Yêu cầu index lại tài liệu này?');">
                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-warning text-dark btn-press d-inline-flex align-items-center gap-1"
                                                        style="border-radius: var(--radius-sm); font-size: 0.8rem; font-weight: 500;"
                                                        title="Index lại">
                                                    <i class="bi bi-arrow-clockwise"></i> Re-index
                                                </button>
                                            </form>

                                            <form method="post" asp-controller="Documents" asp-action="Delete"
                                                  asp-route-id="@doc.Id"
                                                  asp-route-selectedChapterId="@Model.SelectedChapterId"
                                                  asp-route-searchTerm="@Model.SearchTerm"
                                                  asp-route-selectedStatus="@Model.SelectedStatus"
                                                  class="m-0"
                                                  onsubmit="return confirm('Xóa tài liệu này? Thao tác không thể hoàn tác.');">
                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger btn-press d-inline-flex align-items-center gap-1"
                                                        style="border-radius: var(--radius-sm); font-size: 0.8rem; font-weight: 500;"
                                                        title="Xóa tài liệu">
                                                    <i class="bi bi-trash"></i> Xóa
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
