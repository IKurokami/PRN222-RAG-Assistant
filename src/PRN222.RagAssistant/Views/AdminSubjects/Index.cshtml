@model AdminSubjectIndexViewModel
@{
    ViewData["Title"] = "Quản Lý Môn Học - Admin";
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <div class="academic-breadcrumb mb-3">
        <a asp-page="/Index"><i class="bi bi-house-door"></i> Trang chủ</a>
        <span class="academic-breadcrumb-separator">/</span>
        <span class="fw-semibold">Quản trị môn học</span>
    </div>

    <!-- Header Section -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4 pb-2 border-bottom">
        <div>
            <h1 class="fw-bold fs-3 text-dark mb-1">
                <i class="bi bi-gear-fill text-primary me-2"></i>Quản Lý Môn Học (Admin)
            </h1>
            <p class="text-muted small mb-0">Khởi tạo môn học mới, điều chỉnh trạng thái kích hoạt và phân công Trưởng môn (Subject Leader).</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Subjects" asp-action="Index" class="btn btn-sm btn-outline-secondary btn-press d-inline-flex align-items-center gap-1" style="border-radius: var(--radius-md); font-size: 0.85rem; font-weight: 600;">
                <i class="bi bi-grid"></i> Danh mục môn học
            </a>
            <a asp-controller="AdminSubjects" asp-action="Create" class="btn btn-sm btn-primary btn-press d-inline-flex align-items-center gap-1" style="background-color: var(--color-primary-600); border-color: var(--color-primary-600); border-radius: var(--radius-md); font-size: 0.85rem; font-weight: 600;">
                <i class="bi bi-plus-circle-fill"></i> Thêm môn học mới
            </a>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="alert alert-success d-flex align-items-center gap-2 alert-dismissible fade show shadow-xs mb-4" role="alert" style="border-radius: var(--radius-md);">
            <i class="bi bi-check-circle-fill text-success fs-5"></i>
            <div>@Model.StatusMessage</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="academic-card card-lift p-0 overflow-hidden shadow-sm border bg-white rounded-4">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="bg-light text-muted small text-uppercase" style="letter-spacing: 0.05em; border-bottom: 1px solid var(--color-border-warm);">
                    <tr>
                        <th scope="col" class="ps-4 py-3" style="min-width: 200px;">Mã &amp; Tên môn học</th>
                        <th scope="col" class="py-3" style="width: 140px;">Trạng thái</th>
                        <th scope="col" class="py-3" style="min-width: 220px;">Trưởng môn phụ trách</th>
                        <th scope="col" class="text-center py-3" style="width: 110px;">Chương</th>
                        <th scope="col" class="text-center py-3" style="width: 110px;">Tài liệu</th>
                        <th scope="col" class="text-end pe-4 py-3" style="width: 240px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < Model.Subjects.Count; i++)
                    {
                        var subject = Model.Subjects[i];
                        <tr class="stagger-row" style="animation-delay: @(i * 40)ms; border-bottom: 1px solid var(--color-border-subtle);">
                            <td class="ps-4 py-3">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="fw-bold text-dark font-monospace" style="cursor: pointer;" data-copy="@subject.Code" data-copy-label="Đã sao chép mã @subject.Code" title="Bấm để sao chép mã môn">
                                        @subject.Code <i class="bi bi-copy text-muted small ms-1" style="font-size: 0.75rem;"></i>
                                    </span>
                                </div>
                                <div class="small text-muted">@subject.Name</div>
                            </td>
                            <td>
                                @if (subject.IsActive)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 rounded-pill small">
                                        <span class="pulse-badge-dot d-inline-block me-1" style="width: 6px; height: 6px;"></span>
                                        Hoạt động
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1 rounded-pill small">
                                        Tạm dừng
                                    </span>
                                }
                            </td>
                            <td>
                                @if (subject.SubjectLeaderNames.Count == 0)
                                {
                                    <span class="text-muted fst-italic small">Chưa phân công</span>
                                }
                                else
                                {
                                    <div class="d-flex flex-wrap gap-1">
                                        @foreach (var leader in subject.SubjectLeaderNames)
                                        {
                                            <span class="badge bg-light text-dark border px-2 py-1 small rounded-pill">
                                                <i class="bi bi-person-fill text-primary me-1"></i>@leader
                                            </span>
                                        }
                                    </div>
                                }
                            </td>
                            <td class="text-center fw-semibold text-dark">@subject.ChapterCount</td>
                            <td class="text-center fw-semibold text-dark">@subject.DocumentCount</td>
                            <td class="text-end pe-4">
                                <div class="d-flex gap-1 justify-content-end align-items-center flex-nowrap">
                                    <a asp-controller="Documents" asp-action="Index" asp-route-subjectId="@subject.Id" class="btn btn-sm btn-outline-primary btn-press d-inline-flex align-items-center gap-1" style="border-radius: var(--radius-sm); font-size: 0.8rem; font-weight: 500;" title="Mở môn học">
                                        <i class="bi bi-folder2-open"></i> Mở
                                    </a>
                                    <a asp-controller="AdminSubjects" asp-action="Leaders" asp-route-id="@subject.Id" class="btn btn-sm btn-outline-secondary btn-press d-inline-flex align-items-center gap-1" style="border-radius: var(--radius-sm); font-size: 0.8rem; font-weight: 500;" title="Phân công Trưởng môn">
                                        <i class="bi bi-person-gear"></i> Leader
                                    </a>
                                    <a asp-controller="AdminSubjects" asp-action="Edit" asp-route-id="@subject.Id" class="btn btn-sm btn-outline-secondary btn-press d-inline-flex align-items-center gap-1" style="border-radius: var(--radius-sm); font-size: 0.8rem; font-weight: 500;" title="Chỉnh sửa môn học">
                                        <i class="bi bi-pencil"></i> Sửa
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
