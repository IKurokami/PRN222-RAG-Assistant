@model AdminSubjectIndexViewModel
@{
    ViewData["Title"] = "Quản lý môn học";
}

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <h2 class="mb-1">Quản lý môn học</h2>
        <p class="text-muted mb-0">Admin tạo môn, bật/tắt môn và phân công Subject Leader.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Subjects" asp-action="Index" class="btn btn-outline-secondary">Danh sách môn</a>
        <a asp-controller="AdminSubjects" asp-action="Create" class="btn btn-primary">Tạo môn học</a>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @Model.StatusMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="table-responsive shadow-sm rounded">
    <table class="table table-hover align-middle mb-0 bg-white border">
        <thead class="table-light">
            <tr>
                <th>Môn học</th>
                <th>Trạng thái</th>
                <th>Subject Leader</th>
                <th class="text-center">Chương</th>
                <th class="text-center">Tài liệu</th>
                <th class="text-end">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var subject in Model.Subjects)
            {
                <tr>
                    <td>
                        <div class="fw-bold">@subject.Code</div>
                        <div class="small text-muted">@subject.Name</div>
                    </td>
                    <td>
                        @if (subject.IsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactive</span>
                        }
                    </td>
                    <td>
                        @if (subject.SubjectLeaderNames.Count == 0)
                        {
                            <span class="text-muted small">Chưa phân công</span>
                        }
                        else
                        {
                            @string.Join(", ", subject.SubjectLeaderNames)
                        }
                    </td>
                    <td class="text-center">@subject.ChapterCount</td>
                    <td class="text-center">@subject.DocumentCount</td>
                    <td class="text-end">
                        <div class="d-flex gap-2 justify-content-end flex-wrap">
                            <a asp-controller="Documents" asp-action="Index" asp-route-subjectId="@subject.Id" class="btn btn-sm btn-outline-primary">Mở</a>
                            <a asp-controller="AdminSubjects" asp-action="Leaders" asp-route-id="@subject.Id" class="btn btn-sm btn-outline-secondary">Phân Leader</a>
                            <a asp-controller="AdminSubjects" asp-action="Edit" asp-route-id="@subject.Id" class="btn btn-sm btn-outline-secondary">Sửa</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
