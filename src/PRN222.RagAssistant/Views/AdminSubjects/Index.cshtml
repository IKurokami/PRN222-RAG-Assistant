@model AdminSubjectIndexViewModel
@{
    ViewData["Title"] = "Quản Lý Môn Học - Admin";
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <div class="academic-breadcrumb mb-3">
        <a asp-page="/Index"><i class="bi bi-house-door"></i> Trang chủ</a>
        <span class="academic-breadcrumb-separator">/</span>
        <span class="text-slate-800 fw-semibold">Quản trị môn học</span>
    </div>

    <!-- Header Section -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4 pb-2 border-bottom">
        <div>
            <h1 class="fw-bold fs-3 text-slate-900 mb-1">
                <i class="bi bi-gear-fill text-primary me-2"></i>Quản Lý Môn Học (Admin)
            </h1>
            <p class="text-slate-500 mb-0">Khởi tạo môn học mới, điều chỉnh trạng thái kích hoạt và phân công Trưởng môn (Subject Leader).</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Subjects" asp-action="Index" class="btn btn-sm btn-academic-outline">
                <i class="bi bi-grid"></i> Danh mục môn học
            </a>
            <a asp-controller="AdminSubjects" asp-action="Create" class="btn-academic-accent text-decoration-none">
                <i class="bi bi-plus-circle-fill"></i> Thêm môn học mới
            </a>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="alert alert-success d-flex align-items-center gap-2 alert-dismissible fade show shadow-xs mb-4" role="alert">
            <i class="bi bi-check-circle-fill text-success fs-5"></i>
            <div>@Model.StatusMessage</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="academic-card p-0 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-academic align-middle mb-0">
                <thead>
                    <tr>
                        <th scope="col" style="min-width: 200px;">Mã &amp; Tên môn học</th>
                        <th scope="col" style="width: 140px;">Trạng thái</th>
                        <th scope="col" style="min-width: 220px;">Trưởng môn phụ trách</th>
                        <th scope="col" class="text-center" style="width: 110px;">Chương</th>
                        <th scope="col" class="text-center" style="width: 110px;">Tài liệu</th>
                        <th scope="col" class="text-end pe-4" style="width: 240px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var subject in Model.Subjects)
                    {
                        <tr>
                            <td>
                                <div class="fw-bold text-slate-900 fs-6 font-monospace">@subject.Code</div>
                                <div class="small text-slate-500">@subject.Name</div>
                            </td>
                            <td>
                                @if (subject.IsActive)
                                {
                                    <span class="status-pill status-indexed">Hoạt động</span>
                                }
                                else
                                {
                                    <span class="status-pill status-failed">Tạm dừng</span>
                                }
                            </td>
                            <td>
                                @if (subject.SubjectLeaderNames.Count == 0)
                                {
                                    <span class="text-slate-400 fst-italic small">Chưa phân công</span>
                                }
                                else
                                {
                                    <div class="d-flex flex-wrap gap-1">
                                        @foreach (var leader in subject.SubjectLeaderNames)
                                        {
                                            <span class="badge bg-light text-slate-800 border px-2 py-1 small">
                                                <i class="bi bi-person-fill text-primary me-1"></i>@leader
                                            </span>
                                        }
                                    </div>
                                }
                            </td>
                            <td class="text-center fw-semibold text-slate-700">@subject.ChapterCount</td>
                            <td class="text-center fw-semibold text-slate-700">@subject.DocumentCount</td>
                            <td class="text-end pe-4">
                                <div class="d-flex gap-2 justify-content-end align-items-center flex-nowrap">
                                    <a asp-controller="Documents" asp-action="Index" asp-route-subjectId="@subject.Id" class="btn btn-sm btn-academic-primary" title="Mở môn học">
                                        <i class="bi bi-folder2-open"></i> Mở
                                    </a>
                                    <a asp-controller="AdminSubjects" asp-action="Leaders" asp-route-id="@subject.Id" class="btn btn-sm btn-academic-outline" title="Phân công Trưởng môn">
                                        <i class="bi bi-person-gear"></i> Phân Leader
                                    </a>
                                    <a asp-controller="AdminSubjects" asp-action="Edit" asp-route-id="@subject.Id" class="btn btn-sm btn-academic-outline" title="Chỉnh sửa môn học">
                                        <i class="bi bi-pencil"></i> Sửa
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
