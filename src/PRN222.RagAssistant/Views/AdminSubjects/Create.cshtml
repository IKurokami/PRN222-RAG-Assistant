@model AdminSubjectFormViewModel
@{
    ViewData["Title"] = "Tạo Môn Học Mới - Admin";
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <div class="academic-breadcrumb mb-3">
        <a asp-page="/Index"><i class="bi bi-house-door"></i> Trang chủ</a>
        <span class="academic-breadcrumb-separator">/</span>
        <a asp-controller="AdminSubjects" asp-action="Index">Quản trị môn học</a>
        <span class="academic-breadcrumb-separator">/</span>
        <span class="fw-semibold">Tạo môn học mới</span>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-7 col-xl-6">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h1 class="fw-bold fs-3 text-dark mb-1">
                        <i class="bi bi-plus-circle text-primary me-2"></i>Thêm Môn Học Mới
                    </h1>
                    <p class="text-muted small mb-0">Mã môn sẽ tự động được chuẩn hóa thành chữ in hoa.</p>
                </div>
                <a asp-controller="AdminSubjects" asp-action="Index" class="btn btn-sm btn-outline-secondary btn-press">
                    <i class="bi bi-arrow-left"></i> Quay lại
                </a>
            </div>

            <div class="academic-card card-lift shadow-sm bg-white border rounded-4 p-4">
                <form method="post" asp-controller="AdminSubjects" asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small mb-4" role="alert" style="border-radius: var(--radius-md);"></div>

                    <div class="mb-4">
                        <label asp-for="Code" class="form-label fw-bold small text-dark">
                            Mã môn học <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Code" class="form-control font-monospace input-focus-glow" placeholder="Ví dụ: PRJ301, SWT301, PRN211" style="border-radius: var(--radius-md); padding: 0.65rem 0.85rem;" />
                        <div class="form-text text-muted small">Mã định danh môn học theo chương trình đào tạo FPT University.</div>
                        <span asp-validation-for="Code" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Name" class="form-label fw-bold small text-dark">
                            Tên đầy đủ của môn học <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Name" class="form-control input-focus-glow" placeholder="Ví dụ: Java Web Application Development" style="border-radius: var(--radius-md); padding: 0.65rem 0.85rem;" />
                        <span asp-validation-for="Name" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="form-check form-switch mb-4">
                        <input asp-for="IsActive" class="form-check-input cursor-pointer" type="checkbox" role="switch" id="isActiveSwitch" checked />
                        <label class="form-check-label fw-semibold small text-dark cursor-pointer" for="isActiveSwitch">Kích hoạt môn học ngay lập tức</label>
                        <div class="form-text text-muted small">Khi kích hoạt, sinh viên và giảng viên có thể thấy và tra cứu tài liệu môn này.</div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a asp-controller="AdminSubjects" asp-action="Index" class="btn btn-outline-secondary btn-press" style="border-radius: var(--radius-md);">Hủy bỏ</a>
                        <button type="submit" class="btn btn-primary btn-press px-4" style="background-color: var(--color-primary-600); border-color: var(--color-primary-600); border-radius: var(--radius-md); font-weight: 600;">
                            <i class="bi bi-check2-circle me-1"></i> Khởi tạo môn học
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
