@model AdminSubjectFormViewModel
@{
    ViewData["Title"] = "Tạo môn học";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="mb-1">Tạo môn học</h2>
                <p class="text-muted mb-0">Mã môn được chuẩn hóa thành chữ in hoa.</p>
            </div>
            <a asp-controller="AdminSubjects" asp-action="Index" class="btn btn-outline-secondary">Quay lại</a>
        </div>

        <div class="card shadow-sm">
            <div class="card-body">
                <form method="post" asp-controller="AdminSubjects" asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <div class="mb-3">
                        <label asp-for="Code" class="form-label fw-bold"></label>
                        <input asp-for="Code" class="form-control" placeholder="Ví dụ: PRJ301" />
                        <span asp-validation-for="Code" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-bold"></label>
                        <input asp-for="Name" class="form-control" placeholder="Tên đầy đủ của môn học" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                    <div class="form-check mb-4">
                        <input asp-for="IsActive" class="form-check-input" />
                        <label asp-for="IsActive" class="form-check-label"></label>
                    </div>
                    <div class="d-flex justify-content-end gap-2">
                        <a asp-controller="AdminSubjects" asp-action="Index" class="btn btn-light">Hủy</a>
                        <button type="submit" class="btn btn-primary">Tạo môn</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
