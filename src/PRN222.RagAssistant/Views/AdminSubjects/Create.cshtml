@model AdminSubjectFormViewModel
@{
    ViewData["Title"] = "Tạo Môn Học Mới - Admin";
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <div class="academic-breadcrumb mb-3">
        <a asp-page="/Index"><i class="bi bi-house-door"></i> Trang chủ</a>
        <span class="academic-breadcrumb-separator">/</span>
        <a asp-controller="AdminSubjects" asp-action="Index">Quản trị môn học</a>
        <span class="academic-breadcrumb-separator">/</span>
        <span class="text-slate-800 fw-semibold">Tạo môn học mới</span>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-7 col-xl-6">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h1 class="fw-bold fs-3 text-slate-900 mb-1">
                        <i class="bi bi-plus-circle text-primary me-2"></i>Thêm Môn Học Mới
                    </h1>
                    <p class="text-slate-500 mb-0">Mã môn sẽ tự động được chuẩn hóa thành chữ in hoa.</p>
                </div>
                <a asp-controller="AdminSubjects" asp-action="Index" class="btn btn-sm btn-academic-outline">
                    <i class="bi bi-arrow-left"></i> Quay lại
                </a>
            </div>

            <div class="academic-card shadow-sm">
                <form method="post" asp-controller="AdminSubjects" asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger d-flex align-items-center gap-2 mb-4" role="alert"></div>

                    <div class="mb-4">
                        <label asp-for="Code" class="form-label fw-bold text-slate-800">
                            Mã môn học <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Code" class="form-control font-monospace" placeholder="Ví dụ: PRJ301, SWT301, PRN211" />
                        <div class="form-text text-slate-500">Mã định danh môn học theo chương trình đào tạo FPT University.</div>
                        <span asp-validation-for="Code" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Name" class="form-label fw-bold text-slate-800">
                            Tên đầy đủ của môn học <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Name" class="form-control" placeholder="Ví dụ: Java Web Application Development" />
                        <span asp-validation-for="Name" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="form-check form-switch mb-4">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" id="isActiveSwitch" checked />
                        <label class="form-check-label fw-semibold text-slate-800" for="isActiveSwitch">Kích hoạt môn học ngay lập tức</label>
                        <div class="form-text text-slate-500">Khi kích hoạt, sinh viên và giảng viên có thể thấy và tra cứu tài liệu môn này.</div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a asp-controller="AdminSubjects" asp-action="Index" class="btn btn-academic-outline">Hủy bỏ</a>
                        <button type="submit" class="btn-academic-primary px-4">
                            <i class="bi bi-check2-circle"></i> Khởi tạo môn học
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
