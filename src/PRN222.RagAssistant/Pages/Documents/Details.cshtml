@page "/Documents/Details"
@using PRN222.RagAssistant.Domain.Enums
@model PRN222.RagAssistant.Pages.Documents.DetailsModel
@{
    ViewData["Title"] = $"Chi tiết: {Model.Document.Title} - {Model.Document.SubjectCode}";
}

@if (Model.CanManageDocuments)
{
    <div data-management-realtime
         data-realtime-scope="subject"
         data-subject-id="@Model.Document.SubjectId"
         hidden></div>
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <div class="academic-breadcrumb mb-3">
        <a asp-page="/Index"><i class="bi bi-house-door"></i> Trang chủ</a>
        <span class="academic-breadcrumb-separator">/</span>
        <a asp-page="/Subjects/Index">Môn học</a>
        <span class="academic-breadcrumb-separator">/</span>
        <a asp-page="/Documents/Index" asp-route-subjectId="@Model.Document.SubjectId">Tài liệu @Model.Document.SubjectCode</a>
        <span class="academic-breadcrumb-separator">/</span>
        <span class="text-slate-800 fw-semibold">Chi tiết tài liệu</span>
    </div>

    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4 pb-2 border-bottom">
        <div>
            <div class="badge bg-primary-subtle text-primary border border-primary-subtle px-2.5 py-1 mb-1 font-monospace">@Model.Document.SubjectCode — @Model.Document.SubjectName</div>
            <h1 class="fw-bold fs-3 text-slate-900 mb-1">
                <i class="bi bi-file-text text-primary me-2"></i>@Model.Document.Title
            </h1>
            <p class="text-slate-500 mb-0">Thông số kỹ thuật tài liệu và chỉ số vector nhúng RAG.</p>
        </div>
        <a asp-page="/Documents/Index" asp-route-subjectId="@Model.Document.SubjectId" class="btn btn-sm btn-academic-outline">
            <i class="bi bi-arrow-left"></i> Quay lại kho tài liệu
        </a>
    </div>

    <div class="row g-4">
        <!-- 65% Left: Metadata Overview -->
        <div class="col-lg-8">
            <div class="academic-card mb-4">
                <div class="d-flex align-items-center gap-2 mb-3 pb-2 border-bottom">
                    <i class="bi bi-info-circle text-primary fs-5"></i>
                    <h3 class="fw-bold fs-5 text-slate-900 mb-0">Thông Tin Tổng Quan</h3>
                </div>

                <dl class="row mb-0 g-2">
                    <dt class="col-sm-4 text-slate-500 small fw-semibold">Tiêu đề tài liệu:</dt>
                    <dd class="col-sm-8 text-slate-900 fw-bold">@Model.Document.Title</dd>

                    <dt class="col-sm-4 text-slate-500 small fw-semibold">Tên file vật lý:</dt>
                    <dd class="col-sm-8"><code class="p-1 bg-light rounded text-slate-800">@Model.Document.OriginalFileName</code></dd>

                    <dt class="col-sm-4 text-slate-500 small fw-semibold">Môn học:</dt>
                    <dd class="col-sm-8 text-slate-800">
                        <span class="badge bg-primary text-white me-1">@Model.Document.SubjectCode</span>
                        @Model.Document.SubjectName
                    </dd>

                    <dt class="col-sm-4 text-slate-500 small fw-semibold">Chương học FLM:</dt>
                    <dd class="col-sm-8">
                        @if (Model.Document.ChapterNumber.HasValue)
                        {
                            <span class="badge bg-light text-slate-800 border px-2.5 py-1 fw-medium">
                                <i class="bi bi-bookmark-fill text-primary me-1"></i>Chương @Model.Document.ChapterNumber: @Model.Document.ChapterTitle
                            </span>
                        }
                        else
                        {
                            <span class="text-slate-400 fst-italic">Tài liệu chung (Chưa phân chương)</span>
                        }
                    </dd>

                    <dt class="col-sm-4 text-slate-500 small fw-semibold">Dung lượng:</dt>
                    <dd class="col-sm-8 text-slate-800 font-monospace">@Model.Document.FormattedSize (@Model.Document.FileSizeBytes bytes)</dd>

                    <dt class="col-sm-4 text-slate-500 small fw-semibold">Định dạng / MIME:</dt>
                    <dd class="col-sm-8 text-slate-700 font-monospace small"><code>@Model.Document.FileExtension</code> (@Model.Document.ContentType)</dd>

                    <dt class="col-sm-4 text-slate-500 small fw-semibold">Người tải lên:</dt>
                    <dd class="col-sm-8 text-slate-800"><i class="bi bi-person me-1"></i>@Model.Document.UploadedByEmail</dd>

                    <dt class="col-sm-4 text-slate-500 small fw-semibold">Thời điểm tải lên:</dt>
                    <dd class="col-sm-8 text-slate-700 small">
                        @Model.Document.UploadedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss") (Giờ Việt Nam)
                        <span class="text-slate-400">[@Model.Document.UploadedAtUtc.ToString("dd/MM/yyyy HH:mm:ss") UTC]</span>
                    </dd>
                </dl>
            </div>
        </div>

        <!-- 35% Right: AI Vector Specs & Actions -->
        <div class="col-lg-4">
            <div class="academic-card mb-4">
                <div class="d-flex align-items-center gap-2 mb-3 pb-2 border-bottom">
                    <i class="bi bi-cpu text-primary fs-5"></i>
                    <h3 class="fw-bold fs-5 text-slate-900 mb-0">Thông Số Kỹ Thuật AI (RAG)</h3>
                </div>

                <div class="mb-3">
                    <div class="text-slate-500 small mb-1">Trạng thái Index:</div>
                    <div>
                        @switch (Model.Document.IndexStatus)
                        {
                            case DocumentIndexStatus.Uploaded:
                                <span class="status-pill status-uploaded">Chờ Index</span>
                                break;
                            case DocumentIndexStatus.Processing:
                                <span class="status-pill status-processing">Đang tạo vector embeddings...</span>
                                break;
                            case DocumentIndexStatus.Indexed:
                                <span class="status-pill status-indexed">Đã Index (Sẵn sàng phục vụ RAG)</span>
                                break;
                            case DocumentIndexStatus.Failed:
                                <span class="status-pill status-failed">Thất bại</span>
                                break;
                        }
                    </div>
                </div>

                <div class="stat-box mb-3 text-start">
                    <div class="stat-label">Chunks Đã Lưu Trong PostgreSQL</div>
                    <div class="stat-value text-primary">@Model.ChunkPreview.TotalCount <span class="fs-6 text-slate-500 fw-normal">chunks</span></div>
                    @if (Model.ChunkPreview.TotalCount == 0)
                    {
                        <div class="small text-slate-500 mt-1">Chưa có nội dung chunk để kiểm tra.</div>
                    }
                    else if (Model.ChunkPreview.AllChunksEmbedded)
                    {
                        <div class="small text-success mt-1">
                            <i class="bi bi-check-circle-fill me-1"></i>@Model.ChunkPreview.EmbeddedCount/@Model.ChunkPreview.TotalCount chunks đã có vector embedding.
                        </div>
                    }
                    else
                    {
                        <div class="small text-warning-emphasis mt-1">
                            <i class="bi bi-exclamation-triangle-fill me-1"></i>Chỉ @Model.ChunkPreview.EmbeddedCount/@Model.ChunkPreview.TotalCount chunks có vector embedding.
                        </div>
                    }
                </div>

                <div class="mb-3 small">
                    <span class="text-slate-500">Thời điểm hoàn tất:</span>
                    <div class="fw-semibold text-slate-800">
                        @if (Model.Document.IndexedAtUtc.HasValue)
                        {
                            <span>@Model.Document.IndexedAtUtc.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</span>
                        }
                        else
                        {
                            <span class="text-slate-400 fst-italic">Chưa hoàn tất</span>
                        }
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(Model.Document.IndexError))
                {
                    <div class="alert alert-danger p-2.5 small mb-0">
                        <div class="fw-bold mb-1"><i class="bi bi-exclamation-octagon"></i> Chi tiết lỗi:</div>
                        <code>@Model.Document.IndexError</code>
                    </div>
                }
            </div>

            @if (Model.CanManageDocuments)
            {
                <div class="academic-card">
                    <h4 class="fw-bold fs-6 text-slate-900 mb-3">Thao Tác Quản Trị</h4>
                    <div class="d-grid gap-2">
                        <a asp-page="/Documents/Edit" asp-route-id="@Model.Document.Id" class="btn btn-academic-primary justify-content-center">
                            <i class="bi bi-pencil"></i> Chỉnh sửa thông tin
                        </a>
                        <form method="post" asp-page-handler="Reindex" asp-route-id="@Model.Document.Id" onsubmit="return confirm('Yêu cầu hệ thống tách chunk và embed lại tài liệu này?');">
                            <button type="submit" class="btn btn-outline-warning text-dark w-100 d-flex align-items-center justify-content-center gap-2">
                                <i class="bi bi-arrow-repeat"></i> Re-index tài liệu
                            </button>
                        </form>
                        <form method="post" asp-page-handler="Delete" asp-route-id="@Model.Document.Id" onsubmit="return confirm('Xóa tài liệu này khỏi hệ thống?');">
                            <button type="submit" class="btn btn-outline-danger w-100 d-flex align-items-center justify-content-center gap-2">
                                <i class="bi bi-trash"></i> Xóa tài liệu
                            </button>
                        </form>
                    </div>
                </div>
            }
        </div>
    </div>

    <section id="chunk-preview" class="academic-card mt-4" aria-labelledby="chunk-preview-title">
        <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3 pb-3 border-bottom">
            <div>
                <h2 id="chunk-preview-title" class="fw-bold fs-5 text-slate-900 mb-1">
                    <i class="bi bi-body-text text-primary me-2"></i>Nội Dung Đã Trích Xuất &amp; Cách Chia Chunk
                </h2>
                <p class="text-slate-500 small mb-0">
                    Đây là nội dung thật từ <code>DocumentChunk.Content</code> đã lưu sau bước parse, chunk và embedding; không phải dữ liệu minh họa.
                </p>
            </div>
            @if (Model.ChunkPreview.TotalCount > 0)
            {
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2">
                    Trang @Model.ChunkPreview.CurrentPage/@Model.ChunkPreview.TotalPages
                </span>
            }
        </div>

        @if (Model.ChunkPreview.TotalCount == 0)
        {
            if (Model.Document.IndexStatus == DocumentIndexStatus.Indexed)
            {
                <div class="alert alert-warning mb-0" role="alert">
                    <div class="fw-semibold mb-1"><i class="bi bi-exclamation-triangle me-1"></i>Trạng thái không nhất quán</div>
                    Tài liệu được đánh dấu đã index nhưng PostgreSQL không có chunk nào. Hãy re-index và kiểm tra log của indexing worker.
                </div>
            }
            else
            {
                <div class="alert alert-secondary mb-0" role="status">
                    Nội dung chunk sẽ xuất hiện tại đây sau khi pipeline parse, chia chunk và tạo embedding hoàn tất.
                </div>
            }
        }
        else
        {
            <div class="alert alert-info py-2 small" role="note">
                <i class="bi bi-info-circle me-1"></i>
                Mỗi thẻ bên dưới là một chunk theo đúng thứ tự lưu trữ. Số ký tự và trang/slide giúp kiểm tra điểm cắt; phần văn bản lặp giữa hai chunk liên tiếp là overlap có chủ đích.
            </div>

            <div class="d-flex flex-column gap-3">
                @foreach (var chunk in Model.ChunkPreview.Items)
                {
                    <article class="border rounded-3 p-3 bg-white" aria-labelledby="chunk-@chunk.ChunkIndex-title">
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                            <div class="d-flex flex-wrap align-items-center gap-2">
                                <h3 id="chunk-@chunk.ChunkIndex-title" class="fs-6 fw-bold text-slate-900 mb-0">
                                    Chunk @(chunk.ChunkIndex + 1)
                                </h3>
                                <span class="badge bg-light text-slate-700 border">@chunk.CharacterCount ký tự</span>
                                @if (chunk.PageNumber.HasValue)
                                {
                                    <span class="badge bg-light text-slate-700 border">
                                        <i class="bi bi-file-earmark-text me-1"></i>Trang @chunk.PageNumber
                                    </span>
                                }
                                @if (chunk.SlideNumber.HasValue)
                                {
                                    <span class="badge bg-light text-slate-700 border">
                                        <i class="bi bi-easel me-1"></i>Slide @chunk.SlideNumber
                                    </span>
                                }
                            </div>
                            @if (chunk.HasEmbedding)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle">
                                    <i class="bi bi-check-circle me-1"></i>Đã có embedding
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">
                                    <i class="bi bi-exclamation-triangle me-1"></i>Thiếu embedding
                                </span>
                            }
                        </div>
                        <div class="p-3 bg-light rounded border text-slate-800 small font-monospace"
                             style="white-space: pre-wrap; overflow-wrap: anywhere;">@chunk.Content</div>
                    </article>
                }
            </div>

            @if (Model.ChunkPreview.TotalPages > 1)
            {
                <nav class="mt-4" aria-label="Phân trang nội dung chunks">
                    <ul class="pagination pagination-sm justify-content-center align-items-center mb-0">
                        <li class="page-item @(!Model.ChunkPreview.HasPreviousPage ? "disabled" : null)">
                            @if (Model.ChunkPreview.HasPreviousPage)
                            {
                                <a class="page-link"
                                   asp-page="/Documents/Details"
                                   asp-route-id="@Model.Document.Id"
                                   asp-route-chunkPage="@(Model.ChunkPreview.CurrentPage - 1)"
                                   asp-fragment="chunk-preview">Trước</a>
                            }
                            else
                            {
                                <span class="page-link">Trước</span>
                            }
                        </li>
                        <li class="page-item disabled">
                            <span class="page-link text-slate-700">
                                @Model.ChunkPreview.CurrentPage / @Model.ChunkPreview.TotalPages
                            </span>
                        </li>
                        <li class="page-item @(!Model.ChunkPreview.HasNextPage ? "disabled" : null)">
                            @if (Model.ChunkPreview.HasNextPage)
                            {
                                <a class="page-link"
                                   asp-page="/Documents/Details"
                                   asp-route-id="@Model.Document.Id"
                                   asp-route-chunkPage="@(Model.ChunkPreview.CurrentPage + 1)"
                                   asp-fragment="chunk-preview">Sau</a>
                            }
                            else
                            {
                                <span class="page-link">Sau</span>
                            }
                        </li>
                    </ul>
                </nav>
            }
        }
    </section>
</div>
@section Scripts {
    @if (Model.CanManageDocuments)
    {
        <partial name="_ManagementRealtimeScripts" />
    }
}
