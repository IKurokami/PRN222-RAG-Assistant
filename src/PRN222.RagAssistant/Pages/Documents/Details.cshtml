@page "{id:guid}"
@using PRN222.RagAssistant.Domain.Enums
@model PRN222.RagAssistant.Pages.Documents.DetailsModel
@{
    ViewData["Title"] = $"Chi tiết tài liệu - {Model.Document.Title}";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1">@Model.Document.Title</h2>
        <span class="text-muted">Chi tiết thông tin và trạng thái xử lý tài liệu</span>
    </div>
    <div>
        <a asp-page="./Index" class="btn btn-outline-secondary">Quay lại danh sách</a>
    </div>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-light fw-bold">
                Thông tin chung
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Tiêu đề tài liệu</dt>
                    <dd class="col-sm-8">@Model.Document.Title</dd>

                    <dt class="col-sm-4">Tên file gốc</dt>
                    <dd class="col-sm-8"><code>@Model.Document.OriginalFileName</code></dd>

                    <dt class="col-sm-4">Môn học</dt>
                    <dd class="col-sm-8">@Model.Document.SubjectCode - @Model.Document.SubjectName</dd>

                    <dt class="col-sm-4">Chương</dt>
                    <dd class="col-sm-8">
                        @if (Model.Document.ChapterNumber.HasValue)
                        {
                            <span class="badge bg-info text-dark">Chương @Model.Document.ChapterNumber: @Model.Document.ChapterTitle</span>
                        }
                        else
                        {
                            <span class="text-muted">Chưa gán chương</span>
                        }
                    </dd>

                    <dt class="col-sm-4">Dung lượng</dt>
                    <dd class="col-sm-8">@Model.Document.FormattedSize (@Model.Document.FileSizeBytes bytes)</dd>

                    <dt class="col-sm-4">Định dạng / MIME</dt>
                    <dd class="col-sm-8"><code>@Model.Document.FileExtension</code> (@Model.Document.ContentType)</dd>

                    <dt class="col-sm-4">Người tải lên</dt>
                    <dd class="col-sm-8">@Model.Document.UploadedByEmail</dd>

                    <dt class="col-sm-4">Thời gian tải lên</dt>
                    <dd class="col-sm-8">@Model.Document.UploadedAtUtc.ToString("dd/MM/yyyy HH:mm:ss") (UTC)</dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-light fw-bold">
                Trạng thái Indexing (RAG)
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label text-muted mb-1">Trạng thái hiện tại:</label>
                    <div>
                        @switch (Model.Document.IndexStatus)
                        {
                            case DocumentIndexStatus.Uploaded:
                                <span class="badge bg-secondary p-2 fs-6">Uploaded (Đã lưu file & chờ index)</span>
                                break;
                            case DocumentIndexStatus.Processing:
                                <span class="badge bg-primary p-2 fs-6">Processing (Đang tách chunk & embed)</span>
                                break;
                            case DocumentIndexStatus.Indexed:
                                <span class="badge bg-success p-2 fs-6">Indexed (Sẵn sàng truy vấn RAG)</span>
                                break;
                            case DocumentIndexStatus.Failed:
                                <span class="badge bg-danger p-2 fs-6">Failed (Xử lý thất bại)</span>
                                break;
                        }
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label text-muted mb-1">Số lượng Chunks đã tách:</label>
                    <div class="fw-bold fs-5 text-primary">@Model.Document.ChunkCount chunks</div>
                </div>

                <div class="mb-3">
                    <label class="form-label text-muted mb-1">Thời điểm hoàn tất Index:</label>
                    <div>
                        @if (Model.Document.IndexedAtUtc.HasValue)
                        {
                            <span>@Model.Document.IndexedAtUtc.Value.ToString("dd/MM/yyyy HH:mm:ss") (UTC)</span>
                        }
                        else
                        {
                            <span class="text-muted">Chưa hoàn tất</span>
                        }
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(Model.Document.IndexError))
                {
                    <div class="alert alert-danger mb-0">
                        <h6 class="alert-heading fw-bold">Chi tiết lỗi Index:</h6>
                        <small class="text-break">@Model.Document.IndexError</small>
                    </div>
                }
            </div>
        </div>

        @if (Model.CanManageDocuments)
        {
            <div class="card shadow-sm">
                <div class="card-body d-grid gap-2">
                    <a asp-page="./Edit" asp-route-id="@Model.Document.Id" class="btn btn-primary w-100">
                        Chỉnh sửa thông tin
                    </a>
                    <form method="post" asp-page="./Index" asp-page-handler="Reindex" asp-route-id="@Model.Document.Id" onsubmit="return confirm('Yêu cầu hệ thống tách chunk và embed lại tài liệu này?');">
                        <button type="submit" class="btn btn-warning w-100">
                            Re-index tài liệu
                        </button>
                    </form>
                    <form method="post" asp-page="./Index" asp-page-handler="Delete" asp-route-id="@Model.Document.Id" onsubmit="return confirm('Xóa tài liệu này khỏi hệ thống?');">
                        <button type="submit" class="btn btn-outline-danger w-100">
                            Xóa tài liệu
                        </button>
                    </form>
                </div>
            </div>
        }
    </div>
</div>
