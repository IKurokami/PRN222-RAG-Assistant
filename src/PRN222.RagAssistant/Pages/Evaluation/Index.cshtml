@page
@model PRN222.RagAssistant.Pages.Evaluation.IndexModel
@{
    ViewData["Title"] = "Đánh Giá RAG - Bộ 50 Câu Hỏi";
}

@Html.AntiForgeryToken()

<div class="container-fluid px-4 py-4">
    <!-- Header -->
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h4 class="fw-bold text-dark mb-1">
                <i class="bi bi-clipboard-data-fill text-primary me-2"></i>
                Hệ Thống Đánh Giá RAG - Bộ 50 Câu Hỏi Thực Tế
            </h4>
            <p class="text-muted small mb-0">Bộ dữ liệu kiểm thử gồm 50 câu hỏi chuyên sâu do con người biên soạn bao phủ toàn bộ 5 mô-đun môn PRN222.</p>
        </div>
        <div>
            <button id="runAllBtn" type="button" class="btn btn-primary rounded-2 px-3 fw-semibold" onclick="runFullSuite()">
                <i class="bi bi-play-fill me-1"></i> Chạy Toàn Bộ 50 Câu Hỏi
            </button>
        </div>
    </div>

    <!-- Metric Dashboard Cards -->
    <div class="row g-3 mb-4">
        <div class="col-lg-3 col-sm-6">
            <div class="card border-0 shadow-sm rounded-3 bg-white p-3 border-start border-4 border-primary">
                <div class="text-uppercase small fw-bold text-muted mb-1">Tổng Số Câu Hỏi</div>
                <div class="h3 fw-bold mb-0 text-dark" id="statTotal">@Model.Questions.Count</div>
                <small class="text-muted">Biên soạn thủ công (Human-authored)</small>
            </div>
        </div>
        <div class="col-lg-3 col-sm-6">
            <div class="card border-0 shadow-sm rounded-3 bg-white p-3 border-start border-4 border-success">
                <div class="text-uppercase small fw-bold text-muted mb-1">Độ Chính Xác Từ Khóa Mẫu</div>
                <div class="h3 fw-bold mb-0 text-success" id="statAccuracy">-- %</div>
                <small class="text-muted">Keyword Accuracy Score</small>
            </div>
        </div>
        <div class="col-lg-3 col-sm-6">
            <div class="card border-0 shadow-sm rounded-3 bg-white p-3 border-start border-4 border-warning">
                <div class="text-uppercase small fw-bold text-muted mb-1">Độ Phủ Trích Dẫn (Citations)</div>
                <div class="h3 fw-bold mb-0 text-warning" id="statCitation">-- %</div>
                <small class="text-muted">Citation Coverage Rate</small>
            </div>
        </div>
        <div class="col-lg-3 col-sm-6">
            <div class="card border-0 shadow-sm rounded-3 bg-white p-3 border-start border-4 border-info">
                <div class="text-uppercase small fw-bold text-muted mb-1">Thời Gian Thực Thi</div>
                <div class="h3 fw-bold mb-0 text-info" id="statDuration">-- ms</div>
                <small class="text-muted">Total Suite Duration</small>
            </div>
        </div>
    </div>

    <!-- Suite Progress Bar -->
    <div id="progressContainer" class="card border-0 shadow-sm rounded-3 mb-4 p-3 d-none">
        <div class="d-flex align-items-center justify-content-between mb-2">
            <span class="small fw-bold text-primary" id="progressStatus">Đang khởi chạy đánh giá 50 câu hỏi...</span>
            <span class="small text-muted" id="progressPercent">0%</span>
        </div>
        <div class="progress" style="height: 10px;">
            <div id="progressBar" class="progress-bar progress-bar-striped progress-bar-animated bg-primary" role="progressbar" style="width: 0%"></div>
        </div>
    </div>

    <!-- Questions Table -->
    <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
        <div class="card-header bg-white border-bottom py-3">
            <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-list-check me-2"></i>Danh Sách 50 Câu Hỏi Đánh Giá</h6>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th style="width: 50px;">#</th>
                        <th style="width: 220px;">Mô-đun & Chủ đề</th>
                        <th>Nội dung câu hỏi</th>
                        <th style="width: 140px;">Từ khóa kỳ vọng</th>
                        <th style="width: 130px;">Kết quả Test</th>
                        <th style="width: 120px;" class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var q in Model.Questions)
                    {
                        <tr id="row-@q.Id">
                            <td class="fw-bold text-muted">@q.Id</td>
                            <td>
                                <span class="badge bg-secondary-subtle text-dark border mb-1">@q.Module.Split(':')[0]</span>
                                <div class="small fw-semibold text-dark">@q.Topic</div>
                            </td>
                            <td>
                                <div class="fw-semibold text-dark mb-1">@q.QuestionText</div>
                                <div class="small text-muted text-truncate" style="max-width: 500px;" title="@q.GroundTruthAnswer">
                                    <strong class="text-primary">Đáp án mẫu:</strong> @q.GroundTruthAnswer
                                </div>
                            </td>
                            <td>
                                <div class="d-flex flex-wrap gap-1">
                                    @foreach (var kw in q.ExpectedKeywords)
                                    {
                                        <span class="badge bg-light text-dark border" style="font-size: 0.7rem;">@kw</span>
                                    }
                                </div>
                            </td>
                            <td id="res-@q.Id">
                                <span class="badge bg-secondary-subtle text-muted">Chưa test</span>
                            </td>
                            <td class="text-end">
                                <button type="button" class="btn btn-outline-primary btn-sm rounded-2" onclick="runSingleTest(@q.Id)">
                                    <i class="bi bi-play"></i> Test
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Detail Result -->
<div class="modal fade" id="resultModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-bottom bg-light">
                <h6 class="modal-title fw-bold text-dark" id="modalTitle">Chi Tiết Kết Quả Đánh Giá</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4" id="modalBody">
                <!-- Dynamic Content -->
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        async function runSingleTest(questionId) {
            const resCell = document.getElementById(`res-${questionId}`);
            resCell.innerHTML = `<span class="spinner-border spinner-border-sm text-primary" role="status"></span> <small class="text-muted">Đang test...</small>`;

            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                const formData = new FormData();
                formData.append('questionId', questionId);

                const response = await fetch('/Evaluation?handler=RunSingle', {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': token },
                    body: formData
                });

                const data = await response.json();
                if (data.success && data.result) {
                    const r = data.result;
                    const accuracyClass = r.keywordAccuracyPercent >= 70 ? 'bg-success' : (r.keywordAccuracyPercent >= 40 ? 'bg-warning text-dark' : 'bg-danger');
                    resCell.innerHTML = `
                        <button type="button" class="btn btn-link p-0 text-decoration-none" onclick="showModalDetail(${questionId})">
                            <span class="badge ${accuracyClass} me-1">${r.keywordAccuracyPercent}%</span>
                            <small class="text-muted">(${r.citationsCount} refs)</small>
                        </button>`;
                    window[`res_data_${questionId}`] = r;
                } else {
                    resCell.innerHTML = `<span class="badge bg-danger">Lỗi: ${data.message || 'Error'}</span>`;
                }
            } catch (err) {
                resCell.innerHTML = `<span class="badge bg-danger">Error</span>`;
            }
        }

        async function runFullSuite() {
            const btn = document.getElementById('runAllBtn');
            const progressContainer = document.getElementById('progressContainer');
            const progressBar = document.getElementById('progressBar');
            const progressStatus = document.getElementById('progressStatus');
            const progressPercent = document.getElementById('progressPercent');

            btn.disabled = true;
            progressContainer.classList.remove('d-none');
            progressBar.style.width = '0%';
            progressStatus.innerText = 'Đang tiến hành truy vấn RAG cho 50 câu hỏi...';

            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                const response = await fetch('/Evaluation?handler=RunAll', {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': token }
                });

                const data = await response.json();
                if (data.success && data.report) {
                    const report = data.report;
                    document.getElementById('statAccuracy').innerText = report.averageKeywordAccuracyPercent + '%';
                    document.getElementById('statCitation').innerText = report.citationCoveragePercent + '%';
                    document.getElementById('statDuration').innerText = report.totalDurationMs + ' ms';

                    progressBar.style.width = '100%';
                    progressPercent.innerText = '100%';
                    progressStatus.innerText = `Đã hoàn thành đánh giá ${report.evaluatedQuestions}/${report.totalQuestions} câu hỏi!`;

                    report.results.forEach(r => {
                        window[`res_data_${r.questionId}`] = r;
                        const resCell = document.getElementById(`res-${r.questionId}`);
                        if (resCell) {
                            const accuracyClass = r.keywordAccuracyPercent >= 70 ? 'bg-success' : (r.keywordAccuracyPercent >= 40 ? 'bg-warning text-dark' : 'bg-danger');
                            resCell.innerHTML = `
                                <button type="button" class="btn btn-link p-0 text-decoration-none" onclick="showModalDetail(${r.questionId})">
                                    <span class="badge ${accuracyClass} me-1">${r.keywordAccuracyPercent}%</span>
                                    <small class="text-muted">(${r.citationsCount} refs)</small>
                                </button>`;
                        }
                    });
                } else {
                    alert('Lỗi: ' + (data.message || 'Không thể chạy bộ đánh giá.'));
                }
            } catch (err) {
                alert('Đã xảy ra lỗi kết nối khi chạy bộ đánh giá.');
            } finally {
                btn.disabled = false;
            }
        }

        function showModalDetail(questionId) {
            const data = window[`res_data_${questionId}`];
            if (!data) return;

            const modalTitle = document.getElementById('modalTitle');
            const modalBody = document.getElementById('modalBody');

            modalTitle.innerText = `Chi tiết Đánh giá Câu hỏi #${questionId}`;

            const matchedBadges = data.matchedKeywords.map(k => `<span class="badge bg-success-subtle text-success border border-success me-1">${k}</span>`).join('');
            const missingBadges = data.missingKeywords.map(k => `<span class="badge bg-danger-subtle text-danger border border-danger me-1">${k}</span>`).join('');

            modalBody.innerHTML = `
                <div class="mb-3">
                    <label class="small fw-bold text-muted text-uppercase">Câu hỏi:</label>
                    <div class="fw-bold text-dark fs-6">${escapeHtml(data.questionText)}</div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <div class="card h-100 border-0 bg-light p-3">
                            <label class="small fw-bold text-primary text-uppercase mb-2"><i class="bi bi-check-circle-fill me-1"></i>Đáp án mẫu (Ground Truth):</label>
                            <div class="small text-dark" style="white-space: pre-wrap;">${escapeHtml(data.groundTruthAnswer)}</div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="card h-100 border-0 bg-light p-3">
                            <label class="small fw-bold text-secondary text-uppercase mb-2"><i class="bi bi-robot me-1"></i>Câu trả lời từ RAG System:</label>
                            <div class="small text-dark" style="white-space: pre-wrap;">${escapeHtml(data.systemAnswer)}</div>
                        </div>
                    </div>
                </div>

                <div class="card border-0 bg-white p-3 border">
                    <div class="row text-center">
                        <div class="col-4">
                            <div class="small text-muted">Độ chính xác từ khóa</div>
                            <div class="h5 fw-bold text-primary mb-0">${data.keywordAccuracyPercent}%</div>
                        </div>
                        <div class="col-4">
                            <div class="small text-muted">Trích dẫn (Citations)</div>
                            <div class="h5 fw-bold text-success mb-0">${data.citationsCount} refs</div>
                        </div>
                        <div class="col-4">
                            <div class="small text-muted">Thời gian thực thi</div>
                            <div class="h5 fw-bold text-info mb-0">${data.executionTimeMs} ms</div>
                        </div>
                    </div>
                    <hr class="my-2" />
                    <div class="small">
                        <strong>Từ khóa trùng khớp:</strong> ${matchedBadges || '<span class="text-muted">Không có</span>'}<br/>
                        <strong>Từ khóa còn thiếu:</strong> ${missingBadges || '<span class="text-muted">Không có</span>'}
                    </div>
                </div>`;

            const modal = new bootstrap.Modal(document.getElementById('resultModal'));
            modal.show();
        }

        function escapeHtml(text) {
            if (!text) return '';
            return text
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#039;");
        }
    </script>
}
