@page
@model PRN222.RagAssistant.Pages.Account.LoginModel
@{
    Layout = null;
    ViewData["Title"] = "Đăng nhập - PRN222 RAG Assistant";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/design-tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="account-page">
    <main class="account-shell">
        <section class="account-visual" aria-label="PRN222 RAG Assistant">
            <a class="account-brand" asp-page="/Index" aria-label="Về trang chủ">
                <span class="app-logo-mark" aria-hidden="true">
                    <span class="app-logo-letter">R</span>
                    <span class="app-logo-accent"></span>
                </span>
                <span class="app-brand-copy">
                    <span class="app-brand-name">PRN222</span>
                    <span class="app-brand-product">RAG Assistant</span>
                </span>
            </a>
            <div class="account-visual-copy">
                <p>Không gian tri thức môn học</p>
                <h1>Quản lý tài liệu rõ ràng, đúng phạm vi.</h1>
                <ul>
                    <li>PDF, DOCX và PPTX</li>
                    <li>Index cục bộ với Ollama</li>
                    <li>Phân quyền theo từng môn học</li>
                </ul>
            </div>
        </section>

        <section class="account-form-pane">
            <div class="account-form-wrap">
                <a asp-page="/Index" class="account-back-link"><i class="bi bi-arrow-left" aria-hidden="true"></i> Trang chủ</a>
                <p class="account-form-kicker">Tài khoản của bạn</p>
                <h2>Đăng nhập</h2>
                <p class="account-form-intro">Nhập thông tin tài khoản để tiếp tục vào không gian môn học.</p>

                <form method="post" class="account-form">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small" role="alert"></div>

                    <div>
                        <label asp-for="Input.Email">Email tài khoản</label>
                        <input asp-for="Input.Email" autocomplete="username" placeholder="name@prn222.local" />
                        <span asp-validation-for="Input.Email" class="text-danger small"></span>
                    </div>

                    <div>
                        <label asp-for="Input.Password">Mật khẩu</label>
                        <input asp-for="Input.Password" autocomplete="current-password" placeholder="Nhập mật khẩu" />
                        <span asp-validation-for="Input.Password" class="text-danger small"></span>
                    </div>

                    <label class="account-check">
                        <input asp-for="Input.RememberMe" />
                        <span>Ghi nhớ đăng nhập</span>
                    </label>

                    <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                    <button type="submit" class="account-submit">Đăng nhập <i class="bi bi-arrow-right" aria-hidden="true"></i></button>
                </form>

                <p class="account-switch">Chưa có tài khoản? <a asp-page="/Account/Register">Đăng ký</a></p>
            </div>
        </section>
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>
