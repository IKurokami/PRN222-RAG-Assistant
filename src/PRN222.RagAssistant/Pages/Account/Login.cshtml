@page
@model PRN222.RagAssistant.Pages.Account.LoginModel
@{
    Layout = null;
    ViewData["Title"] = "Đăng nhập - PRN222 RAG Assistant";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/design-tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="account-page">
    <div id="top-loading-bar"></div>
    <main class="account-shell page-enter">
        <!-- Left Side: Editorial Testimonial & Visual Quote -->
        <section class="account-visual" aria-label="PRN222 RAG Assistant">
            <a class="account-brand" asp-page="/Index" aria-label="Về trang chủ">
                <span class="app-logo-mark" aria-hidden="true">
                    <span class="app-logo-letter">R</span>
                    <span class="app-logo-accent"></span>
                </span>
                <span class="app-brand-copy">
                    <span class="app-brand-name">PRN222</span>
                    <span class="app-brand-product">RAG Assistant</span>
                </span>
            </a>
            <div class="account-visual-copy">
                <blockquote class="account-quote-bubble card-lift">
                    <p class="account-quote-text">
                        “Tôi rất thích PRN222 RAG Assistant bởi vì đây là công cụ vô cùng đắc lực cho sinh viên và giảng viên cần phân tích nhanh tài liệu phức tạp, tra cứu chính xác từng đề cương môn học.”
                    </p>
                    <div class="account-quote-author">
                        <img src="/images/avatars/avatar-1.png" alt="Trần Minh Hoàng" class="account-quote-avatar" />
                        <div>
                            <strong class="d-block text-white">Trần Minh Hoàng</strong>
                            <span class="text-white-50 small">Thủ khoa K18 Ngành Kỹ thuật Phần mềm — ĐH FPT</span>
                        </div>
                    </div>
                    <div class="account-rating-stars mt-2" aria-label="Đánh giá 5 sao">
                        <i class="bi bi-star-fill text-warning"></i>
                        <i class="bi bi-star-fill text-warning"></i>
                        <i class="bi bi-star-fill text-warning"></i>
                        <i class="bi bi-star-fill text-warning"></i>
                        <i class="bi bi-star-fill text-warning"></i>
                    </div>
                </blockquote>
                <div class="account-visual-bullets mt-4">
                    <span><i class="bi bi-check-circle-fill text-success me-1"></i> PDF, DOCX và PPTX</span>
                    <span><i class="bi bi-check-circle-fill text-success me-1"></i> AI Local &amp; Cloud linh hoạt</span>
                    <span><i class="bi bi-check-circle-fill text-success me-1"></i> Phân quyền theo môn học</span>
                </div>
            </div>
        </section>

        <!-- Right Side: Minimalist Clean Form Pane -->
        <section class="account-form-pane">
            <div class="account-form-wrap">
                <a asp-page="/Index" class="account-back-link"><i class="bi bi-arrow-left" aria-hidden="true"></i> Trang chủ</a>
                <p class="account-form-kicker">Chào mừng trở lại</p>
                <h2>Đăng nhập</h2>
                <p class="account-form-intro">Chào mừng bạn! Vui lòng nhập thông tin tài khoản để tiếp tục.</p>

                <button type="button" class="btn btn-outline-secondary w-100 mb-3 py-2 d-flex align-items-center justify-content-center gap-2 btn-press" style="border-color: var(--color-border-warm); border-radius: var(--radius-md); font-weight: 600; font-size: 0.9rem;" onclick="window.Toast.show('Tính năng đăng nhập Google FPT đang được kết nối với cổng trường.', 'info')">
                    <svg width="18" height="18" viewBox="0 0 24 24"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/></svg>
                    Đăng nhập với Google FPT
                </button>

                <div class="d-flex align-items-center my-3">
                    <hr class="flex-grow-1" style="border-color: var(--color-border-warm);" />
                    <span class="px-3 text-muted small text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.08em;">Hoặc</span>
                    <hr class="flex-grow-1" style="border-color: var(--color-border-warm);" />
                </div>

                <form method="post" class="account-form">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2 px-3 mb-3" role="alert" style="border-radius: var(--radius-md);"></div>

                    <div class="mb-3">
                        <label asp-for="Input.Email" class="form-label fw-semibold small">Email tài khoản</label>
                        <input asp-for="Input.Email" class="form-control input-focus-glow" id="emailInput" autocomplete="username" placeholder="name@prn222.local" required style="border-radius: var(--radius-md); padding: 0.65rem 0.85rem;" />
                        <span asp-validation-for="Input.Email" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Password" class="form-label fw-semibold small">Mật khẩu</label>
                        <input asp-for="Input.Password" class="form-control input-focus-glow" id="passInput" autocomplete="current-password" placeholder="Nhập mật khẩu" required style="border-radius: var(--radius-md); padding: 0.65rem 0.85rem;" />
                        <span asp-validation-for="Input.Password" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <label class="account-check d-inline-flex align-items-center gap-2 m-0 cursor-pointer">
                            <input asp-for="Input.RememberMe" class="form-check-input" />
                            <span class="small text-muted">Ghi nhớ đăng nhập</span>
                        </label>
                        <a href="javascript:void(0)" onclick="window.Toast.show('Vui lòng liên hệ Quản trị viên (admin@prn222.local) để đặt lại mật khẩu.', 'info')" class="small text-decoration-none" style="color: var(--color-primary-600);">Quên mật khẩu?</a>
                    </div>

                    <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                    <button type="submit" class="btn btn-dark w-100 py-2 account-submit btn-press d-flex align-items-center justify-content-center gap-2" style="background-color: var(--color-btn-dark); border-radius: var(--radius-md); font-weight: 600;">
                        <span>Đăng nhập</span>
                        <i class="bi bi-arrow-right" aria-hidden="true"></i>
                    </button>
                </form>

                <p class="account-switch mt-4 text-center text-muted small">
                    Bạn chưa có tài khoản? <a asp-page="/Account/Register" class="fw-semibold text-decoration-none" style="color: var(--color-primary-600);">Đăng ký ngay</a>
                </p>
            </div>
        </section>
    </main>

    <div class="toast-container-modern"></div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>