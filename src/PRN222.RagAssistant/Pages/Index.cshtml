            <div id="testiName" class="testimonial-name">Trần Minh Hoàng</div>
            <div id="testiRole" class="testimonial-role">Sinh viên K18 Ngành Kỹ thuật Phần mềm — ĐH FPT</div>
            
            <div class="testimonial-stars">
                <i class="bi bi-star-fill"></i>
                <i class="bi bi-star-fill"></i>
                <i class="bi bi-star-fill"></i>
                <i class="bi bi-star-fill"></i>
                <i class="bi bi-star-fill"></i>
            </div>

            <div class="testimonial-indicators">
                <button type="button" class="testimonial-dot active" aria-label="Đánh giá 1"></button>
                <button type="button" class="testimonial-dot" aria-label="Đánh giá 2"></button>
                <button type="button" class="testimonial-dot" aria-label="Đánh giá 3"></button>
            </div>
        </div>
    </div>
</section>

<!-- 6. Section: Floating Call-to-Action Card -->
<section class="floating-cta-section">
    <div class="container">
        <div class="floating-cta-card">
            <div>
                <h3 class="floating-cta-title">Bắt đầu trải nghiệm miễn phí</h3>
                <p class="floating-cta-desc">
                    Không cần thẻ tín dụng. Trải nghiệm ngay trợ lý AI hỏi đáp tài liệu môn học miễn phí.
                </p>
            </div>
            <div class="floating-cta-actions">
                <a href="#pricing" class="btn-cta-outline">Xem bảng giá</a>
                <a asp-page="/Account/Login" class="btn-cta-solid">Bắt đầu ngay</a>
            </div>
        </div>
    </div>
</section>
