@page
@model PRN222.RagAssistant.Pages.Reports.IndexModel
@{
    ViewData["Title"] = $"Báo cáo - {Model.SubjectCode}";
    var totalIndexed = Model.UploadedCount + Model.ProcessingCount + Model.IndexedCount + Model.FailedCount;
    var indexedPercent = totalIndexed > 0 ? (int)Math.Round(Model.IndexedCount * 100.0 / totalIndexed) : 0;
}

<div class="d-flex justify-content-between align-items-start mb-4 pb-2 border-bottom gap-3 flex-wrap">
    <div>
        <div class="small text-muted">@Model.SubjectCode</div>
        <h3 class="fw-bold mb-1">Báo cáo &amp; Thống kê</h3>
        <p class="text-muted small mb-0">@Model.SubjectName</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Documents" asp-action="Index" asp-route-subjectId="@Model.SubjectId" class="btn btn-sm btn-outline-primary">Tài liệu</a>
        <a asp-controller="Chapters" asp-action="Index" asp-route-subjectId="@Model.SubjectId" class="btn btn-sm btn-outline-secondary">Chương</a>
        <a asp-controller="Subjects" asp-action="Index" class="btn btn-sm btn-outline-secondary">Môn học</a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-lg-3"><div class="card shadow-sm h-100"><div class="card-body"><div class="text-muted small fw-bold">TỔNG CHƯƠNG</div><div class="fs-2 fw-bold">@Model.TotalChapters</div></div></div></div>
    <div class="col-sm-6 col-lg-3"><div class="card shadow-sm h-100"><div class="card-body"><div class="text-muted small fw-bold">TỔNG TÀI LIỆU</div><div class="fs-2 fw-bold">@Model.TotalDocuments</div><div class="small text-muted">@Model.UnassignedDocuments chưa gán chương</div></div></div></div>
    <div class="col-sm-6 col-lg-3"><div class="card shadow-sm h-100"><div class="card-body"><div class="text-muted small fw-bold">TỔNG CHUNKS</div><div class="fs-2 fw-bold">@Model.TotalChunks</div></div></div></div>
    <div class="col-sm-6 col-lg-3"><div class="card shadow-sm h-100"><div class="card-body"><div class="text-muted small fw-bold">CHAT TOÀN HỆ THỐNG</div><div class="fs-2 fw-bold">@Model.TotalChatSessions</div><div class="small text-muted">Flow 2 chưa có SubjectId; @Model.TotalChatMessages messages • @Model.TotalMessageCitations citations</div></div></div></div>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-6"><div class="card shadow-sm h-100"><div class="card-header fw-bold">Trạng thái Indexing</div><div class="card-body">
        <div class="d-flex justify-content-between mb-1"><span>Tỷ lệ hoàn thành</span><strong>@indexedPercent%</strong></div>
        <div class="progress mb-3" style="height:10px"><div class="progress-bar bg-success" style="width:@indexedPercent%"></div></div>
        <div class="row text-center g-2"><div class="col-3"><div class="border rounded p-2"><div class="small text-muted">Uploaded</div><strong>@Model.UploadedCount</strong></div></div><div class="col-3"><div class="border rounded p-2"><div class="small text-muted">Processing</div><strong>@Model.ProcessingCount</strong></div></div><div class="col-3"><div class="border rounded p-2"><div class="small text-muted">Indexed</div><strong>@Model.IndexedCount</strong></div></div><div class="col-3"><div class="border rounded p-2"><div class="small text-muted">Failed</div><strong>@Model.FailedCount</strong></div></div></div>
    </div></div></div>
    <div class="col-lg-6"><div class="card shadow-sm h-100"><div class="card-header fw-bold">Tài liệu theo chương</div><div class="card-body p-0"><div class="table-responsive"><table class="table mb-0"><tbody>
        @foreach (var item in Model.DocumentsByChapter) { <tr><td>Chương @item.Number</td><td>@item.Title</td><td class="text-end">@item.DocumentCount</td></tr> }
        @if (Model.UnassignedDocuments > 0) { <tr class="table-warning"><td>—</td><td>Chưa gán chương</td><td class="text-end">@Model.UnassignedDocuments</td></tr> }
    </tbody></table></div></div></div></div>
</div>

@if (Model.RecentFailures.Count > 0)
{
    <div class="card shadow-sm mb-4"><div class="card-header fw-bold text-danger">Indexing failures gần đây</div><div class="table-responsive"><table class="table mb-0"><tbody>
    @foreach (var fail in Model.RecentFailures) { <tr><td><a asp-controller="Documents" asp-action="Details" asp-route-id="@fail.DocumentId">@fail.Title</a><div class="small text-muted">@fail.OriginalFileName</div></td><td class="text-danger small">@fail.IndexError</td><td class="text-end small">@fail.UploadedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td></tr> }
    </tbody></table></div></div>
}

@if (Model.RecentlyIndexed.Count > 0)
{
    <div class="card shadow-sm mb-4"><div class="card-header fw-bold">Đã Index gần đây</div><div class="table-responsive"><table class="table mb-0"><tbody>
    @foreach (var doc in Model.RecentlyIndexed) { <tr><td><a asp-controller="Documents" asp-action="Details" asp-route-id="@doc.DocumentId">@doc.Title</a><div class="small text-muted">@doc.OriginalFileName</div></td><td>@doc.ChunkCount chunks</td><td class="text-end small">@doc.IndexedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td></tr> }
    </tbody></table></div></div>
}
