@page
@using PRN222.RagAssistant.Domain.Enums
@model PRN222.RagAssistant.Pages.Reports.IndexModel
@{
    ViewData["Title"] = "Báo Cáo & Thống Kê Vận Hành - PRN222";
    var totalIndexed = Model.UploadedCount + Model.ProcessingCount + Model.IndexedCount + Model.FailedCount;
    var indexedPercent = totalIndexed > 0 ? (int)Math.Round(Model.IndexedCount * 100.0 / totalIndexed) : 0;
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <div class="academic-breadcrumb">
        <a asp-page="/Index"><i class="bi bi-house-door"></i> Trang chủ</a>
        <span class="academic-breadcrumb-separator">/</span>
        <span class="text-slate-800 fw-semibold">Báo cáo &amp; Thống kê</span>
    </div>

    <!-- Header Section -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="fw-bold fs-3 text-slate-900 mb-1">
                <i class="bi bi-bar-chart-line-fill text-primary me-2"></i>Báo Cáo &amp; Thống Kê PRN222
            </h1>
            <p class="text-slate-500 mb-0">Giám sát tổng quan dữ liệu bài giảng, hiệu năng vector embeddings và hoạt động RAG.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Documents" asp-action="Index" class="btn btn-sm btn-academic-outline">
                <i class="bi bi-journal-bookmark"></i> Quản lý tài liệu
            </a>
            <a asp-controller="Chapters" asp-action="Index" class="btn btn-sm btn-academic-outline">
                <i class="bi bi-list-nested"></i> Quản lý chương
            </a>
        </div>
    </div>

    <!-- 1. Stats Row -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-lg-3">
            <div class="academic-card h-100">
                <div class="text-uppercase text-slate-500 fw-bold small mb-1">Tổng Số Chương Học</div>
                <div class="stat-value text-slate-900">@Model.TotalChapters</div>
                <div class="small text-slate-500 mt-1">Chương trình FLM PRN222</div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="academic-card h-100">
                <div class="text-uppercase text-slate-500 fw-bold small mb-1">Tổng Số Tài Liệu</div>
                <div class="stat-value text-primary">@Model.TotalDocuments</div>
                <div class="small text-slate-500 mt-1">
                    @if (Model.UnassignedDocuments > 0)
                    {
                        <span class="text-warning fw-semibold">@Model.UnassignedDocuments tài liệu chưa gán chương</span>
                    }
                    else
                    {
                        <span>Đã phân loại đầy đủ</span>
                    }
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="academic-card h-100">
                <div class="text-uppercase text-slate-500 fw-bold small mb-1">Tổng Vector Chunks</div>
                <div class="stat-value text-success">@Model.TotalChunks</div>
                <div class="small text-slate-500 mt-1">Lưu trữ trong pgvector</div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="academic-card h-100">
                <div class="text-uppercase text-slate-500 fw-bold small mb-1">Hoạt Động RAG Chat</div>
                <div class="stat-value text-slate-900">@Model.TotalChatSessions <span class="fs-6 fw-normal text-slate-500">phiên</span></div>
                <div class="small text-slate-500 mt-1">@Model.TotalChatMessages tin nhắn • @Model.TotalMessageCitations trích dẫn</div>
            </div>
        </div>
    </div>

    <!-- 2. Progress & Distribution -->
    <div class="row g-4 mb-4">
        <div class="col-lg-6">
            <div class="academic-card h-100">
                <h3 class="fw-bold fs-5 text-slate-900 mb-3 pb-2 border-bottom">
                    <i class="bi bi-pie-chart text-primary me-1"></i>Trạng Thái Tiến Trình Indexing
                </h3>
                @if (totalIndexed == 0)
                {
                    <div class="text-center py-4 text-slate-500">
                        Chưa có tài liệu nào trong hệ thống.
                    </div>
                }
                else
                {
                    <div class="mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="fw-bold small text-slate-800">Tỷ lệ hoàn thành Indexing AI:</span>
                            <span class="status-pill status-indexed">@indexedPercent% (@Model.IndexedCount / @totalIndexed)</span>
                        </div>
                        <div class="progress" style="height: 10px; border-radius: 9999px;">
                            <div class="progress-bar bg-success" role="progressbar" style="width: @indexedPercent%" aria-valuenow="@indexedPercent" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                    </div>

                    <div class="row text-center g-2">
                        <div class="col-6 col-sm-3">
                            <div class="p-2.5 border rounded-3 bg-light">
                                <div class="small text-slate-500 mb-1">Chờ Index</div>
                                <div class="fs-4 fw-bold text-slate-700">@Model.UploadedCount</div>
                            </div>
                        </div>
                        <div class="col-6 col-sm-3">
                            <div class="p-2.5 border rounded-3 bg-light">
                                <div class="small text-slate-500 mb-1">Đang xử lý</div>
                                <div class="fs-4 fw-bold text-primary">@Model.ProcessingCount</div>
                            </div>
                        </div>
                        <div class="col-6 col-sm-3">
                            <div class="p-2.5 border rounded-3 bg-light">
                                <div class="small text-slate-500 mb-1">Đã Index</div>
                                <div class="fs-4 fw-bold text-success">@Model.IndexedCount</div>
                            </div>
                        </div>
                        <div class="col-6 col-sm-3">
                            <div class="p-2.5 border rounded-3 bg-light">
                                <div class="small text-slate-500 mb-1">Thất bại</div>
                                <div class="fs-4 fw-bold text-danger">@Model.FailedCount</div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="col-lg-6">
            <div class="academic-card h-100 p-0 overflow-hidden">
                <div class="p-3 border-bottom">
                    <h3 class="fw-bold fs-5 text-slate-900 mb-0">
                        <i class="bi bi-diagram-2 text-primary me-1"></i>Phân Bố Tài Liệu Theo Chương
                    </h3>
                </div>
                @if (Model.DocumentsByChapter.Count == 0)
                {
                    <div class="text-center py-4 text-slate-500">
                        Chưa có chương môn học nào được tạo.
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-academic align-middle mb-0">
                            <thead>
                                <tr>
                                    <th scope="col" class="ps-3" style="width: 110px;">Chương</th>
                                    <th scope="col">Tên chương</th>
                                    <th scope="col" class="text-end pe-3" style="width: 140px;">Tài liệu</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.DocumentsByChapter)
                                {
                                    <tr>
                                        <td class="ps-3 fw-bold font-monospace">Chương @item.Number</td>
                                        <td class="text-slate-800">@item.Title</td>
                                        <td class="text-end pe-3">
                                            <a asp-controller="Documents" asp-action="Index" asp-route-selectedChapterId="@item.Id"
                                               class="badge bg-light text-primary border border-primary-subtle text-decoration-none px-2.5 py-1">
                                                @item.DocumentCount tài liệu
                                            </a>
                                        </td>
                                    </tr>
                                }
                                @if (Model.UnassignedDocuments > 0)
                                {
                                    <tr class="table-warning">
                                        <td class="ps-3 fw-bold text-slate-500">—</td>
                                        <td class="text-slate-600 fst-italic">Tài liệu chưa phân vào chương</td>
                                        <td class="text-end pe-3">
                                            <span class="badge bg-warning text-dark">@Model.UnassignedDocuments tài liệu</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- 3. Recently Indexed Documents -->
    @if (Model.RecentlyIndexed.Count > 0)
    {
        <div class="academic-card p-0 overflow-hidden mb-4">
            <div class="p-3 border-bottom d-flex justify-content-between align-items-center">
                <h3 class="fw-bold fs-5 text-slate-900 mb-0">
                    <i class="bi bi-check-circle text-success me-1"></i>Tài Liệu Đã Index Thành Công Gần Đây
                </h3>
                <span class="status-pill status-indexed">@Model.IndexedCount tài liệu hoàn tất</span>
            </div>
            <div class="table-responsive">
                <table class="table table-academic align-middle mb-0">
                    <thead>
                        <tr>
                            <th scope="col" class="ps-3">Tên tài liệu</th>
                            <th scope="col" class="text-center">Số Chunks Vector</th>
                            <th scope="col" class="pe-3 text-end">Thời điểm Index</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var doc in Model.RecentlyIndexed)
                        {
                            <tr>
                                <td class="ps-3">
                                    <a asp-controller="Documents" asp-action="Details" asp-route-id="@doc.DocumentId" class="fw-bold text-slate-900 text-decoration-none">
                                        @doc.Title
                                    </a>
                                    <div class="small font-monospace text-slate-500">@doc.OriginalFileName</div>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2.5 py-1 font-monospace fw-bold">
                                        @doc.ChunkCount chunks
                                    </span>
                                </td>
                                <td class="pe-3 text-end small text-slate-500 font-monospace">
                                    @doc.IndexedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
