@page
@model PRN222.RagAssistant.Pages.Reports.IndexModel
@{
    ViewData["Title"] = $"Báo cáo & Thống kê - {Model.SubjectCode}";
    var totalIndexStates = Model.UploadedCount + Model.ProcessingCount + Model.IndexedCount + Model.FailedCount;
    var indexedPercent = totalIndexStates > 0 ? (int)Math.Round(Model.IndexedCount * 100.0 / totalIndexStates) : 0;
    var maxDailyMessages = Model.DailyActivityLast7Days.Count > 0
        ? Math.Max(1, Model.DailyActivityLast7Days.Max(item => item.UserMessages + item.AssistantMessages))
        : 1;
    var maxDailyCitations = Model.DailyActivityLast7Days.Count > 0
        ? Math.Max(1, Model.DailyActivityLast7Days.Max(item => item.CitationCount))
        : 1;
    var maxDocumentCitations = Model.TopCitedDocuments.Count > 0
        ? Math.Max(1, Model.TopCitedDocuments.Max(item => item.CitationCount))
        : 1;
    var maxChapterCitations = Model.TopCitedChapters.Count > 0
        ? Math.Max(1, Model.TopCitedChapters.Max(item => item.CitationCount))
        : 1;
}

<div class="container py-4">
    <div class="academic-breadcrumb mb-3">
        <a asp-page="/Index"><i class="bi bi-house-door"></i> Trang chủ</a>
        <span class="academic-breadcrumb-separator">/</span>
        <a asp-page="/Subjects/Index">Môn học</a>
        <span class="academic-breadcrumb-separator">/</span>
        <span class="text-slate-800 fw-semibold">Báo cáo @Model.SubjectCode</span>
    </div>

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4 pb-2 border-bottom">
        <div>
            <div class="badge bg-primary-subtle text-primary border border-primary-subtle px-2.5 py-1 mb-1 font-monospace">@Model.SubjectCode</div>
            <h1 class="fw-bold fs-3 text-slate-900 mb-1">
                <i class="bi bi-bar-chart-line-fill text-primary me-2"></i>Báo Cáo &amp; Thống Kê Học Thuật
            </h1>
            <p class="text-slate-500 mb-0">@Model.SubjectName — Theo dõi sức khỏe corpus, mức sử dụng nguồn học liệu và hoạt động RAG theo đúng phạm vi môn học.</p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a asp-page="/Documents/Index" asp-route-subjectId="@Model.SubjectId" class="btn btn-sm btn-academic-outline">
                <i class="bi bi-journal-bookmark"></i> Tài liệu
            </a>
            <a asp-page="/Chapters/Index" asp-route-subjectId="@Model.SubjectId" class="btn btn-sm btn-academic-outline">
                <i class="bi bi-list-nested"></i> Chương
            </a>
            <a asp-page="/Subjects/Index" class="btn btn-sm btn-academic-outline">
                <i class="bi bi-grid"></i> Danh mục môn học
            </a>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="academic-card h-100">
                <div class="d-flex justify-content-between align-items-start gap-2">
                    <div>
                        <div class="text-uppercase text-slate-500 fw-bold small mb-1">Corpus học liệu</div>
                        <div class="stat-value text-primary">@Model.TotalDocuments</div>
                    </div>
                    <i class="bi bi-collection fs-3 text-primary"></i>
                </div>
                <div class="small text-slate-500 mt-2">@Model.TotalChapters chương • @Model.TotalChunks chunks • @Model.AverageChunksPerIndexedDocument.ToString("0.##") chunks/tài liệu indexed</div>
                @if (Model.UnassignedDocuments > 0)
                {
                    <div class="small text-warning fw-semibold mt-1">@Model.UnassignedDocuments tài liệu chưa gán chương</div>
                }
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="academic-card h-100">
                <div class="d-flex justify-content-between align-items-start gap-2">
                    <div>
                        <div class="text-uppercase text-slate-500 fw-bold small mb-1">Câu hỏi người học</div>
                        <div class="stat-value text-slate-900">@Model.UserQuestionCount</div>
                    </div>
                    <i class="bi bi-patch-question fs-3 text-primary"></i>
                </div>
                <div class="small text-slate-500 mt-2">@Model.TotalChatSessions phiên • @Model.AverageMessagesPerSession.ToString("0.##") tin nhắn/phiên</div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="academic-card h-100">
                <div class="d-flex justify-content-between align-items-start gap-2">
                    <div>
                        <div class="text-uppercase text-slate-500 fw-bold small mb-1">Trích dẫn đã dùng</div>
                        <div class="stat-value text-success">@Model.TotalMessageCitations</div>
                    </div>
                    <i class="bi bi-quote fs-3 text-success"></i>
                </div>
                <div class="small text-slate-500 mt-2">@Model.UniqueCitedDocuments tài liệu khác nhau đã xuất hiện trong câu trả lời</div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="academic-card h-100">
                <div class="d-flex justify-content-between align-items-start gap-2">
                    <div>
                        <div class="text-uppercase text-slate-500 fw-bold small mb-1">Hoạt động gần đây</div>
                        <div class="stat-value text-slate-900">@Model.ActiveSessionsLast7Days</div>
                    </div>
                    <i class="bi bi-activity fs-3 text-primary"></i>
                </div>
                <div class="small text-slate-500 mt-2">phiên hoạt động 7 ngày • @Model.ActiveSessionsLast30Days phiên trong 30 ngày</div>
            </div>
        </div>
    </div>

    <div class="mb-4">
        <div class="d-flex justify-content-between align-items-end gap-3 mb-2">
            <div>
                <h2 class="fw-bold fs-5 text-slate-900 mb-1">Các tín hiệu có ý nghĩa thực tế</h2>
                <p class="small text-slate-500 mb-0">Mỗi chỉ số bên dưới đi kèm cách diễn giải để hỗ trợ quyết định quản trị học liệu và RAG.</p>
            </div>
        </div>
        <div class="row g-3">
            <div class="col-md-6 col-xl-3">
                <div class="academic-card h-100 border-start border-4 border-success">
                    <div class="small fw-bold text-slate-500 text-uppercase">Citation coverage</div>
                    <div class="fs-2 fw-bold text-success mt-1">@Model.CitationCoveragePercent.ToString("0.#")%</div>
                    <div class="small text-slate-700 fw-semibold mt-2">@Model.CitedAssistantResponseCount / @Model.AssistantResponseCount phản hồi có citation</div>
                    <div class="small text-slate-500 mt-2"><strong>Biết được:</strong> RAG có thường xuyên đưa bằng chứng đã lưu vào câu trả lời hay không.</div>
                </div>
            </div>
            <div class="col-md-6 col-xl-3">
                <div class="academic-card h-100 border-start border-4 border-primary">
                    <div class="small fw-bold text-slate-500 text-uppercase">Cited source coverage</div>
                    <div class="fs-2 fw-bold text-primary mt-1">@Model.CitedDocumentCoveragePercent.ToString("0.#")%</div>
                    <div class="small text-slate-700 fw-semibold mt-2">@Model.UniqueCitedDocuments nguồn đã được dùng</div>
                    <div class="small text-slate-500 mt-2"><strong>Biết được:</strong> corpus indexed có được khai thác rộng hay chỉ một phần nhỏ thường xuyên được retrieve.</div>
                </div>
            </div>
            <div class="col-md-6 col-xl-3">
                <div class="academic-card h-100 border-start border-4 @(Model.IndexedButNeverCitedDocuments > 0 ? "border-warning" : "border-success")">
                    <div class="small fw-bold text-slate-500 text-uppercase">Indexed nhưng chưa được dùng</div>
                    <div class="fs-2 fw-bold @(Model.IndexedButNeverCitedDocuments > 0 ? "text-warning" : "text-success") mt-1">@Model.IndexedButNeverCitedDocuments</div>
                    <div class="small text-slate-700 fw-semibold mt-2">tài liệu indexed chưa từng được citation</div>
                    <div class="small text-slate-500 mt-2"><strong>Biết được:</strong> nguồn có thể chưa phù hợp nhu cầu hỏi, khó retrieve hoặc cần kiểm tra metadata/chunking.</div>
                </div>
            </div>
            <div class="col-md-6 col-xl-3">
                <div class="academic-card h-100 border-start border-4 border-info">
                    <div class="small fw-bold text-slate-500 text-uppercase">Top-3 source concentration</div>
                    <div class="fs-2 fw-bold text-info mt-1">@Model.TopThreeCitationSharePercent.ToString("0.#")%</div>
                    <div class="small text-slate-700 fw-semibold mt-2">citation đến từ 3 tài liệu dẫn đầu</div>
                    <div class="small text-slate-500 mt-2"><strong>Biết được:</strong> hệ thống có đang phụ thuộc quá mạnh vào một nhóm nguồn nhỏ hay không.</div>
                </div>
            </div>
        </div>
    </div>

    <div class="alert alert-info border-info-subtle d-flex gap-3 align-items-start mb-4" role="alert">
        <i class="bi bi-info-circle-fill fs-5 mt-1"></i>
        <div class="small">
            <strong>Giới hạn diễn giải:</strong> Citation coverage đo việc hệ thống <em>gắn nguồn</em>, không chứng minh nội dung câu trả lời thực sự đúng hoặc trung thành với nguồn. Faithfulness, context precision/recall và answer relevance cần Evaluation/ground-truth hoặc LLM-judge riêng; trang này không gắn nhãn các proxy usage thành metric chất lượng semantic.
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-xl-7">
            <div class="academic-card h-100">
                <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3">
                    <div>
                        <h3 class="fw-bold fs-5 text-slate-900 mb-0"><i class="bi bi-graph-up-arrow text-primary me-1"></i>Hoạt động RAG 7 ngày gần nhất</h3>
                        <div class="small text-slate-500 mt-1">Nhu cầu hỏi và lượng bằng chứng được sử dụng theo ngày.</div>
                    </div>
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle">UTC</span>
                </div>
                <div class="d-flex flex-column gap-3">
                    @foreach (var day in Model.DailyActivityLast7Days)
                    {
                        var totalMessages = day.UserMessages + day.AssistantMessages;
                        var messageWidth = totalMessages == 0 ? 0 : Math.Max(4, (int)Math.Round(totalMessages * 100.0 / maxDailyMessages));
                        var citationWidth = day.CitationCount == 0 ? 0 : Math.Max(4, (int)Math.Round(day.CitationCount * 100.0 / maxDailyCitations));
                        <div>
                            <div class="d-flex justify-content-between gap-3 small mb-1">
                                <span class="fw-semibold text-slate-700">@day.DateUtc.ToString("dd/MM")</span>
                                <span class="text-slate-500">@day.UserMessages câu hỏi • @day.AssistantMessages phản hồi • @day.CitationCount citation</span>
                            </div>
                            <div class="progress mb-1" style="height: 9px;">
                                <div class="progress-bar" role="progressbar" style="width: @messageWidth%" aria-valuenow="@messageWidth" aria-valuemin="0" aria-valuemax="100" title="Tổng message"></div>
                            </div>
                            <div class="progress" style="height: 5px;">
                                <div class="progress-bar bg-success" role="progressbar" style="width: @citationWidth%" aria-valuenow="@citationWidth" aria-valuemin="0" aria-valuemax="100" title="Citation"></div>
                            </div>
                        </div>
                    }
                </div>
                <div class="small text-slate-500 mt-3"><span class="badge bg-primary me-1">&nbsp;</span> message <span class="badge bg-success ms-2 me-1">&nbsp;</span> citation</div>
            </div>
        </div>
        <div class="col-xl-5">
            <div class="academic-card h-100">
                <h3 class="fw-bold fs-5 text-slate-900 mb-3 pb-2 border-bottom"><i class="bi bi-chat-square-text text-primary me-1"></i>Hành vi phiên chat</h3>
                <div class="row g-3">
                    <div class="col-6">
                        <div class="p-3 rounded-3 border bg-light h-100">
                            <div class="small text-slate-500">Câu hỏi</div>
                            <div class="fs-3 fw-bold text-slate-900">@Model.UserQuestionCount</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-3 rounded-3 border bg-light h-100">
                            <div class="small text-slate-500">Phản hồi AI</div>
                            <div class="fs-3 fw-bold text-slate-900">@Model.AssistantResponseCount</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-3 rounded-3 border bg-light h-100">
                            <div class="small text-slate-500">Citation / phản hồi</div>
                            <div class="fs-3 fw-bold text-success">@Model.AverageCitationsPerAssistantResponse.ToString("0.##")</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-3 rounded-3 border bg-light h-100">
                            <div class="small text-slate-500">Message / phiên</div>
                            <div class="fs-3 fw-bold text-primary">@Model.AverageMessagesPerSession.ToString("0.##")</div>
                        </div>
                    </div>
                </div>
                <div class="small text-slate-500 mt-3"><strong>Biết được:</strong> mức sử dụng thực tế, độ dài hội thoại và mật độ bằng chứng mà assistant đang cung cấp.</div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-xl-7">
            <div class="academic-card h-100 p-0 overflow-hidden">
                <div class="p-3 border-bottom">
                    <h3 class="fw-bold fs-5 text-slate-900 mb-1"><i class="bi bi-trophy text-warning me-1"></i>Tài liệu được trích dẫn nhiều nhất</h3>
                    <div class="small text-slate-500">Cho biết nguồn học liệu nào thực sự được RAG sử dụng trong câu trả lời.</div>
                </div>
                @if (Model.TopCitedDocuments.Count == 0)
                {
                    <div class="text-center py-5 text-slate-500">Chưa có citation nào để xếp hạng tài liệu.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-academic align-middle mb-0">
                            <thead>
                                <tr>
                                    <th class="ps-3">Nguồn</th>
                                    <th style="min-width: 180px;">Mức sử dụng</th>
                                    <th class="text-center">Phiên</th>
                                    <th class="text-center pe-3">Chunks</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var document in Model.TopCitedDocuments)
                                {
                                    var width = Math.Max(6, (int)Math.Round(document.CitationCount * 100.0 / maxDocumentCitations));
                                    <tr>
                                        <td class="ps-3">
                                            <a asp-page="/Documents/Details" asp-route-id="@document.DocumentId" class="fw-bold text-slate-900 text-decoration-none">@document.Title</a>
                                            <div class="small text-slate-500">
                                                @if (document.ChapterNumber.HasValue)
                                                {
                                                    <span>Chương @document.ChapterNumber — @document.ChapterTitle</span>
                                                }
                                                else
                                                {
                                                    <span>Chưa gán chương</span>
                                                }
                                            </div>
                                        </td>
                                        <td>
                                            <div class="d-flex justify-content-between small mb-1"><span>@document.CitationCount citation</span><span>@width%</span></div>
                                            <div class="progress" style="height: 7px;"><div class="progress-bar bg-success" style="width: @width%"></div></div>
                                        </td>
                                        <td class="text-center fw-semibold">@document.DistinctSessions</td>
                                        <td class="text-center pe-3 fw-semibold">@document.CitedChunkCount</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
        <div class="col-xl-5">
            <div class="academic-card h-100 p-0 overflow-hidden">
                <div class="p-3 border-bottom">
                    <h3 class="fw-bold fs-5 text-slate-900 mb-1"><i class="bi bi-bookmarks text-primary me-1"></i>Chương được RAG sử dụng nhiều</h3>
                    <div class="small text-slate-500">Citation theo chương là proxy cho chủ đề học tập đang được hỏi và retrieve nhiều.</div>
                </div>
                @if (Model.TopCitedChapters.Count == 0)
                {
                    <div class="text-center py-5 text-slate-500">Chưa có dữ liệu citation theo chương.</div>
                }
                else
                {
                    <div class="p-3 d-flex flex-column gap-3">
                        @foreach (var chapter in Model.TopCitedChapters)
                        {
                            var width = Math.Max(6, (int)Math.Round(chapter.CitationCount * 100.0 / maxChapterCitations));
                            <div>
                                <div class="d-flex justify-content-between gap-3 mb-1">
                                    <div>
                                        <div class="fw-semibold text-slate-800">@(chapter.Number.HasValue ? $"Chương {chapter.Number}: {chapter.Title}" : chapter.Title)</div>
                                        <div class="small text-slate-500">@chapter.CitedDocumentCount/@chapter.DocumentCount tài liệu trong nhóm đã được citation</div>
                                    </div>
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle align-self-start">@chapter.CitationCount</span>
                                </div>
                                <div class="progress" style="height: 7px;"><div class="progress-bar" style="width: @width%"></div></div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-lg-6">
            <div class="academic-card h-100">
                <h3 class="fw-bold fs-5 text-slate-900 mb-3 pb-2 border-bottom"><i class="bi bi-pie-chart text-primary me-1"></i>Sức khỏe Indexing</h3>
                @if (totalIndexStates == 0)
                {
                    <div class="text-center py-4 text-slate-500">Chưa có tài liệu nào trong môn học này.</div>
                }
                else
                {
                    <div class="mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="fw-bold small text-slate-800">Tỷ lệ tài liệu sẵn sàng retrieval</span>
                            <span class="status-pill status-indexed">@indexedPercent% (@Model.IndexedCount / @totalIndexStates)</span>
                        </div>
                        <div class="progress" style="height: 10px; border-radius: 9999px;">
                            <div class="progress-bar bg-success" role="progressbar" style="width: @indexedPercent%" aria-valuenow="@indexedPercent" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                    </div>
                    <div class="row text-center g-2">
                        <div class="col-6 col-sm-3"><div class="p-2.5 border rounded-3 bg-light"><div class="small text-slate-500 mb-1">Chờ Index</div><div class="fs-4 fw-bold text-slate-700">@Model.UploadedCount</div></div></div>
                        <div class="col-6 col-sm-3"><div class="p-2.5 border rounded-3 bg-light"><div class="small text-slate-500 mb-1">Đang xử lý</div><div class="fs-4 fw-bold text-primary">@Model.ProcessingCount</div></div></div>
                        <div class="col-6 col-sm-3"><div class="p-2.5 border rounded-3 bg-light"><div class="small text-slate-500 mb-1">Đã Index</div><div class="fs-4 fw-bold text-success">@Model.IndexedCount</div></div></div>
                        <div class="col-6 col-sm-3"><div class="p-2.5 border rounded-3 bg-light"><div class="small text-slate-500 mb-1">Thất bại</div><div class="fs-4 fw-bold text-danger">@Model.FailedCount</div></div></div>
                    </div>
                    <div class="small text-slate-500 mt-3"><strong>Biết được:</strong> bao nhiêu phần trăm corpus hiện có thể tham gia retrieval; failure hoặc backlog cao sẽ trực tiếp làm giảm phạm vi kiến thức khả dụng.</div>
                }
            </div>
        </div>
        <div class="col-lg-6">
            <div class="academic-card h-100 p-0 overflow-hidden">
                <div class="p-3 border-bottom">
                    <h3 class="fw-bold fs-5 text-slate-900 mb-1"><i class="bi bi-diagram-2 text-primary me-1"></i>Phân bố tài liệu theo chương</h3>
                    <div class="small text-slate-500">Đối chiếu độ phủ học liệu với bảng “chương được RAG sử dụng nhiều” phía trên.</div>
                </div>
                @if (Model.DocumentsByChapter.Count == 0)
                {
                    <div class="text-center py-4 text-slate-500">Chưa có chương môn học nào được tạo.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-academic align-middle mb-0">
                            <thead><tr><th class="ps-3" style="width: 110px;">Chương</th><th>Tên chương</th><th class="text-end pe-3" style="width: 140px;">Tài liệu</th></tr></thead>
                            <tbody>
                                @foreach (var item in Model.DocumentsByChapter)
                                {
                                    <tr>
                                        <td class="ps-3 fw-bold font-monospace">Chương @item.Number</td>
                                        <td class="text-slate-800">@item.Title</td>
                                        <td class="text-end pe-3">
                                            <a asp-page="/Documents/Index" asp-route-subjectId="@Model.SubjectId" asp-route-selectedChapterId="@item.Id" class="badge bg-light text-primary border border-primary-subtle text-decoration-none px-2.5 py-1">@item.DocumentCount tài liệu</a>
                                        </td>
                                    </tr>
                                }
                                @if (Model.UnassignedDocuments > 0)
                                {
                                    <tr class="table-warning"><td class="ps-3 fw-bold text-slate-500">—</td><td class="text-slate-600 fst-italic">Tài liệu chưa phân vào chương</td><td class="text-end pe-3"><span class="badge bg-warning text-dark">@Model.UnassignedDocuments tài liệu</span></td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    @if (Model.RecentFailures.Count > 0)
    {
        <div class="academic-card p-0 overflow-hidden mb-4">
            <div class="p-3 border-bottom d-flex justify-content-between align-items-center">
                <h3 class="fw-bold fs-5 text-danger mb-0"><i class="bi bi-exclamation-triangle text-danger me-1"></i>Lỗi Indexing gần đây</h3>
                <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2.5 py-1">@Model.RecentFailures.Count lỗi</span>
            </div>
            <div class="table-responsive">
                <table class="table table-academic align-middle mb-0">
                    <thead><tr><th class="ps-3">Tài liệu</th><th>Chi tiết lỗi</th><th class="pe-3 text-end">Thời gian tải lên</th></tr></thead>
                    <tbody>
                        @foreach (var fail in Model.RecentFailures)
                        {
                            <tr>
                                <td class="ps-3"><a asp-page="/Documents/Details" asp-route-id="@fail.DocumentId" class="fw-bold text-danger text-decoration-none">@fail.Title</a><div class="small font-monospace text-slate-500">@fail.OriginalFileName</div></td>
                                <td class="text-danger small font-monospace">@fail.IndexError</td>
                                <td class="pe-3 text-end small text-slate-500 font-monospace">@fail.UploadedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @if (Model.RecentlyIndexed.Count > 0)
    {
        <div class="academic-card p-0 overflow-hidden mb-4">
            <div class="p-3 border-bottom d-flex justify-content-between align-items-center">
                <h3 class="fw-bold fs-5 text-slate-900 mb-0"><i class="bi bi-check-circle text-success me-1"></i>Tài liệu index thành công gần đây</h3>
                <span class="status-pill status-indexed">@Model.IndexedCount tài liệu sẵn sàng</span>
            </div>
            <div class="table-responsive">
                <table class="table table-academic align-middle mb-0">
                    <thead><tr><th class="ps-3">Tên tài liệu</th><th class="text-center">Chunks vector</th><th class="pe-3 text-end">Thời điểm Index</th></tr></thead>
                    <tbody>
                        @foreach (var doc in Model.RecentlyIndexed)
                        {
                            <tr>
                                <td class="ps-3"><a asp-page="/Documents/Details" asp-route-id="@doc.DocumentId" class="fw-bold text-slate-900 text-decoration-none">@doc.Title</a><div class="small font-monospace text-slate-500">@doc.OriginalFileName</div></td>
                                <td class="text-center"><span class="badge bg-success-subtle text-success border border-success-subtle px-2.5 py-1 font-monospace fw-bold">@doc.ChunkCount chunks</span></td>
                                <td class="pe-3 text-end small text-slate-500 font-monospace">@doc.IndexedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
