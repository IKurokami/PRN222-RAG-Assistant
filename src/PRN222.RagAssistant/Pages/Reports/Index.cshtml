@page
@model PRN222.RagAssistant.Pages.Reports.IndexModel
@{
    ViewData["Title"] = $"Báo cáo & Thống kê - {Model.SubjectCode}";
    var totalIndexed = Model.UploadedCount + Model.ProcessingCount + Model.IndexedCount + Model.FailedCount;
    var indexedPercent = totalIndexed > 0 ? (int)Math.Round(Model.IndexedCount * 100.0 / totalIndexed) : 0;
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <div class="academic-breadcrumb mb-3">
        <a asp-page="/Index"><i class="bi bi-house-door"></i> Trang chủ</a>
        <span class="academic-breadcrumb-separator">/</span>
        <a asp-controller="Subjects" asp-action="Index">Môn học</a>
        <span class="academic-breadcrumb-separator">/</span>
        <span class="fw-semibold">Báo cáo @Model.SubjectCode</span>
    </div>

    <!-- Header Section -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4 pb-2 border-bottom">
        <div>
            <div class="badge bg-primary-subtle text-primary border border-primary-subtle px-2.5 py-1 mb-1 font-monospace rounded-pill">@Model.SubjectCode</div>
            <h1 class="fw-bold fs-3 text-dark mb-1">
                <i class="bi bi-bar-chart-line-fill text-primary me-2"></i>Báo Cáo &amp; Thống Kê
            </h1>
            <p class="text-muted small mb-0">@Model.SubjectName — Giám sát tổng quan dữ liệu bài giảng, hiệu năng vector embeddings và hoạt động RAG.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Documents" asp-action="Index" asp-route-subjectId="@Model.SubjectId" class="btn btn-sm btn-outline-secondary btn-press d-inline-flex align-items-center gap-1" style="border-radius: var(--radius-md); font-size: 0.85rem; font-weight: 600;">
                <i class="bi bi-journal-bookmark"></i> Tài liệu
            </a>
            <a asp-controller="Chapters" asp-action="Index" asp-route-subjectId="@Model.SubjectId" class="btn btn-sm btn-outline-secondary btn-press d-inline-flex align-items-center gap-1" style="border-radius: var(--radius-md); font-size: 0.85rem; font-weight: 600;">
                <i class="bi bi-list-nested"></i> Chương
            </a>
            <a asp-controller="Subjects" asp-action="Index" class="btn btn-sm btn-outline-secondary btn-press d-inline-flex align-items-center gap-1" style="border-radius: var(--radius-md); font-size: 0.85rem; font-weight: 600;">
                <i class="bi bi-grid"></i> Danh mục môn học
            </a>
        </div>
    </div>

    <!-- 1. Stats Row -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-lg-3">
            <div class="academic-card card-lift h-100 bg-white border rounded-4 shadow-sm p-3">
                <div class="text-uppercase text-muted fw-bold small mb-1" style="font-size: 0.72rem; letter-spacing: 0.06em;">Tổng Số Chương Học</div>
                <div class="stat-value text-dark fs-2 fw-bold font-monospace">@Model.TotalChapters</div>
                <div class="small text-muted mt-1">Chương trình môn @Model.SubjectCode</div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="academic-card card-lift h-100 bg-white border rounded-4 shadow-sm p-3">
                <div class="text-uppercase text-muted fw-bold small mb-1" style="font-size: 0.72rem; letter-spacing: 0.06em;">Tổng Số Tài Liệu</div>
                <div class="stat-value text-primary fs-2 fw-bold font-monospace">@Model.TotalDocuments</div>
                <div class="small text-muted mt-1">
                    @if (Model.UnassignedDocuments > 0)
                    {
                        <span class="text-warning fw-semibold">@Model.UnassignedDocuments tài liệu chưa gán chương</span>
                    }
                    else
                    {
                        <span>Đã phân loại đầy đủ</span>
                    }
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="academic-card card-lift h-100 bg-white border rounded-4 shadow-sm p-3">
                <div class="text-uppercase text-muted fw-bold small mb-1" style="font-size: 0.72rem; letter-spacing: 0.06em;">Tổng Vector Chunks</div>
                <div class="stat-value text-success fs-2 fw-bold font-monospace">@Model.TotalChunks</div>
                <div class="small text-muted mt-1">Lưu trữ trong pgvector</div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="academic-card card-lift h-100 bg-white border rounded-4 shadow-sm p-3">
                <div class="text-uppercase text-muted fw-bold small mb-1" style="font-size: 0.72rem; letter-spacing: 0.06em;">Hoạt Động RAG Chat</div>
                <div class="stat-value text-dark fs-2 fw-bold font-monospace">@Model.TotalChatSessions <span class="fs-6 fw-normal text-muted">phiên</span></div>
                <div class="small text-muted mt-1">@Model.TotalChatMessages tin nhắn • @Model.TotalMessageCitations trích dẫn</div>
            </div>
        </div>
    </div>

    <!-- 2. Progress & Distribution -->
    <div class="row g-4 mb-4">
        <div class="col-lg-6">
            <div class="academic-card card-lift h-100 bg-white border rounded-4 shadow-sm p-4">
                <h3 class="fw-bold fs-5 text-dark mb-3 pb-2 border-bottom">
                    <i class="bi bi-pie-chart text-primary me-1"></i>Trạng Thái Tiến Trình Indexing
                </h3>
                @if (totalIndexed == 0)
                {
                    <div class="text-center py-4 text-muted">
                        Chưa có tài liệu nào trong môn học này.
                    </div>
                }
                else
                {
                    <div class="mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="fw-bold small text-dark">Tỷ lệ hoàn thành Indexing AI:</span>
                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2.5 py-1 rounded-pill small">
                                <span class="pulse-badge-dot d-inline-block me-1" style="width: 6px; height: 6px;"></span>
                                @indexedPercent% (@Model.IndexedCount / @totalIndexed)
                            </span>
                        </div>
                        <div class="progress" style="height: 10px; border-radius: 9999px; background-color: var(--color-bg-secondary);">
                            <div class="progress-bar bg-success progress-bar-striped progress-bar-animated" role="progressbar" style="width: @indexedPercent%; border-radius: 9999px;" aria-valuenow="@indexedPercent" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                    </div>

                    <div class="row text-center g-2">
                        <div class="col-6 col-sm-3">
                            <div class="p-2.5 border rounded-3 bg-light">
                                <div class="small text-muted mb-1">Chờ Index</div>
                                <div class="fs-4 fw-bold text-secondary font-monospace">@Model.UploadedCount</div>
                            </div>
                        </div>
                        <div class="col-6 col-sm-3">
                            <div class="p-2.5 border rounded-3 bg-light">
                                <div class="small text-muted mb-1">Đang xử lý</div>
                                <div class="fs-4 fw-bold text-primary font-monospace">@Model.ProcessingCount</div>
                            </div>
                        </div>
                        <div class="col-6 col-sm-3">
                            <div class="p-2.5 border rounded-3 bg-light">
                                <div class="small text-muted mb-1">Đã Index</div>
                                <div class="fs-4 fw-bold text-success font-monospace">@Model.IndexedCount</div>
                            </div>
                        </div>
                        <div class="col-6 col-sm-3">
                            <div class="p-2.5 border rounded-3 bg-light">
                                <div class="small text-muted mb-1">Thất bại</div>
                                <div class="fs-4 fw-bold text-danger font-monospace">@Model.FailedCount</div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="col-lg-6">
            <div class="academic-card card-lift h-100 p-0 overflow-hidden bg-white border rounded-4 shadow-sm">
                <div class="p-3 border-bottom bg-light">
                    <h3 class="fw-bold fs-5 text-dark mb-0">
                        <i class="bi bi-diagram-2 text-primary me-1"></i>Phân Bố Tài Liệu Theo Chương
                    </h3>
                </div>
                @if (Model.DocumentsByChapter.Count == 0)
                {
                    <div class="text-center py-4 text-muted">
                        Chưa có chương môn học nào được tạo.
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead class="bg-light text-muted small text-uppercase" style="letter-spacing: 0.05em; border-bottom: 1px solid var(--color-border-warm);">
                                <tr>
                                    <th scope="col" class="ps-3 py-2.5" style="width: 110px;">Chương</th>
                                    <th scope="col" class="py-2.5">Tên chương</th>
                                    <th scope="col" class="text-end pe-3 py-2.5" style="width: 140px;">Tài liệu</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (var i = 0; i < Model.DocumentsByChapter.Count; i++)
                                {
                                    var item = Model.DocumentsByChapter[i];
                                    <tr class="stagger-row" style="animation-delay: @(i * 35)ms; border-bottom: 1px solid var(--color-border-subtle);">
                                        <td class="ps-3 fw-bold font-monospace text-primary">Chương @item.Number</td>
                                        <td class="text-dark">@item.Title</td>
                                        <td class="text-end pe-3">
                                            <a asp-controller="Documents" asp-action="Index" asp-route-subjectId="@Model.SubjectId" asp-route-selectedChapterId="@item.Id"
                                               class="badge bg-light text-primary border border-primary-subtle text-decoration-none px-2.5 py-1 rounded-pill btn-press">
                                                @item.DocumentCount tài liệu
                                            </a>
                                        </td>
                                    </tr>
                                }
                                @if (Model.UnassignedDocuments > 0)
                                {
                                    <tr class="table-warning">
                                        <td class="ps-3 fw-bold text-muted">—</td>
                                        <td class="text-muted fst-italic">Tài liệu chưa phân vào chương</td>
                                        <td class="text-end pe-3">
                                            <span class="badge bg-warning text-dark rounded-pill">@Model.UnassignedDocuments tài liệu</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- 3. Recent Failures -->
    @if (Model.RecentFailures.Count > 0)
    {
        <div class="academic-card card-lift p-0 overflow-hidden mb-4 bg-white border border-danger-subtle rounded-4 shadow-sm">
            <div class="p-3 border-bottom d-flex justify-content-between align-items-center bg-danger-subtle">
                <h3 class="fw-bold fs-5 text-danger mb-0">
                    <i class="bi bi-exclamation-triangle text-danger me-1"></i>Lỗi Indexing Gần Đây
                </h3>
                <span class="badge bg-danger text-white px-2.5 py-1 rounded-pill">@Model.RecentFailures.Count lỗi</span>
            </div>
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="bg-light text-muted small text-uppercase">
                        <tr>
                            <th scope="col" class="ps-3 py-2.5">Tài liệu</th>
                            <th scope="col" class="py-2.5">Chi tiết lỗi</th>
                            <th scope="col" class="pe-3 text-end py-2.5">Thời gian tải lên</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var fail in Model.RecentFailures)
                        {
                            <tr style="border-bottom: 1px solid var(--color-border-subtle);">
                                <td class="ps-3 py-2.5">
                                    <a asp-controller="Documents" asp-action="Details" asp-route-id="@fail.DocumentId" class="fw-bold text-danger text-decoration-none">
                                        @fail.Title
                                    </a>
                                    <div class="small font-monospace text-muted">@fail.OriginalFileName</div>
                                </td>
                                <td class="text-danger small font-monospace">@fail.IndexError</td>
                                <td class="pe-3 text-end small text-muted font-monospace">
                                    @fail.UploadedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <!-- 4. Recently Indexed Documents -->
    @if (Model.RecentlyIndexed.Count > 0)
    {
        <div class="academic-card card-lift p-0 overflow-hidden mb-4 bg-white border rounded-4 shadow-sm">
            <div class="p-3 border-bottom d-flex justify-content-between align-items-center bg-light">
                <h3 class="fw-bold fs-5 text-dark mb-0">
                    <i class="bi bi-check-circle text-success me-1"></i>Tài Liệu Đã Index Thành Công Gần Đây
                </h3>
                <span class="badge bg-success-subtle text-success border border-success-subtle px-2.5 py-1 rounded-pill">@Model.IndexedCount tài liệu hoàn tất</span>
            </div>
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="bg-light text-muted small text-uppercase">
                        <tr>
                            <th scope="col" class="ps-3 py-2.5">Tên tài liệu</th>
                            <th scope="col" class="text-center py-2.5">Số Chunks Vector</th>
                            <th scope="col" class="pe-3 text-end py-2.5">Thời điểm Index</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < Model.RecentlyIndexed.Count; i++)
                        {
                            var doc = Model.RecentlyIndexed[i];
                            <tr class="stagger-row" style="animation-delay: @(i * 35)ms; border-bottom: 1px solid var(--color-border-subtle);">
                                <td class="ps-3 py-2.5">
                                    <a asp-controller="Documents" asp-action="Details" asp-route-id="@doc.DocumentId" class="fw-bold text-dark text-decoration-none">
                                        @doc.Title
                                    </a>
                                    <div class="small font-monospace text-muted">@doc.OriginalFileName</div>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2.5 py-1 font-monospace fw-bold rounded-pill">
                                        @doc.ChunkCount chunks
                                    </span>
                                </td>
                                <td class="pe-3 text-end small text-muted font-monospace">
                                    @doc.IndexedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
