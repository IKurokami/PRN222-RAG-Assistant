@page
@model PRN222.RagAssistant.Pages.Billing.CreateModel
@{
    ViewData["Title"] = "Mua Thêm Quota Hỏi Đáp";
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <div class="academic-breadcrumb mb-3">
        <a asp-page="/Index"><i class="bi bi-house-door"></i> Trang chủ</a>
        <span class="academic-breadcrumb-separator">/</span>
        <span class="fw-semibold">Mua Quota RAG</span>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8 col-xl-7">
            <div class="academic-card bg-white border rounded-4 shadow-sm p-4">
                <div class="d-flex align-items-center justify-content-between mb-3 pb-3 border-bottom">
                    <div>
                        <h1 class="fw-bold fs-4 text-dark mb-1">
                            <i class="bi bi-credit-card-2-front text-primary me-2"></i>Nạp Thêm Quota RAG
                        </h1>
                        <p class="text-muted small mb-0">Thanh toán an toàn qua cổng VNPay (Sandbox Demo) để mở rộng số lượt truy vấn tài liệu.</p>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-light text-dark border px-3 py-2 rounded-pill font-monospace fs-6">
                            <i class="bi bi-coin text-warning me-1"></i>Số lượt còn lại: <strong>@Model.CurrentQuota</strong>
                        </span>
                        <a asp-page="/Billing/History" class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1 rounded-pill px-3">
                            <i class="bi bi-clock-history"></i> Lịch sử
                        </a>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(Model.Message))
                {
                    <div class="alert alert-warning alert-dismissible fade show d-flex align-items-center gap-2 mb-4" role="alert">
                        <i class="bi bi-exclamation-triangle-fill fs-5 text-warning flex-shrink-0"></i>
                        <div>@Model.Message</div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small mb-3"></div>

                    <div class="mb-4">
                        <label class="form-label fw-bold text-dark mb-2">Chọn gói câu hỏi:</label>
                        <div class="row g-3">
                            @foreach (var plan in Model.Plans)
                            {
                                <div class="col-md-4">
                                    <label class="card h-100 p-3 text-center border rounded-3 plan-card" style="cursor: pointer;">
                                        <input type="radio" asp-for="Input.PlanId" value="@plan.Id" class="form-check-input mb-2 mx-auto" />
                                        <div class="fw-bold text-primary fs-5 font-monospace">@plan.AmountDisplay</div>
                                        <div class="fw-semibold text-dark my-1">@plan.Name</div>
                                        <div class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill mx-auto">
                                            @plan.Queries lượt hỏi
                                        </div>
                                    </label>
                                </div>
                            }
                        </div>
                        <span asp-validation-for="Input.PlanId" class="text-danger small d-block mt-1"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Input.Description" class="form-label fw-bold text-dark">Ghi chú thanh toán (Tùy chọn):</label>
                        <input asp-for="Input.Description" class="form-control" placeholder="Ví dụ: Nạp câu hỏi ôn thi PRN222..." />
                        <span asp-validation-for="Input.Description" class="text-danger small"></span>
                    </div>

                    <div class="p-3 bg-light border rounded-3 mb-4">
                        <div class="d-flex align-items-center gap-2 text-muted small mb-1">
                            <i class="bi bi-shield-check text-success fs-5"></i>
                            <span>Môi trường thử nghiệm <strong>VNPay Sandbox</strong> — Sử dụng thẻ demo NCB để thanh toán.</span>
                        </div>
                        <div class="d-flex align-items-center gap-2 text-muted small">
                            <i class="bi bi-lightning-charge text-warning fs-5"></i>
                            <span>Hệ thống tự động kích hoạt lượt hỏi ngay sau khi nhận phản hồi từ VNPay.</span>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary btn-press d-inline-flex align-items-center gap-2 px-4 py-2 rounded-pill fw-semibold">
                            <i class="bi bi-lock-fill"></i> Tiến hành thanh toán qua VNPay
                        </button>
                        <a asp-page="/Index" class="btn btn-outline-secondary btn-press d-inline-flex align-items-center px-3 py-2 rounded-pill">
                            Hủy bỏ
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
