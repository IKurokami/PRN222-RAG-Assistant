@page
@model PRN222.RagAssistant.Pages.Billing.DetailsModel
@{
    ViewData["Title"] = "Chi Tiết Đơn Hàng " + (Model.Order?.ExternalOrderId ?? "");
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <div class="academic-breadcrumb mb-3">
        <a asp-page="/Index"><i class="bi bi-house-door"></i> Trang chủ</a>
        <span class="academic-breadcrumb-separator">/</span>
        <a asp-page="/Billing/History">Lịch sử giao dịch</a>
        <span class="academic-breadcrumb-separator">/</span>
        <span class="fw-semibold">Chi tiết đơn hàng</span>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8 col-xl-7">
            @if (Model.Order is null)
            {
                <div class="academic-card bg-white border rounded-4 shadow-sm p-4 text-center">
                    <i class="bi bi-receipt-cutoff fs-1 text-muted d-block mb-3"></i>
                    <h2 class="fs-5 fw-bold text-dark mb-2">Không tìm thấy đơn hàng</h2>
                    <p class="text-muted small mb-3">Đơn hàng không tồn tại hoặc bạn không có quyền xem thông tin này.</p>
                    <a asp-page="/Billing/History" class="btn btn-outline-secondary rounded-pill px-4">Quay lại danh sách</a>
                </div>
            }
            else
            {
                <div class="academic-card bg-white border rounded-4 shadow-sm p-4">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4 pb-3 border-bottom">
                        <div>
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill font-monospace mb-1">
                                VNPay Gateway
                            </span>
                            <h1 class="fw-bold fs-4 text-dark mb-0">Đơn hàng @Model.Order.ExternalOrderId</h1>
                        </div>
                        <div>
                            @if (string.Equals(Model.Order.Status, "Paid", StringComparison.Ordinal))
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill fw-semibold">
                                    <i class="bi bi-check-circle-fill me-1"></i>Đã thanh toán
                                </span>
                            }
                            else if (string.Equals(Model.Order.Status, "Failed", StringComparison.Ordinal))
                            {
                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-2 rounded-pill fw-semibold">
                                    <i class="bi bi-x-circle-fill me-1"></i>Thất bại
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-3 py-2 rounded-pill fw-semibold">
                                    <i class="bi bi-hourglass-split me-1"></i>@Model.Order.Status
                                </span>
                            }
                        </div>
                    </div>

                    <div class="p-3 bg-light border rounded-3 mb-4">
                        <div class="row g-3 small">
                            <div class="col-sm-4 text-muted">Số tiền thanh toán:</div>
                            <div class="col-sm-8 fw-bold fs-5 text-primary font-monospace">
                                @(Model.Order.Amount.ToString("N0", System.Globalization.CultureInfo.CreateSpecificCulture("vi-VN"))) @Model.Order.Currency
                            </div>

                            <div class="col-sm-4 text-muted">Thời gian khởi tạo:</div>
                            <div class="col-sm-8 text-dark font-monospace">@Model.Order.CreatedUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</div>

                            <div class="col-sm-4 text-muted">Thời gian thanh toán:</div>
                            <div class="col-sm-8 text-dark font-monospace">@(Model.Order.PaidUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss") ?? "—")</div>

                            <div class="col-sm-4 text-muted">Mã GD VNPay:</div>
                            <div class="col-sm-8 text-dark font-monospace">@(Model.Order.ExternalTransactionNo ?? "—")</div>

                            <div class="col-sm-4 text-muted">Ngân hàng / Cổng:</div>
                            <div class="col-sm-8 text-dark">@(Model.Order.BankCode ?? "—")</div>

                            <div class="col-sm-4 text-muted">Loại thẻ:</div>
                            <div class="col-sm-8 text-dark">@(Model.Order.CardType ?? "—")</div>

                            <div class="col-sm-4 text-muted">Mã phản hồi VNPay:</div>
                            <div class="col-sm-8 text-dark font-monospace">@(Model.Order.ExternalResponseCode ?? "—")</div>

                            @if (!string.IsNullOrEmpty(Model.Order.ErrorMessage))
                            {
                                <div class="col-sm-4 text-danger">Ghi chú lỗi:</div>
                                <div class="col-sm-8 text-danger">@Model.Order.ErrorMessage</div>
                            }
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center">
                        <a asp-page="/Billing/History" class="btn btn-outline-secondary btn-press d-inline-flex align-items-center gap-1 rounded-pill px-3 py-2">
                            <i class="bi bi-arrow-left"></i> Danh sách giao dịch
                        </a>
                        <a asp-page="/Billing/Create" class="btn btn-primary btn-press d-inline-flex align-items-center gap-1 rounded-pill px-4 py-2">
                            <i class="bi bi-plus-circle"></i> Nạp thêm quota
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
