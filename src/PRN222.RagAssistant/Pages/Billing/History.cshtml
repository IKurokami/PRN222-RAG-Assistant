@page
@model PRN222.RagAssistant.Pages.Billing.HistoryModel
@{
    ViewData["Title"] = "Lịch Sử Giao Dịch";
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <div class="academic-breadcrumb mb-3">
        <a asp-page="/Index"><i class="bi bi-house-door"></i> Trang chủ</a>
        <span class="academic-breadcrumb-separator">/</span>
        <a asp-page="/Billing/Create">Mua Quota</a>
        <span class="academic-breadcrumb-separator">/</span>
        <span class="fw-semibold">Lịch sử giao dịch</span>
    </div>

    <div class="academic-card bg-white border rounded-4 shadow-sm p-4">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4 pb-3 border-bottom">
            <div>
                <h1 class="fw-bold fs-4 text-dark mb-1">
                    <i class="bi bi-clock-history text-primary me-2"></i>Lịch Sử Giao Dịch &amp; Nạp Quota
                </h1>
                <p class="text-muted small mb-0">Theo dõi toàn bộ các đơn hàng nạp lượt hỏi qua cổng VNPay của bạn.</p>
            </div>
            <a asp-page="/Billing/Create" class="btn btn-primary btn-press d-inline-flex align-items-center gap-1 rounded-pill px-4 py-2">
                <i class="bi bi-plus-circle"></i> Nạp thêm quota
            </a>
        </div>

        @if (Model.Orders.Count == 0)
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-receipt-cutoff fs-1 d-block mb-3 text-secondary opacity-50"></i>
                <h3 class="fs-5 fw-bold text-dark mb-2">Chưa có giao dịch nào</h3>
                <p class="small mb-3">Bạn chưa thực hiện đơn thanh toán nào trên hệ thống.</p>
                <a asp-page="/Billing/Create" class="btn btn-outline-primary btn-press rounded-pill px-4">Nạp quota ngay</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="bg-light text-muted small text-uppercase">
                        <tr>
                            <th scope="col" class="ps-3 py-2.5">Thời gian</th>
                            <th scope="col" class="py-2.5">Mã đơn hàng</th>
                            <th scope="col" class="text-end py-2.5">Số tiền</th>
                            <th scope="col" class="text-center py-2.5">Trạng thái</th>
                            <th scope="col" class="py-2.5">Mã GD VNPay</th>
                            <th scope="col" class="text-end pe-3 py-2.5">Chi tiết</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model.Orders)
                        {
                            <tr style="border-bottom: 1px solid var(--color-border-subtle);">
                                <td class="ps-3 small font-monospace">@order.CreatedUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    <div class="fw-bold font-monospace text-dark small">@order.ExternalOrderId</div>
                                </td>
                                <td class="text-end fw-bold font-monospace text-primary">@order.AmountDisplay</td>
                                <td class="text-center">
                                    @if (string.Equals(order.Status, "Paid", StringComparison.Ordinal))
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2.5 py-1 rounded-pill small">
                                            <i class="bi bi-check-circle-fill me-1"></i>Thành công
                                        </span>
                                    }
                                    else if (string.Equals(order.Status, "Failed", StringComparison.Ordinal))
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2.5 py-1 rounded-pill small">
                                            <i class="bi bi-x-circle-fill me-1"></i>Thất bại
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2.5 py-1 rounded-pill small">
                                            <i class="bi bi-hourglass-split me-1"></i>@order.Status
                                        </span>
                                    }
                                </td>
                                <td class="small font-monospace text-muted">@(order.ExternalTransactionNo ?? "—")</td>
                                <td class="text-end pe-3">
                                    <a asp-page="/Billing/Details" asp-route-orderId="@order.Id" class="btn btn-sm btn-outline-secondary rounded-pill px-2.5 py-1">
                                        <i class="bi bi-eye"></i> Xem
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
