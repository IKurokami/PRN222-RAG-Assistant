@page
@model PRN222.RagAssistant.Pages.Billing.ReturnModel
@{
    ViewData["Title"] = "Kết Quả Giao Dịch VNPay";
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <div class="academic-breadcrumb mb-3">
        <a asp-page="/Index"><i class="bi bi-house-door"></i> Trang chủ</a>
        <span class="academic-breadcrumb-separator">/</span>
        <a asp-page="/Billing/Create">Mua Quota</a>
        <span class="academic-breadcrumb-separator">/</span>
        <span class="fw-semibold">Kết quả thanh toán</span>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-7 col-xl-6">
            <div class="academic-card bg-white border rounded-4 shadow-sm p-4 text-center">
                @if (Model.ErrorMessage is not null)
                {
                    <div class="mb-3">
                        <div class="badge bg-danger-subtle text-danger p-3 rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 64px; height: 64px;">
                            <i class="bi bi-exclamation-triangle-fill fs-2"></i>
                        </div>
                        <h1 class="fw-bold fs-4 text-danger mb-2">Giao dịch không hợp lệ</h1>
                        <p class="text-muted small">@Model.ErrorMessage</p>
                    </div>
                }
                else if (Model.OrderStatus?.Status == "Paid")
                {
                    <div class="mb-3">
                        <div class="badge bg-success-subtle text-success p-3 rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 64px; height: 64px;">
                            <i class="bi bi-check-circle-fill fs-2"></i>
                        </div>
                        <h1 class="fw-bold fs-4 text-success mb-2">Thanh toán thành công!</h1>
                        <p class="text-muted small">Quota câu hỏi đã được kích hoạt trên hệ thống của bạn.</p>
                    </div>

                    <div class="p-3 bg-light border rounded-3 text-start mb-4">
                        <div class="row g-2 small">
                            <div class="col-5 text-muted">Mã đơn hàng:</div>
                            <div class="col-7 fw-bold font-monospace text-dark">@Model.OrderStatus.ExternalOrderId</div>

                            <div class="col-5 text-muted">Số tiền:</div>
                            <div class="col-7 fw-bold text-primary font-monospace">@((Model.OrderStatus.Amount).ToString("N0", System.Globalization.CultureInfo.CreateSpecificCulture("vi-VN"))) @Model.OrderStatus.Currency</div>

                            <div class="col-5 text-muted">Mã GD VNPay:</div>
                            <div class="col-7 font-monospace text-dark">@(Model.OrderStatus.ExternalTransactionNo ?? "—")</div>

                            <div class="col-5 text-muted">Ngân hàng:</div>
                            <div class="col-7 text-dark">@(Model.OrderStatus.BankCode ?? "—")</div>

                            <div class="col-5 text-muted">Thời gian:</div>
                            <div class="col-7 text-dark">@(Model.OrderStatus.PaidUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss") ?? "—")</div>
                        </div>
                    </div>
                }
                else if (Model.OrderStatus?.Status == "Pending")
                {
                    <div class="mb-3">
                        <div class="badge bg-warning-subtle text-warning p-3 rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 64px; height: 64px;">
                            <i class="bi bi-hourglass-split fs-2"></i>
                        </div>
                        <h1 class="fw-bold fs-4 text-dark mb-2">Đang xác nhận thanh toán</h1>
                        <p class="text-muted small mb-1">VNPay đã trả kết quả hợp lệ nhưng hệ thống vẫn đang chờ trạng thái cuối cùng.</p>
                        <p class="text-muted small">Mã phản hồi: @(Model.OrderStatus.ExternalResponseCode ?? "Không xác định"). Bạn có thể mở lịch sử giao dịch để kiểm tra lại.</p>
                    </div>
                }
                else
                {
                    <div class="mb-3">
                        <div class="badge bg-warning-subtle text-warning p-3 rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 64px; height: 64px;">
                            <i class="bi bi-x-circle-fill fs-2"></i>
                        </div>
                        <h1 class="fw-bold fs-4 text-dark mb-2">Thanh toán chưa hoàn tất</h1>
                        <p class="text-muted small">Giao dịch đã bị hủy hoặc không thành công (Mã phản hồi: @(Model.OrderStatus?.ExternalResponseCode ?? "Không xác định")).</p>
                    </div>
                }

                <div class="d-flex justify-content-center flex-wrap gap-2 mt-4">
                    <a asp-page="/Billing/History" class="btn btn-outline-secondary btn-press d-inline-flex align-items-center gap-1 rounded-pill px-3 py-2">
                        <i class="bi bi-clock-history"></i> Lịch sử đơn hàng
                    </a>
                    <a asp-page="/Billing/Create" class="btn btn-primary btn-press d-inline-flex align-items-center gap-1 rounded-pill px-4 py-2">
                        <i class="bi bi-plus-circle"></i> Nạp thêm quota
                    </a>
                    <a asp-page="/Chat/Index" class="btn btn-success btn-press d-inline-flex align-items-center gap-1 rounded-pill px-3 py-2">
                        <i class="bi bi-chat-dots-fill"></i> Vào hỏi RAG
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
