@page
@model PRN222.RagAssistant.Pages.ErrorModel
@{
    ViewData["Title"] = "Đã xảy ra lỗi";
}

<div class="container system-message-page">
    <div class="system-message-code">500</div>
    <p class="system-message-kicker">Không thể hoàn tất yêu cầu</p>
    <h1>Đã xảy ra lỗi trong quá trình xử lý.</h1>
    <p>Vui lòng quay lại trang trước hoặc thử lại sau. Không có thay đổi nào được xác nhận từ yêu cầu bị lỗi.</p>
    @if (Model.ShowRequestId)
    {
        <p class="system-request-id">Mã yêu cầu: <code>@Model.RequestId</code></p>
    }
    <div class="system-message-actions">
        <a asp-page="/Index" class="btn-academic-primary">Về trang chủ</a>
    </div>
</div>
