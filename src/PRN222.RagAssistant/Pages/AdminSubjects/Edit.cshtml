@page "/admin/subjects/{id:guid}/edit"
@model PRN222.RagAssistant.Pages.AdminSubjects.EditModel
@{
    ViewData["Title"] = $"Chỉnh Sửa Môn {Model.Input.Code} - Admin";
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <div class="academic-breadcrumb mb-3">
        <a asp-page="/Index"><i class="bi bi-house-door"></i> Trang chủ</a>
        <span class="academic-breadcrumb-separator">/</span>
        <a asp-page="/AdminSubjects/Index">Quản trị môn học</a>
        <span class="academic-breadcrumb-separator">/</span>
        <span class="text-slate-800 fw-semibold">Sửa môn @Model.Input.Code</span>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-7 col-xl-6">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h1 class="fw-bold fs-3 text-slate-900 mb-1">
                        <i class="bi bi-pencil-square text-primary me-2"></i>Chỉnh Sửa Môn Học
                    </h1>
                    <p class="text-slate-500 mb-0">Cập nhật thông tin mã môn, tên môn và trạng thái hoạt động.</p>
                </div>
                <a asp-page="/AdminSubjects/Index" class="btn btn-sm btn-academic-outline">
                    <i class="bi bi-arrow-left"></i> Quay lại
                </a>
            </div>

            <div class="academic-card shadow-sm">
                <form method="post">
                    <input type="hidden" name="Id" value="@Model.Id" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger d-flex align-items-center gap-2 mb-4" role="alert"></div>

                    <div class="mb-4">
                        <label asp-for="Input.Code" class="form-label fw-bold text-slate-800">
                            Mã môn học <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Input.Code" class="form-control font-monospace" />
                        <span asp-validation-for="Input.Code" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Input.Name" class="form-label fw-bold text-slate-800">
                            Tên đầy đủ của môn học <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Input.Name" class="form-control" />
                        <span asp-validation-for="Input.Name" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="form-check form-switch mb-4">
                        <input asp-for="Input.IsActive" class="form-check-input" type="checkbox" role="switch" id="isActiveSwitch" />
                        <label class="form-check-label fw-semibold text-slate-800" for="isActiveSwitch">Kích hoạt môn học</label>
                        <div class="form-text text-slate-500">Tắt cờ này sẽ ẩn môn khỏi Sinh viên nhưng Quản trị viên và Trưởng môn vẫn có thể quản lý.</div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a asp-page="/AdminSubjects/Index" class="btn btn-academic-outline">Hủy bỏ</a>
                        <button type="submit" class="btn-academic-primary px-4">
                            <i class="bi bi-check2"></i> Lưu thay đổi
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
