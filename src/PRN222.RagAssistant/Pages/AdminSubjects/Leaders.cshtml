@page "/admin/subjects/{id:guid}/leaders"
@model PRN222.RagAssistant.Pages.AdminSubjects.LeadersModel
@{
    ViewData["Title"] = $"Phân Trưởng Môn - {Model.SubjectCode}";
}

<div class="container py-4"
     data-management-realtime
     data-realtime-scope="subject"
     data-subject-id="@Model.SubjectId">
    <!-- Breadcrumb -->
    <div class="academic-breadcrumb mb-3">
        <a asp-page="/Index"><i class="bi bi-house-door"></i> Trang chủ</a>
        <span class="academic-breadcrumb-separator">/</span>
        <a asp-page="/AdminSubjects/Index">Quản trị môn học</a>
        <span class="academic-breadcrumb-separator">/</span>
        <span class="text-slate-800 fw-semibold">Phân công Leader @Model.SubjectCode</span>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <div class="badge bg-primary-subtle text-primary border border-primary-subtle px-2.5 py-1 mb-1 font-monospace">@Model.SubjectCode — @Model.SubjectName</div>
                    <h1 class="fw-bold fs-3 text-slate-900 mb-1">
                        <i class="bi bi-person-gear text-primary me-2"></i>Phân Công Trưởng Môn (Subject Leader)
                    </h1>
                </div>
                <a asp-page="/AdminSubjects/Index" class="btn btn-sm btn-academic-outline">
                    <i class="bi bi-arrow-left"></i> Quay lại
                </a>
            </div>

            <div class="alert alert-info d-flex align-items-center gap-2 shadow-xs mb-4" role="alert">
                <i class="bi bi-info-circle-fill text-info fs-5 flex-shrink-0"></i>
                <div class="small">
                    Một Trưởng môn có thể phụ trách nhiều môn học. Chỉ những môn được tích chọn dưới đây mới trao quyền cho Trưởng môn đó quản lý Chương học, Tài liệu và Báo cáo.
                </div>
            </div>

            <div class="academic-card shadow-sm">
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger d-flex align-items-center gap-2 mb-4" role="alert"></div>

                    @if (Model.Leaders.Count == 0)
                    {
                        <div class="text-center py-4 text-slate-500">
                            <i class="bi bi-person-x fs-2 d-block mb-2 text-slate-400"></i>
                            Chưa có tài khoản nào mang vai trò <strong>SubjectLeader</strong>.<br />
                            Hãy tạo người dùng mới hoặc điều chỉnh vai trò trong mục Quản lý người dùng.
                        </div>
                    }
                    else
                    {
                        <h5 class="fw-bold fs-6 text-slate-800 mb-3">Danh sách Trưởng môn trong hệ thống:</h5>
                        <div class="list-group mb-4">
                            @foreach (var leader in Model.Leaders)
                            {
                                <label class="list-group-item d-flex gap-3 align-items-center p-3 border rounded-3 mb-2 shadow-xs cursor-pointer">
                                    @if (leader.IsSelected)
                                    {
                                        <input class="form-check-input flex-shrink-0 fs-5 mt-0" type="checkbox" name="SelectedLeaderIds" value="@leader.UserId" checked />
                                    }
                                    else
                                    {
                                        <input class="form-check-input flex-shrink-0 fs-5 mt-0" type="checkbox" name="SelectedLeaderIds" value="@leader.UserId" />
                                    }
                                    <div class="flex-grow-1">
                                        <div class="fw-bold text-slate-900">@leader.DisplayName</div>
                                        <div class="small text-slate-500 font-monospace">@leader.Email</div>
                                    </div>
                                    <span class="badge bg-warning text-dark px-2.5 py-1">SubjectLeader</span>
                                </label>
                            }
                        </div>
                    }

                    <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                        <a asp-page="/AdminUsers/Index" class="btn btn-sm btn-academic-outline">
                            <i class="bi bi-people"></i> Quản lý người dùng
                        </a>
                        <button type="submit" class="btn-academic-primary px-4">
                            <i class="bi bi-check2"></i> Lưu phân công
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ManagementRealtimeScripts" />
}
