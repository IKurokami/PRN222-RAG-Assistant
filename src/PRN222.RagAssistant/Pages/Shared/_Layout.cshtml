@using Microsoft.AspNetCore.Http
@{
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var isHomePage = string.Equals(currentPage, "/Index", StringComparison.OrdinalIgnoreCase) && string.IsNullOrEmpty(currentController);
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PRN222 RAG Assistant</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/design-tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100 @(isHomePage ? "page-home" : "page-subpage")" style="background-color: var(--color-bg-warm);">
    <header>
        <nav class="navbar navbar-expand-lg @(isHomePage ? "navbar-humata" : "navbar-humata-solid")">
            <div class="container">
                <a class="brand-humata" asp-area="" asp-page="/Index">
                    <span class="brand-icon-humata">
                        <i class="bi bi-mortarboard-fill"></i>
                    </span>
                    <span>PRN222 RAG</span>
                </a>

                <button class="navbar-toggler border-0 shadow-none text-white" type="button" data-bs-toggle="collapse" data-bs-target="#navbarHumataMain" aria-controls="navbarHumataMain" aria-expanded="false" aria-label="Toggle navigation">
                    <i class="bi bi-list fs-2"></i>
                </button>

                <div class="collapse navbar-collapse" id="navbarHumataMain">
                    <ul class="navbar-nav mx-auto gap-1">
                        <li class="nav-item">
                            <a class="nav-link-humata" asp-area="" asp-page="/Index">Trang chủ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link-humata" asp-area="" asp-controller="Documents" asp-action="Index">Kho Tài Liệu</a>
                        </li>
                        @if (User.IsInRole("SubjectLeader"))
                        {
                            <li class="nav-item">
                                <a class="nav-link-humata" asp-area="" asp-controller="Chapters" asp-action="Index">Quản Lý Chương</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link-humata" asp-area="" asp-page="/Reports/Index">Báo Cáo &amp; Thống Kê</a>
                            </li>
                        }
                        <li class="nav-item">
                            <a class="nav-link-humata" href="/#pricing">Bảng giá</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link-humata" href="/#faq">Hỏi đáp (FAQ)</a>
                        </li>
                    </ul>

                    <div class="d-flex align-items-center gap-2 mt-3 mt-lg-0">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <div class="d-flex align-items-center gap-2 bg-white bg-opacity-10 text-white px-3 py-1.5 rounded-pill border border-white border-opacity-25">
                                <i class="bi bi-person-circle"></i>
                                <span class="fw-semibold small">@User.Identity.Name</span>
                                @if (User.IsInRole("SubjectLeader"))
                                {
                                    <span class="badge bg-warning text-dark rounded-pill px-2">Trưởng Môn</span>
                                }
                                else
                                {
                                    <span class="badge bg-primary text-white rounded-pill px-2">Sinh Viên</span>
                                }
                            </div>
                            <form method="post" asp-page="/Account/Logout" class="m-0">
                                <button type="submit" class="btn btn-sm btn-outline-light rounded-pill px-3">
                                    <i class="bi bi-box-arrow-right"></i> Đăng xuất
                                </button>
                            </form>
                        }
                        else
                        {
                            <a class="btn-humata-login" asp-page="/Account/Login">Đăng nhập</a>
                            <a class="btn-humata-signup" asp-page="/Account/Login">Trải nghiệm ngay</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="flex-grow-1">
        @RenderBody()
    </main>

    <footer class="footer-humata-deep mt-auto">
        <div class="container">
            <!-- Centered Brand Logo -->
            <a class="footer-brand-logo" asp-area="" asp-page="/Index">
                <span class="brand-icon-humata" style="width: 1.75rem; height: 1.75rem; font-size: 0.875rem;">
                    <i class="bi bi-mortarboard-fill"></i>
                </span>
                <span>PRN222 RAG</span>
            </a>

            <!-- Centered Nav Links -->
            <ul class="footer-nav-links">
                <li><a asp-area="" asp-page="/Index">Trang chủ</a></li>
                <li><a asp-area="" asp-controller="Documents" asp-action="Index">Kho Tài Liệu</a></li>
                <li><a href="/#pricing">Bảng giá</a></li>
                <li><a href="https://flm.fpt.edu.vn/gui/role/teacher/SyllabusDetails?sylID=13892" target="_blank" rel="noopener noreferrer">Đề cương FLM</a></li>
                <li><a asp-page="/Privacy">Điều khoản &amp; Bảo mật</a></li>
            </ul>

            <!-- Centered Social Icons -->
            <div class="footer-socials">
                <a href="#" aria-label="X (Twitter)"><i class="bi bi-twitter-x"></i></a>
                <a href="https://github.com" target="_blank" rel="noopener noreferrer" aria-label="GitHub"><i class="bi bi-github"></i></a>
                <a href="https://youtube.com" target="_blank" rel="noopener noreferrer" aria-label="YouTube"><i class="bi bi-youtube"></i></a>
            </div>

            <!-- Centered Copyright -->
            <div class="footer-copyright">
                &copy; 2026 PRN222 RAG Assistant — Đại Học FPT (FPT University). Toàn bộ quyền được bảo lưu.
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
