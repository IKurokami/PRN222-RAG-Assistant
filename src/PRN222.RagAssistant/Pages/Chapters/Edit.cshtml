@page "{id:guid}"
@model PRN222.RagAssistant.Pages.Chapters.EditModel
@{
    ViewData["Title"] = $"Sửa Chương {Model.OriginalNumber} - PRN222";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="mb-1">Sửa chương</h2>
                <p class="text-muted mb-0">Chương @Model.OriginalNumber: @Model.OriginalTitle</p>
            </div>
            <a asp-page="./Index" class="btn btn-outline-secondary">Quay lại</a>
        </div>

        <div class="card shadow-sm">
            <div class="card-body">
                <form method="post" asp-route-id="@RouteData.Values["id"]">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Input.Number" class="form-label fw-bold"></label>
                        <input asp-for="Input.Number" class="form-control" type="number" min="1" max="999" />
                        <span asp-validation-for="Input.Number" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Input.Title" class="form-label fw-bold"></label>
                        <input asp-for="Input.Title" class="form-control" />
                        <span asp-validation-for="Input.Title" class="text-danger"></span>
                    </div>

                    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                        <a asp-page="./Index" class="btn btn-light me-md-2">Hủy bỏ</a>
                        <button type="submit" class="btn btn-primary px-4">Lưu thay đổi</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
