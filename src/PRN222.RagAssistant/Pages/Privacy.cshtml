@page
@model PrivacyModel
@{
    ViewData["Title"] = "Quyền riêng tư & bảo mật";
}

<div class="container simple-content-page">
    <div class="academic-breadcrumb mb-4">
        <a asp-page="/Index"><i class="bi bi-house-door" aria-hidden="true"></i> Trang chủ</a>
        <span class="academic-breadcrumb-separator">/</span>
        <span>Quyền riêng tư &amp; bảo mật</span>
    </div>

    <header>
        <p class="simple-content-kicker">PRN222 RAG Assistant</p>
        <h1>Quyền riêng tư &amp; bảo mật</h1>
        <p>Những nguyên tắc đang được áp dụng khi hệ thống xử lý tài khoản, tài liệu môn học và dịch vụ AI.</p>
    </header>

    <div class="simple-content-sections">
        <section>
            <span>01</span>
            <div>
                <h2>Dữ liệu tài khoản</h2>
                <p>Tài khoản được quản lý bằng ASP.NET Core Identity. Quyền truy cập dựa trên vai trò Admin, Trưởng môn, Sinh viên và phạm vi môn học được phân công.</p>
            </div>
        </section>
        <section>
            <span>02</span>
            <div>
                <h2>Tài liệu môn học</h2>
                <p>Tệp nguồn được lưu trong vùng lưu trữ của ứng dụng. Metadata, nội dung đã xử lý và embeddings được lưu trong PostgreSQL theo chủ thể môn học.</p>
            </div>
        </section>
        <section>
            <span>03</span>
            <div>
                <h2>Xử lý AI theo cấu hình</h2>
                <p>Hệ thống có thể dùng Ollama cục bộ hoặc nhà cung cấp AI trực tuyến do người vận hành chọn. Khi dùng Gemini, OpenAI hoặc OpenRouter, phần văn bản gửi để tạo embedding hoặc trả lời sẽ rời runtime ứng dụng và được xử lý bởi nhà cung cấp tương ứng; API key chỉ được cấu hình phía server. Các endpoint/model miễn phí có thể có chính sách lưu log hoặc sử dụng dữ liệu riêng, vì vậy người vận hành phải kiểm tra điều khoản hiện hành trước khi gửi dữ liệu nhạy cảm.</p>
            </div>
        </section>
    </div>
</div>
